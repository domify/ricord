# The users resource against the database at DATABASE_URL (`sqlite3:` or
# `turso:`), through the worker factory a server uses; no port.
module app_test

import std/file
import db/db/spec::{describe, it}
import ricord/ricord
import web/web/harness::*
import web/web/handler::{Handler}
import web/web/config::{Config}
import app::{database_url, UsersFactory, User, Team}

# Recreates the database file with the app's tables and one user in a team.
def seed : Nil
  url = database_url
  cut = url.starts_with?("turso:") ? 6 : 8
  path = url[cut, url.bytesize - cut]
  [path, "#{path}-wal", "#{path}-shm"].each { |p| File.delete(p) if File.exists?(p) }
  Ricord.open(url) do |db|
    Team.create_table(db).or_panic
    User.create_table(db).or_panic
    core = Team.create(db, title: "Core").or_panic
    User.create(db, name: "Ann", team_id: core.id).or_panic
    nil
  end.or_panic
  nil
end

def get(handler : Handler, path : String, & : Int32, String -> Nil) : Nil
  dispatch(handler, "GET", path) do |ctx|
    yield ctx.response.status_code, ctx.response.body
    nil
  end
  nil
end

def form(handler : Handler, method : String, path : String, body : String, & : Int32, String, String -> Nil) : Nil
  form_request(method, path, body) do |request|
    dispatch(handler, request) do |ctx|
      yield ctx.response.status_code, ctx.response.headers["Location"]? || "", ctx.response.body
      nil
    end
    nil
  end
  nil
end

describe "tape_web users" do
  it "drives every route through one worker session" do
    seed
    UsersFactory.with_handler(0) do |handler, _config|
      # show and index read only.
      get(handler, "/users/1") { |status, body| assert status == 200 && body == "<h1>Ann</h1>" }
      get(handler, "/users/9") { |status, _body| assert status == 404 }
      get(handler, "/users/x") { |status, _body| assert status == 404 }

      # create: 303 to the new user; a blank name answers 422 with the errors.
      form(handler, "POST", "/users", "name=Bob") do |status, location, _body|
        assert status == 303
        assert location == "/users/2"
      end
      form(handler, "POST", "/users", "name=") do |status, _location, body|
        assert status == 422
        assert body == "Name can't be blank"
      end
      get(handler, "/users") { |_status, body| assert body == "<ul><li>Ann (Core)</li><li>Bob</li></ul>" }

      # update from a browser form: POST with _method=patch; a blank name is 422.
      form(handler, "POST", "/users/2", "_method=patch&name=Bea") do |status, location, _body|
        assert status == 303
        assert location == "/users/2"
      end
      get(handler, "/users/2") { |_status, body| assert body == "<h1>Bea</h1>" }
      form(handler, "PATCH", "/users/2", "name=") do |status, _location, body|
        assert status == 422
        assert body == "Name can't be blank"
      end
      get(handler, "/users/2") { |_status, body| assert body == "<h1>Bea</h1>", "the refused update wrote nothing" }

      # destroy from a browser form: POST with _method=delete, then 303 to the list.
      form(handler, "POST", "/users/2", "_method=delete") do |status, location, _body|
        assert status == 303
        assert location == "/users"
      end
      get(handler, "/users/2") { |status, _body| assert status == 404 }
      get(handler, "/users") { |_status, body| assert body == "<ul><li>Ann (Core)</li></ul>" }
      nil
    end
  end
end
