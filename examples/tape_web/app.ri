# A users resource on Ricord, the way a Rails controller answers.
#
#   GET    /users      index: the users with their team, two queries in all
#   GET    /users/:id  show
#   POST   /users      create: 303 to the user, or 422 with the errors
#   PATCH  /users/:id  update: 303 to the user, or 422 with the errors
#   DELETE /users/:id  destroy: 303 to /users
#
# A server worker opens the database named by DATABASE_URL in its factory's
# `with_handler` and keeps the session in its handler; each HTTP request runs
# in `request`, a child session with a fresh store. The response helpers end
# the read transaction (`release`) before they write, so no read is held while
# the client takes the bytes. A browser form sends PATCH and DELETE as POST
# with `_method`; web's OverrideMethodHandler stands in front for it.
module app

import std/env
import ricord/ricord
import sqlite/sqlite/turso
import ricord/ricord/model::{model}
import ricord/ricord/sessions::{Session}
import ricord/ricord/failures::{RecordInvalid}
import web/web/handler::{Handler, chain}
import web/web/context::{Context}
import web/web/config::{Config}
import web/web/override::{OverrideMethodHandler}

model Team do
  table :teams
  col :title, :string
end

model User do
  table :users
  col :name, :string, null: true
  col :team_id, belongs_to: :team, null: true
  validates :name, presence: true
end

# `sqlite3:` or `turso:` URI of the database, from DATABASE_URL.
pub def database_url : String
  ENV["DATABASE_URL"]? || "sqlite3:tape_web.db"
end

# The users resource; the session is the worker's, each request a child of it.
pub class UsersHandler < Handler
  def initialize(@db : Session)
    super()
  end

  # Ends the read transaction, then sends *body* with *status*.
  private def respond(db : Session, env : Context, status : Int32, body : String) : Nil
    db.release
    env.response.status_code = status
    env.response.send(body)
    nil
  end

  # Ends the read transaction, then answers 303 to *location*.
  private def redirect(db : Session, env : Context, location : String) : Nil
    db.release
    env.redirect(location, 303)
    nil
  end

  private def not_found(db : Session, env : Context) : Nil
    respond(db, env, 404, "not found")
  end

  private def show_page(page : String::Builder, user : User) : Nil
    page << "<h1>" << (user.name || "") << "</h1>"
    nil
  end

  private def errors_page(page : String::Builder, user : User) : Nil
    page << user.errors.full_messages.join(", ")
    nil
  end

  pub def call(env : Context) : Nil
    @db.request do |r|
      route(r, env)
      nil
    end
    nil
  end

  private def route(db : Session, env : Context) : Nil
    method = env.request.method
    path = env.request.path
    if path == "/users"
      return index(db, env) if method == "GET"
      return create(db, env) if method == "POST"
    elsif path.starts_with?("/users/")
      id = path[7, path.bytesize - 7].to_i64?
      return not_found(db, env) if id.nil?
      return show(db, env, id) if method == "GET"
      return update(db, env, id) if method == "PATCH" || method == "PUT"
      return destroy(db, env, id) if method == "DELETE"
    end
    not_found(db, env)
  end

  private def index(db : Session, env : Context) : Nil
    page = ""
    page << "<ul>"
    User[db].order(:name).includes(:team).to_a.or_panic.each do |user|
      page << "<li>" << (user.name || "")
      team = user.team.or_panic
      page << " (" << team.title << ")" if team
      page << "</li>"
    end
    page << "</ul>"
    respond(db, env, 200, page)
  end

  private def show(db : Session, env : Context, id : Int64) : Nil
    user = User[db].find_by(id: id).or_panic
    return not_found(db, env) if user.nil?
    page = ""
    show_page(page, user)
    respond(db, env, 200, page)
  end

  private def create(db : Session, env : Context) : Nil
    user = User.new(db, name: env.params.body["name"]? || "")
    saved = user.save
    if saved.is_a?(RecordInvalid)
      page = ""
      errors_page(page, user)
      return respond(db, env, 422, page)
    end
    saved.or_panic
    redirect(db, env, "/users/" + user.to_param)
  end

  private def update(db : Session, env : Context, id : Int64) : Nil
    user = User[db].find_by(id: id).or_panic
    return not_found(db, env) if user.nil?
    updated = user.update(name: env.params.body["name"]? || "")
    if updated.is_a?(RecordInvalid)
      page = ""
      errors_page(page, user)
      return respond(db, env, 422, page)
    end
    updated.or_panic
    redirect(db, env, "/users/" + user.to_param)
  end

  private def destroy(db : Session, env : Context, id : Int64) : Nil
    user = User[db].find_by(id: id).or_panic
    return not_found(db, env) if user.nil?
    user.destroy.or_panic
    redirect(db, env, "/users")
  end
end

# The server's factory (web/web/server.ri, `Factory.with_handler`): each worker
# opens its own session on DATABASE_URL and keeps it for its life.
pub class UsersFactory
  def self.with_handler(data : Int32, & : Handler, Config -> Nil) : Nil
    Ricord.open(database_url) do |db|
      handler = chain([OverrideMethodHandler.new, UsersHandler.new(db)] of Handler)
      options = Config.new
      yield handler, options
      nil
    end.or_panic
    nil
  end
end
