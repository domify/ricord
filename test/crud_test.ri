# M1: create, find, where, order, limit, offset, first, count, exists?, save, destroy.
module test/crud_test

import db/db/spec::{describe, it}
import std/time::{Time}
import ricord
import ricord/model::{model}
import ricord/failures::{RecordNotFound, DatabaseError}
import test/spec_helper::*
import test/models::*

describe "crud" do
  it "creates and finds" do
    with_db do |db|
      court = Court.create(db, name: "Tallinn", rank: 1).or_panic
      assert court.id == 1_i64
      assert court.persisted?
      found = Court[db].find(court.id).or_panic
      assert found.name == "Tallinn"
      assert found.rank == 1_i64
      assert found.active
      missing = Court[db].find(99)
      assert missing.is_a?(RecordNotFound)
      assert Court[db].find_by(name: "Nowhere").or_panic.nil?
    end
  end

  it "filters with every where form" do
    with_db do |db|
      ["a", "b", "c", "d"].each_with_index { |n, i| Court.create(db, name: n, rank: i + 1).or_panic }
      Court.create(db, name: "e").or_panic
      assert Court[db].where(name: "b").count.or_panic == 1_i64
      assert Court[db].where(rank: nil).count.or_panic == 1_i64
      assert Court[db].where(rank: [1_i64, 3_i64]).count.or_panic == 2_i64
      assert Court[db].where(rank: 2_i64..3_i64).count.or_panic == 2_i64
      assert Court[db].where(rank: 2_i64...3_i64).count.or_panic == 1_i64
      assert Court[db].where(rank: [] of Int64).count.or_panic == 0_i64
      assert Court[db].where("rank > ?", 2).count.or_panic == 2_i64
      assert Court[db].where(name: "a").or_where(name: "d").count.or_panic == 2_i64
      base = Court[db].where(rank: 1_i64..4_i64)
      narrower = base.where(name: "a")
      assert base.count.or_panic == 4_i64, "an earlier query keeps its own conditions"
      assert narrower.count.or_panic == 1_i64
      assert db.statements.any?(&.includes?("`rank` IN (?, ?)"))
    end
  end

  it "orders, limits and offsets" do
    with_db do |db|
      ["b", "a", "c"].each { |n| Court.create(db, name: n).or_panic }
      names = Court[db].order(:name).to_a.or_panic.map(&.name)
      assert names == ["a", "b", "c"]
      last = Court[db].order(name: :desc).first.or_panic
      assert !last.nil? && last.name == "c"
      assert Court[db].order(:name).limit(2).to_a.or_panic.size == 2
      assert Court[db].order(:name).offset(1).to_a.or_panic.map(&.name) == ["b", "c"]
      first = Court[db].first.or_panic
      assert !first.nil? && first.name == "b"
      assert Court[db].exists?.or_panic
      assert !Court[db].where(name: "z").exists?.or_panic
    end
  end

  it "saves changes and destroys" do
    with_db do |db|
      court = Court.create(db, name: "Old").or_panic
      court.name = "New"
      assert court.changed?
      court.save.or_panic
      assert !court.changed?
      assert db.statements.any?(&.starts_with?("UPDATE `courts` SET `name` = ?"))
      assert Court[db].find(court.id).or_panic.name == "New"
      court.destroy.or_panic
      assert court.destroyed?
      assert Court[db].count.or_panic == 0_i64
    end
  end

  it "marks a destroyed record and removes its row" do
    with_db do |db|
      court = Court.create(db, name: "delete me").or_panic
      kept = Court.create(db, name: "keep me").or_panic
      assert court.destroy.or_panic.destroyed?
      assert !court.persisted?
      assert Court[db].find(court.id).is_a?(RecordNotFound)
      assert db.statements.any?(&.starts_with?("DELETE FROM `courts` WHERE `id` = ?"))
      assert Court[db].find(kept.id).or_panic.name == "keep me", "only its own row goes"
    end
  end

  it "destroys a record found by id, and reports a missing id" do
    with_db do |db|
      court = Court.create(db, name: "a").or_panic
      Court[db].find(court.id).or_panic.destroy.or_panic
      assert Court[db].count.or_panic == 0_i64
      missing = Court[db].find(999_999)
      assert missing.is_a?(RecordNotFound)
      assert missing.as(RecordNotFound).id == 999_999_i64
    end
  end
end

# Ported from grant_convenience_relation_finders and grant_persistence_destroyed_guard.
describe "finders and destroyed records" do
  it "finds within a query and leaves the query unchanged" do
    with_db do |db|
      Court.create(db, name: "a", rank: 1).or_panic
      Court.create(db, name: "b", rank: 1).or_panic
      c = Court.create(db, name: "c", rank: 2).or_panic
      ranked = Court[db].where(rank: 1)
      found = ranked.find_by(name: "b").or_panic
      assert !found.nil? && found.name == "b"
      assert ranked.find_by(name: "c").or_panic.nil?, "find_by narrows the query"
      assert !ranked.find_by(score: nil).or_panic.nil?, "nil matches IS NULL"
      assert ranked.find(c.id).is_a?(RecordNotFound), "find keeps the query's conditions"
      assert ranked.count.or_panic == 2_i64, "the query keeps only its own conditions"
      top = Court[db].find_by(name: "a").or_panic
      assert !top.nil? && top.rank == 1_i64
    end
  end

  it "keeps a destroyed record's values and writes no row back" do
    with_db do |db|
      item = Court.create(db, name: "gone", rank: 1).or_panic
      item.destroy.or_panic
      item.rank = 2
      assert item.name == "gone"
      assert item.rank == 2_i64
      item.save
      assert Court[db].count.or_panic == 0_i64
      assert Court[db].find(item.id).is_a?(RecordNotFound)
      live = Court.create(db, name: "alive").or_panic
      live.name = "still alive"
      live.save.or_panic
      assert Court[db].find(live.id).or_panic.name == "still alive"
    end
  end
end

# Ported from grant_query_builder, grant_query_implicit_order,
# grant_query_existence_predicates and grant_query_query_regressions.
describe "query building" do
  it "chains where, or_where, raw conditions, order, limit and offset" do
    with_db do |db|
      Court.create(db, name: "a", rank: 23).or_panic
      Court.create(db, name: "b", rank: 5).or_panic
      Court.create(db, name: "c", rank: 23, active: false).or_panic
      Court.create(db, name: "d").or_panic
      assert Court[db].where(rank: 23).where(active: true).count.or_panic == 1_i64
      assert Court[db].where(rank: 23).or_where(name: "b").count.or_panic == 3_i64
      assert Court[db].where(rank: nil, name: ["d", "a"]).count.or_panic == 1_i64
      assert db.statements.any?(&.includes?("`name` IN (?, ?) AND `rank` IS NULL"))
      assert Court[db].where("name = ?", "a").where("rank = ?", 23).count.or_panic == 1_i64
      ordered = Court[db].order(rank: :desc).order(name: :asc).to_a.or_panic.map(&.name)
      assert ordered == ["a", "c", "b", "d"]
      assert db.statements.any?(&.includes?("ORDER BY `rank` DESC, `name`"))
      assert Court[db].order(:name).limit(2).offset(1).to_a.or_panic.map(&.name) == ["b", "c"]
      assert db.statements.any?(&.includes?(" LIMIT 2 OFFSET 1"))
    end
  end

  it "reads unordered unless asked, and orders first by id" do
    with_db do |db|
      ["c", "a", "b"].each { |n| Court.create(db, name: n).or_panic }
      before = db.statements.size
      assert Court[db].where("name != ?", "zzz").to_a.or_panic.size == 3
      assert db.statements.size > before && !db.statements.last.includes?("ORDER BY"), "a plain read has no ORDER BY"
      first = Court[db].first.or_panic
      assert !first.nil? && first.name == "c"
      assert db.statements.last.includes?("ORDER BY `id` LIMIT 1"), "first orders by id ascending"
      raw_first = Court[db].where("name != ?", "zzz").first.or_panic
      assert !raw_first.nil? && raw_first.name == "c"
      by_name = Court[db].order(:name).first.or_panic
      assert !by_name.nil? && by_name.name == "a", "an explicit order is kept"
      by_name_desc = Court[db].order(name: :desc).first.or_panic
      assert !by_name_desc.nil? && by_name_desc.name == "c"
      assert db.statements.last.includes?("ORDER BY `name` DESC LIMIT 1"), "an explicit order is used as written"
    end
  end

  it "answers exists? with LIMIT 1 and honors a limit" do
    with_db do |db|
      ["a", "b", "c"].each { |n| Court.create(db, name: n).or_panic }
      assert !Court[db].where(name: "nope").exists?.or_panic
      assert Court[db].where(name: "a").exists?.or_panic
      assert Court[db].where("name != ?", "zzz").exists?.or_panic
      assert db.statements.last.includes?("LIMIT 1")
      assert !db.statements.last.includes?("ORDER BY")
      assert Court[db].where("name != ?", "zzz").limit(1).exists?.or_panic
    end
  end

  it "uses exclusive range ends and groups an OR range with AND" do
    with_db do |db|
      ["in1", "in2", "in3", "in4", "outside"].each_with_index { |n, i| Court.create(db, name: n, rank: i + 1).or_panic }
      assert Court[db].where(rank: 1_i64...3_i64).order(:rank).to_a.or_panic.map(&.name) == ["in1", "in2"]
      found = Court[db].where(name: "outside").or_where(rank: 2_i64...4_i64).order(:rank).to_a.or_panic.map(&.name)
      assert found == ["in2", "in3", "outside"]
      assert db.statements.any?(&.includes?(" OR (`rank` >= ? AND `rank` < ?)"))
    end
  end
end

# Ported from grant_public_api_return_types: the query API's static types.
describe "public api return types" do
  it "keeps the record, query and finder return types" do
    with_db do |db|
      assert typeof(Court[db]).to_s == Court::Query.to_s
      assert typeof(Court[db].where(name: "a")).to_s == Court::Query.to_s
      assert typeof(Court[db].where("name = ?", "a")).to_s == Court::Query.to_s
      assert typeof(Court[db].order(:name).limit(1).offset(1)).to_s == Court::Query.to_s
      assert typeof(Court[db].to_a).to_s == (Array(Court) | ::Ricord::Failures::DatabaseError).to_s
      assert typeof(Court[db].first).to_s == (Court | Nil | ::Ricord::Failures::DatabaseError).to_s
      assert typeof(Court[db].find_by(name: "a")).to_s == (Court | Nil | ::Ricord::Failures::DatabaseError).to_s
      assert typeof(Court[db].find(1)).to_s == (Court | ::Ricord::Failures::RecordNotFound | ::Ricord::Failures::DatabaseError).to_s
      assert typeof(Court[db].count).to_s == (Int64 | ::Ricord::Failures::DatabaseError).to_s
      assert typeof(Court[db].exists?).to_s == (Bool | ::Ricord::Failures::DatabaseError).to_s
      assert typeof(Court.new(db, name: "a")).to_s == Court.to_s
      assert typeof(Court.create(db, name: "a")).to_s == (Court | ::Ricord::Failures::Error).to_s
      assert typeof(Court.new(db, name: "b").reload).to_s == (Court | ::Ricord::Failures::Error).to_s
    end
  end

  it "refuses save and destroy of a destroyed record" do
    with_db do |db|
      court = Court.create(db, name: "x").or_panic
      court.destroy.or_panic
      court.name = "y"
      assert court.save.is_a?(DatabaseError)
      assert court.destroy.is_a?(DatabaseError)
      assert Court[db].count.or_panic == 0_i64
    end
  end

  it "answers exists? with an offset" do
    with_db do |db|
      3.times { |i| Court.create(db, name: "c#{i}").or_panic }
      assert Court[db].offset(2).exists?.or_panic
      assert !Court[db].offset(3).exists?.or_panic
    end
  end
end

# A column whose name is an SQL keyword, for grant_querying_find_by.
model Keyword do
  table :keywords
  col :all, :string
end

# Ported from grant_query_relation_load, grant_querying_count,
# grant_querying_enumerable_baseline and grant_querying_passthrough.
describe "counting and probing" do
  it "counts only the rows a limit or offset returns" do
    with_db do |db|
      ["a", "b", "c", "d", "e"].each { |n| Court.create(db, name: n).or_panic }
      query = Court[db].where("name != ?", "zzz")
      assert query.limit(2).count.or_panic == 2_i64
      assert query.limit(2).offset(1).count.or_panic == 2_i64
      assert query.limit(10).offset(3).count.or_panic == 2_i64
      assert query.offset(4).count.or_panic == 1_i64
      assert query.offset(9).count.or_panic == 0_i64
      assert query.order(:name).limit(3).count.or_panic == 3_i64
      assert query.count.or_panic == 5_i64
      assert db.statements.last.upcase.includes?("COUNT(*)")
    end
  end

  it "answers any? and empty? with a LIMIT 1 probe" do
    with_db do |db|
      ["a", "b", "c"].each { |n| Court.create(db, name: n).or_panic }
      query = Court[db].where("name != ?", "zzz")
      before = db.statements.size
      assert !query.empty?.or_panic
      selects = 0
      (before...db.statements.size).each { |i| selects += 1 if db.statements[i].starts_with?("SELECT") }
      assert selects == 1, "one probe query"
      assert db.statements.last.includes?("LIMIT 1")
      assert query.any?.or_panic
      assert !Court[db].where(name: "nonexistent").any?.or_panic
      assert Court[db].where(name: "nonexistent").empty?.or_panic
    end
  end

  it "reads first and last in the query's order" do
    with_db do |db|
      ["b", "a", "c"].each { |n| Court.create(db, name: n).or_panic }
      by_id = Court[db].last.or_panic
      assert !by_id.nil? && by_id.name == "c"
      assert db.statements.last.includes?("ORDER BY `id` DESC LIMIT 1")
      by_name = Court[db].order(:name).last.or_panic
      assert !by_name.nil? && by_name.name == "c"
      by_name_desc = Court[db].order(name: :desc).last.or_panic
      assert !by_name_desc.nil? && by_name_desc.name == "a"
      assert db.statements.last.includes?("ORDER BY `name` LIMIT 1")
      limited = Court[db].order(:name).limit(2).last.or_panic
      assert !limited.nil? && limited.name == "b", "last of a limited query is its last row"
      assert Court[db].where(name: "z").last.or_panic.nil?
    end
  end

  it "returns counts as Int64, 0 for none and past Int32::MAX" do
    with_db do |db|
      assert Court[db].count.or_panic == 0_i64
      Court.create(db, name: "count probe").or_panic
      assert Court[db].count.or_panic.is_a?(Int64)
      assert Court[db].where(name: "count probe").count.or_panic.is_a?(Int64)
      before = Court[db].count.or_panic
      2.times { |i| Court.create(db, name: "model_#{i}").or_panic }
      assert Court[db].count.or_panic - before == 2_i64
      assert db.scalar("SELECT 2147483648", Int64).or_panic == 2_147_483_648_i64
    end
  end

  it "passes raw query and scalar through to the driver" do
    with_db do |db|
      name = db.query("SELECT `name` FROM `courts`") { |rs| rs.column_name(0) }.or_panic
      assert name == "name"
      assert db.scalar("SELECT count(*) FROM `courts`", Int64).or_panic == 0_i64
    end
  end

  it "works with Array methods after to_a" do
    with_db do |db|
      ["alice", "bob", "carol", "dave", "eve"].each { |n| Court.create(db, name: n).or_panic }
      query = Court[db].where(name: ["alice", "bob", "carol"])
      assert query.to_a.or_panic.size == 3
      assert query.count.or_panic == 3_i64
      picked = query.to_a.or_panic.select { |c| c.name == "alice" || c.name == "bob" }
      assert picked.size == 2
      assert query.to_a.or_panic.count { |c| c.name == "alice" } == 1
      assert query.to_a.or_panic.any? { |c| c.name == "carol" }
      assert query.to_a.or_panic.min_by(&.name).name == "alice"
      assert query.to_a.or_panic.max_by(&.name).name == "carol"
      assert Court[db].where(name: ["carol", "alice", "bob"]).to_a.or_panic.map(&.name).sorted == ["alice", "bob", "carol"]
      assert query.to_a.or_panic.reject { |c| c.name == "carol" }.size == 2
      first = Court[db].where(name: "alice").first.or_panic
      assert !first.nil? && first.name == "alice"
      chained = Court[db].where(name: ["alice", "bob", "carol"]).order(name: :asc).limit(2).to_a.or_panic
      assert chained.size == 2 && chained[0].name == "alice"
    end
  end
end

private def labels(q : Court::Query) : Array(String)
  q.order(:rank).to_a.or_panic.map(&.name)
end

private def ids_desc(q : Court::Query) : Array(Int64)
  q.order(id: :desc).to_a.or_panic.map(&.id)
end

# Ported from grant_query_where_range, grant_querying_query_builder,
# grant_querying_or_not_block_params, grant_querying_exists and grant_querying_all.
describe "where forms" do
  it "filters on closed, exclusive and open ranges of every type" do
    with_db do |db|
      (1..5).each do |r|
        Court.create(db, name: "m#{r}", rank: r, score: r * 1.5, opened_at: Time.utc(2024, r, 1)).or_panic
      end
      assert labels(Court[db].where(rank: 2_i64..4_i64)) == ["m2", "m3", "m4"]
      assert labels(Court[db].where(rank: 2_i64...4_i64)) == ["m2", "m3"]
      assert labels(Court[db].where(rank: ..3_i64)) == ["m1", "m2", "m3"]
      assert db.statements.last.includes?("`rank` <= ?")
      assert labels(Court[db].where(rank: ...3_i64)) == ["m1", "m2"]
      assert db.statements.last.includes?("`rank` < ?")
      assert labels(Court[db].where(rank: 4_i64..)) == ["m4", "m5"]
      assert labels(Court[db].where(rank: 4_i64...)) == ["m4", "m5"]
      assert !db.statements.last.includes?("<")
      assert Court[db].where(rank: (nil..nil)).count.or_panic == 5_i64
      assert labels(Court[db].where(score: 3.0..6.0)) == ["m2", "m3", "m4"]
      assert labels(Court[db].where(score: ..3.0)) == ["m1", "m2"]
      assert labels(Court[db].where(score: 6.0..)) == ["m4", "m5"]
      assert labels(Court[db].where(rank: 2_i64..).where(score: ..6.0)) == ["m2", "m3", "m4"]
      assert labels(Court[db].where(rank: 1_i64..).where(rank: ..2_i64)) == ["m1", "m2"]
      assert labels(Court[db].where(name: "m1").or_where(rank: 5_i64..)) == ["m1", "m5"]
      assert labels(Court[db].where(name: "m1").or_where(rank: ..2_i64)) == ["m1", "m2"]
      assert labels(Court[db].where(name: "m1").or_where(rank: 4_i64...5_i64)) == ["m1", "m4"]
      assert labels(Court[db].where(name: "m3").or_where(rank: 4_i64..5_i64).where(score: ..100.0)) == ["m3", "m4", "m5"]
    end
  end

  it "queries IN lists of ids, strings, numbers and booleans" do
    with_db do |db|
      one = Court.create(db, name: "one", rank: 99).or_panic
      two = Court.create(db, name: "two", rank: -4, active: false).or_panic
      assert ids_desc(Court[db].where(id: [one.id, two.id])) == [two.id, one.id]
      assert ids_desc(Court[db].where(name: ["one", "two"]).where(id: [one.id, two.id])) == [two.id, one.id]
      assert ids_desc(Court[db].where(id: [1001_i64, 1002_i64]).or_where(name: ["one", "two"])) == [two.id, one.id]
      assert ids_desc(Court[db].where(name: ["one", "two"]).or_where(id: [1001_i64, 1002_i64])) == [two.id, one.id]
      assert ids_desc(Court[db].where(id: [1001_i64, 1002_i64])).empty?
      assert ids_desc(Court[db].where(rank: [99_i64, -4_i64])) == [two.id, one.id]
      assert ids_desc(Court[db].where(active: [false])) == [two.id]
      assert Court[db].where(id: one.id).exists?.or_panic
      assert Court[db].where(name: "one", id: one.id).exists?.or_panic
      assert !Court[db].where(id: 234567).exists?.or_panic
      assert !Court[db].where(name: "other", id: one.id).exists?.or_panic
      assert !Court[db].where(rank: nil, id: one.id).exists?.or_panic
      blank = Court.create(db, name: "blank").or_panic
      assert Court[db].where(rank: nil, id: blank.id).exists?.or_panic
    end
  end

  it "groups an or_where with several keys as one AND clause" do
    with_db do |db|
      Court.create(db, name: "alice", rank: 30).or_panic
      Court.create(db, name: "alice2", rank: 99).or_panic
      Court.create(db, name: "carol", rank: 30).or_panic
      Court.create(db, name: "dave", rank: 4).or_panic
      found = Court[db].where(name: "carol").or_where(name: "alice", rank: 30).to_a.or_panic.map(&.name).sorted
      assert found == ["alice", "carol"]
      assert db.statements.any?(&.includes?(") OR (`name` = ? AND `rank` = ?)"))
      three = Court[db].where(name: "dave").or_where(name: "alice", rank: 30).or_where(name: "carol", rank: 30).count.or_panic
      assert three == 3_i64
      one = Court[db].where(name: "dave").or_where(name: "alice2", rank: 30).count.or_panic
      assert one == 1_i64, "both keys must match inside the group"
    end
  end

  it "lists all records and filters with a raw condition" do
    with_db do |db|
      made = (0...100).map { |i| Court.create(db, name: "model_#{i}").or_panic.id }
      all = Court[db].all.or_panic
      assert all.size == 100
      assert all.map(&.id).sorted == made
      Court.create(db, name: "findable model").or_panic
      found = Court[db].where("name = ?", "findable model").all.or_panic
      assert found.size == 1 && found[0].name == "findable model"
    end
  end
end

# Ported from grant_querying_find, grant_querying_find_by, grant_querying_first
# and grant_querying_reload.
describe "finders and reload" do
  it "finds by id and marks the record persisted" do
    with_db do |db|
      court = Court.create(db, name: "Test Comment").or_panic
      found = Court[db].find(court.id).or_panic
      assert found.id == court.id
      assert !found.new_record?
      assert found.persisted?
      missing = Court[db].find(0)
      assert missing.is_a?(RecordNotFound)
      assert missing.as(RecordNotFound).message.includes?("no row with id 0")
    end
  end

  it "finds by strings, several keys, nil and keyword columns" do
    with_db do |db|
      Keyword.create_table(db).or_panic
      robinson = Court.create(db, name: "robinson").or_panic
      found = Court[db].find_by(name: "robinson").or_panic
      assert !found.nil? && found.id == robinson.id
      Court.create(db, name: "review1", rank: 2).or_panic
      expected = Court.create(db, name: "review3", rank: 10).or_panic
      by_two = Court[db].find_by(name: "review3", rank: 10).or_panic
      assert !by_two.nil? && by_two.id == expected.id
      assert Court[db].find_by(name: "review1", rank: 20).or_panic.nil?
      by_nil = Court[db].find_by(rank: nil).or_panic
      assert !by_nil.nil? && by_nil.id == robinson.id
      word = Keyword.create(db, all: "robinson").or_panic
      by_word = Keyword[db].find_by(all: "robinson").or_panic
      assert !by_word.nil? && by_word.id == word.id
      assert db.statements.any?(&.includes?("WHERE (`all` = ?)"))
      assert Court[db].find_by(name: "xxx").or_panic.nil?
    end
  end

  it "reads first by id, in a given order, or nil" do
    with_db do |db|
      first = Court.create(db, name: "Test 1").or_panic
      second = Court.create(db, name: "Test 2").or_panic
      found = Court[db].first.or_panic
      assert !found.nil? && found.id == first.id
      desc = Court[db].order(id: :desc).first.or_panic
      assert !desc.nil? && desc.id == second.id
      assert Court[db].where("name = 'Test 3'").first.or_panic.nil?
    end
  end

  it "reloads in place, drops unsaved changes and reports a missing row" do
    with_db do |db|
      court = Court.create(db, name: "Original").or_panic
      court.name = "Unsaved change"
      assert court.changed?
      other = Court[db].find(court.id).or_panic
      other.name = "Changed elsewhere"
      other.save.or_panic
      reloaded = court.reload.or_panic
      assert reloaded.index == court.index
      assert court.name == "Changed elsewhere"
      assert !court.changed?
      court.destroy.or_panic
      assert court.reload.is_a?(RecordNotFound)
    end
  end
end

# Ported from spike_crud and the CRUD, query and transaction parts of
# grant_tape_model (associations, validations, callbacks, dirty tracking,
# to_json, pluck and includes are M2-M4).
describe "one request's records" do
  it "creates, updates, finds, filters and destroys" do
    with_db do |db|
      record = Court.create(db, name: "before").or_panic
      assert record.persisted?
      record.name = "after"
      record.save.or_panic
      assert Court[db].find(record.id).or_panic.name == "after"
      assert Court[db].where(name: "after").to_a.or_panic.size == 1
      record.destroy.or_panic
      assert record.destroyed?
      assert Court[db].find(record.id).is_a?(RecordNotFound)
    end
  end

  it "reads typed columns, filters, orders and rolls back on one session" do
    with_db do |db|
      at = Time.utc(2026, 1, 2, 3, 4, 5)
      ann = Court.create(db, name: "Ann", rank: 3, score: 4.5, active: true, opened_at: at).or_panic
      Court.create(db, name: "Bob", rank: 9, active: false).or_panic
      Court.create(db, name: "Cy", rank: 9).or_panic
      court = Court[db].find(ann.id).or_panic
      assert court.rank == 3_i64 && court.score == 4.5 && court.active && court.opened_at == at
      assert !court.changed?
      assert court.to_param == ann.id.to_s
      same = court
      same.name = "Bea"
      assert court.name == "Bea", "a copy is the same record"
      court.save.or_panic
      assert Court[db].find(ann.id).or_panic.name == "Bea"
      assert Court[db].where(rank: 9).order(:name).to_a.or_panic.map(&.name) == ["Bob", "Cy"]
      assert Court[db].where(name: ["Bob", "Cy"]).count.or_panic == 2_i64
      assert Court[db].where(name: [] of String).count.or_panic == 0_i64
      assert Court[db].where(rank: 3_i64..9_i64).count.or_panic == 3_i64
      assert Court[db].where(rank: 4_i64...9_i64).count.or_panic == 0_i64
      assert Court[db].where(score: nil).count.or_panic == 2_i64
      assert Court[db].where("rank > ?", 8).count.or_panic == 2_i64
      assert Court[db].where(name: "Bob").or_where(name: "Cy").count.or_panic == 2_i64
      top = Court[db].order(name: :desc).limit(1).first.or_panic
      assert !top.nil? && top.name == "Cy"
      assert Court[db].where(rank: 1).first.or_panic.nil?
      bob = Court[db].find_by(name: "Bob").or_panic
      assert !bob.nil? && !bob.active
      assert Court[db].where(name: "Bob").exists?.or_panic
      nines = Court[db].where(rank: 9)
      assert nines.where(name: "Bob").count.or_panic == 1_i64
      assert nines.count.or_panic == 2_i64, "a chained query leaves the first unchanged"
      before = Court[db].count.or_panic
      db.write { |tx| Court.create(tx, name: "Gone").or_panic; tx.roll_back }
      assert Court[db].count.or_panic == before
    end
  end
end

# Ported from grant_simple_connection (the registry and roles are replaced by
# Ricord.open and the URI) and grant_spec_support_transactional_wrapper (with_db
# gives each test a fresh file; a write that rolls back is the wrapper).
describe "connections and test isolation" do
  it "opens a second connection on the same URI that sees committed rows" do
    with_db do |db|
      Court.create(db, name: "shared").or_panic
      db.release
      seen = Ricord.open(database_url) { |other| Court[other].where(name: "shared").count.or_panic }
      assert seen.or_panic == 1_i64
    end
  end

  it "rolls back rows made inside a rolled-back write, nested ones too" do
    with_db do |db|
      db.write do |tx|
        Court.create(tx, name: "gone").or_panic
        assert Court[tx].count.or_panic == 1_i64
        tx.roll_back
      end
      assert Court[db].count.or_panic == 0_i64
      db.write do |tx|
        Court.create(tx, name: "outer").or_panic
        tx.write { |inner| Court.create(inner, name: "inner").or_panic; inner.roll_back }
        assert Court[tx].order(:name).to_a.or_panic.map(&.name) == ["outer"]
        tx.roll_back
      end
      assert Court[db].count.or_panic == 0_i64
    end
  end
end

# The parts of grant_query_existence_predicates and grant_query_implicit_order
# that empty?, any? and last now cover.
describe "emptiness and last" do
  it "answers empty? and any? for no, one and many rows" do
    with_db do |db|
      query = Court[db].where(rank: 1)
      assert query.empty?.or_panic && !query.any?.or_panic
      Court.create(db, name: "a", rank: 1).or_panic
      assert !query.empty?.or_panic && query.any?.or_panic
      Court.create(db, name: "b", rank: 1).or_panic
      assert !query.empty?.or_panic && query.any?.or_panic
      assert !db.statements.last.includes?("ORDER BY")
    end
  end

  it "orders last by id descending, filtered or not, and keeps an explicit order" do
    with_db do |db|
      ids = ["b", "c", "a"].map { |n| Court.create(db, name: n).or_panic.id }
      last = Court[db].last.or_panic
      assert !last.nil? && last.id == ids[2]
      filtered = Court[db].where("name != ?", "zzz").last.or_panic
      assert !filtered.nil? && filtered.id == ids[2]
      assert db.statements.last.includes?("ORDER BY `id` DESC LIMIT 1")
      by_name = Court[db].order(:name).last.or_panic
      assert !by_name.nil? && by_name.name == "c"
    end
  end
end
