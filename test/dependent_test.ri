# M3: has_many/has_one dependent: :destroy (children loaded and destroyed with
# their callbacks, before the parent), :delete_all (one DELETE, no callbacks),
# :nullify (one UPDATE), :restrict (CallbackError while a child exists), all in
# the parent's destroy write; a refusing child callback rolls the whole destroy
# back. Also Grant's dependent_delete_all test.
module test/dependent_test

import db/db/spec::{describe, it}
import ricord
import ricord/model::{model}
import ricord/sessions::{Session}
import ricord/failures::{CallbackError}
import test/spec_helper::*

model Trail do
  table :trails
  col :note, :string
end

model Home do
  table :homes
  col :name, :string
  has_many :rooms, dependent: :destroy
  has_many :notes, dependent: :delete_all
  has_many :tags, dependent: :nullify
  has_one :deed, dependent: :delete_all
end

# Refuses to go when named "keep" or when its home is already gone; leaves a
# trail row when destroyed.
model Room do
  table :rooms
  col :home_id, :int64, null: true
  col :name, :string
  before_destroy :check
  after_destroy :leave_trail

  def check : Nil | ::Ricord::Failures::Error
    return ::Ricord::Failures::DatabaseError.new(TABLE, "test", "kept") if name == "keep"
    home = Home[session].where(id: home_id).exists?
    return home if home.is_a?(::Ricord::Failures::DatabaseError)
    home ? nil : ::Ricord::Failures::DatabaseError.new(TABLE, "test", "home already deleted")
  end

  def leave_trail : Nil | ::Ricord::Failures::Error
    made = Trail.create(session, note: "room #{name}")
    made.is_a?(::Ricord::Failures::Failure) ? made : nil
  end
end

# A callback that always refuses: delete_all must not run it.
model Note do
  table :notes
  col :home_id, :int64, null: true
  col :body, :string
  before_destroy :refuse

  def refuse : Nil | ::Ricord::Failures::Error
    ::Ricord::Failures::DatabaseError.new(TABLE, "test", "callbacks ran")
  end
end

model Tag do
  table :tags
  col :home_id, :int64, null: true
  col :label, :string
end

model Deed do
  table :deeds
  col :home_id, :int64, null: true
  col :label, :string
end

model Vault do
  table :vaults
  col :name, :string
  has_many :locks, dependent: :restrict
end

model Lock do
  table :locks
  col :vault_id, :int64, null: true
end

def with_homes(& : Session -> Nil) : Nil
  with_db do |db|
    Trail.create_table(db).or_panic
    Home.create_table(db).or_panic
    Room.create_table(db).or_panic
    Note.create_table(db).or_panic
    Tag.create_table(db).or_panic
    Deed.create_table(db).or_panic
    Vault.create_table(db).or_panic
    Lock.create_table(db).or_panic
    db.release
    yield db
  end
end

def index_of(db : Session, start : Int32, prefix : String) : Int32
  db.statements.each_with_index { |s, i| return i if i >= start && s.starts_with?(prefix) }
  -1
end

def count_of(db : Session, start : Int32, prefix : String) : Int32
  n = 0
  db.statements.each_with_index { |s, i| n += 1 if i >= start && s.starts_with?(prefix) }
  n
end

describe "dependent:" do
  it "destroys has_many children with their callbacks, before the parent" do
    with_homes do |db|
      home = Home.create(db, name: "h").or_panic
      other = Home.create(db, name: "o").or_panic
      Room.create(db, home_id: home.id, name: "a").or_panic
      Room.create(db, home_id: home.id, name: "b").or_panic
      Room.create(db, home_id: other.id, name: "c").or_panic
      start = db.statements.size
      home.destroy.or_panic
      assert home.destroyed?
      assert Room[db].where(home_id: home.id).count.or_panic == 0_i64
      assert Room[db].where(home_id: other.id).count.or_panic == 1_i64
      # Each child's after_destroy ran, in id order.
      trails = Trail[db].order(:id).to_a.or_panic
      assert trails.size == 2
      assert trails[0].note == "room a"
      assert trails[1].note == "room b"
      # One write; the children's DELETEs come before the parent's.
      assert count_of(db, start, "BEGIN IMMEDIATE") == 1
      rooms_at = index_of(db, start, "DELETE FROM `rooms`")
      home_at = index_of(db, start, "DELETE FROM `homes`")
      assert rooms_at >= 0
      assert home_at > rooms_at
      assert count_of(db, start, "DELETE FROM `rooms`") == 2
    end
  end

  it "deletes has_many children with one DELETE and no callbacks" do
    with_homes do |db|
      home = Home.create(db, name: "h").or_panic
      other = Home.create(db, name: "o").or_panic
      3.times { |i| Note.create(db, home_id: home.id, body: "n#{i}").or_panic }
      Note.create(db, home_id: other.id, body: "other").or_panic
      assert Note[db].where(home_id: home.id).count.or_panic == 3_i64
      start = db.statements.size
      home.destroy.or_panic
      assert Note[db].where(home_id: home.id).count.or_panic == 0_i64
      assert Note[db].where(home_id: other.id).count.or_panic == 1_i64
      assert count_of(db, start, "DELETE FROM `notes` WHERE `home_id` = ?") == 1
      # The notes are never read into records.
      assert count_of(db, start, "SELECT `id`, `home_id`, `body` FROM `notes`") == 0
      assert index_of(db, start, "DELETE FROM `homes`") > index_of(db, start, "DELETE FROM `notes`")
    end
  end

  it "deletes the has_one child with one DELETE" do
    with_homes do |db|
      home = Home.create(db, name: "h").or_panic
      Deed.create(db, home_id: home.id, label: "only").or_panic
      assert Deed[db].where(home_id: home.id).count.or_panic == 1_i64
      home.destroy.or_panic
      assert Deed[db].where(home_id: home.id).count.or_panic == 0_i64
    end
  end

  it "nullifies the children's foreign key with one UPDATE" do
    with_homes do |db|
      home = Home.create(db, name: "h").or_panic
      t = Tag.create(db, home_id: home.id, label: "t").or_panic
      Tag.create(db, home_id: home.id, label: "u").or_panic
      start = db.statements.size
      home.destroy.or_panic
      assert count_of(db, start, "UPDATE `tags` SET `home_id` = NULL WHERE `home_id` = ?") == 1
      assert Tag[db].count.or_panic == 2_i64
      assert Tag[db].where(home_id: nil).count.or_panic == 2_i64
      assert Tag[db].find(t.id).or_panic.home_id.nil?
    end
  end

  it "refuses with CallbackError while a restricted child exists" do
    with_homes do |db|
      vault = Vault.create(db, name: "v").or_panic
      Lock.create(db, vault_id: vault.id).or_panic
      result = vault.destroy
      assert result.is_a?(CallbackError)
      assert !vault.destroyed?
      assert Vault[db].where(id: vault.id).exists?.or_panic
      empty = Vault.create(db, name: "e").or_panic
      empty.destroy.or_panic
      assert !Vault[db].where(id: empty.id).exists?.or_panic
    end
  end

  it "rolls the whole destroy back when a child's callback refuses" do
    with_homes do |db|
      home = Home.create(db, name: "h").or_panic
      Room.create(db, home_id: home.id, name: "a").or_panic
      Room.create(db, home_id: home.id, name: "keep").or_panic
      Note.create(db, home_id: home.id, body: "n").or_panic
      Tag.create(db, home_id: home.id, label: "t").or_panic
      result = home.destroy
      assert result.is_a?(CallbackError)
      assert !home.destroyed?
      assert Home[db].where(id: home.id).exists?.or_panic
      # Room "a" was destroyed before "keep" refused; that is undone too.
      assert Room[db].where(home_id: home.id).count.or_panic == 2_i64
      assert Trail[db].count.or_panic == 0_i64
      assert Note[db].where(home_id: home.id).count.or_panic == 1_i64
      assert Tag[db].where(home_id: home.id).count.or_panic == 1_i64
    end
  end

  it "runs inside an open write without its own BEGIN" do
    with_homes do |db|
      home = Home.create(db, name: "h").or_panic
      Room.create(db, home_id: home.id, name: "a").or_panic
      Note.create(db, home_id: home.id, body: "n").or_panic
      db.write do |tx|
        found = Home[tx].find(home.id).or_panic
        found.destroy.or_panic
        assert Room[tx].count.or_panic == 0_i64
        nil
      end.or_panic
      assert Home[db].count.or_panic == 0_i64
      assert Note[db].count.or_panic == 0_i64
      assert Trail[db].count.or_panic == 1_i64
    end
  end
end
