module test/grant_adapter_read_tape_test
import grant/base::{Base}
import std/indexable
import test/spec_helper::{register_spec_connections}

pub class TapeNote < Base
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table tape_notes
  column id : Int64, primary: true
  column title : String?
end

register_spec_connections
TapeNote.migrator.drop_and_create.or_panic
TapeNote.create_strict(title: "café").or_panic
TapeNote.create_strict(title: nil).or_panic

# Result set columns read onto the fiber's tape through Grant's driver facade.
adapter = TapeNote.adapter
seen = adapter.open do |db|
  titles = [] of String
  db.query("SELECT title, id FROM tape_notes ORDER BY id") do |rs|
    rs.each do
      tape do
        title = rs.read_tape.or_panic
        rs.read.or_panic
        titles << (title.is_a?(Tape::String) ? title.to_heap : "NULL")
      end
      nil
    end
  end
  titles
end.or_panic
assert seen == ["café", "NULL"]
