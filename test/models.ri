# The models the tests share.
module test/models

import ricord
import ricord/model::{model}

model Account do
  table :accounts
  col :name, :string
  has_many :courts
  has_one :profile
end

model Court do
  table :courts
  col :account_id, belongs_to: :account, on_delete: :cascade, null: true
  col :name, :string
  col :rank, :integer, null: true
  col :score, :float, null: true
  col :active, :boolean, default: true
  col :opened_at, :datetime, null: true
  index :name, unique: true
  has_many :cases
  has_one :lead_case, class_name: Case, foreign_key: :court_id
end

model Case do
  table :cases
  col :court_id, belongs_to: :court, on_delete: :restrict
  col :title, :string
end

model User do
  table :users
  col :email, :string
  col :admin, :boolean, default: false
  has_one :profile, foreign_key: :owner_id
end

model Profile do
  table :profiles
  col :account_id, belongs_to: :account, null: true, index: false
  col :owner_id, :int64, belongs_to: :owner, class_name: User, null: true
  col :bio, :string
end

model Setting do
  table :settings
  col :prefs, :json, default: "{}"
  col :photo, :binary, null: true
end
