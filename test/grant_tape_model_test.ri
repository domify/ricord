module test/grant_tape_model_test
import std/indexable
import std/env::{ENV}
import std/time::{Time}
import std/uuid::{UUID}
import std/regex
import grant/tape_model
import grant/errors::{Rollback, RecordNotFound}
import test/spec_helper::{register_spec_connections}

# Callback calls, counted on the heap.
class Counters
  @@saves = 0
  @@destroys = 0

  def self.saves : Int32
    @@saves
  end

  def self.saves=(value : Int32) : Int32
    @@saves = value
  end

  def self.destroys : Int32
    @@destroys
  end

  def self.destroys=(value : Int32) : Int32
    @@destroys = value
  end
end

# Declared as Grant models are, inside `model ... do`.
::Grant::TapeModel.model TapeTeam do
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table tape_teams
  column id : Int64, primary: true
  column title : String
  has_many users : TapeUser, foreign_key: team_id, dependent: :nullify
end

::Grant::TapeModel.model TapeUser do
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table tape_users
  column id : Int64, primary: true
  column name : String?
  column email : String?
  column score : Int64?
  column rating : Float64?
  column active : Bool?
  column token : UUID?
  column role : String?
  timestamps
  belongs_to team : TapeTeam, optional: true
  has_many posts : TapePost, dependent: :destroy
  validates_presence_of :name
  validates_length_of :name, maximum: 12
  validates_format_of :email, with: /@/
  validates_inclusion_of :role, in: ["admin", "member"]
  validate :no_root
  before_save :count_save
  after_destroy :count_destroy

  def no_root : Nil
    @errors.add("name", "is reserved") if name == "root"
    nil
  end

  def count_save : Nil
    Counters.saves += 1
    nil
  end

  def count_destroy : Nil
    Counters.destroys += 1
    nil
  end
end

::Grant::TapeModel.model TapePost do
  connection {{ (env("CURRENT_ADAPTER") || "sqlite").id }}
  table tape_posts
  column id : Int64, primary: true
  column title : String
  belongs_to tape_user : TapeUser
end

register_spec_connections
pg = (ENV["CURRENT_ADAPTER"]? || "sqlite") == "pg"
key = pg ? "BIGSERIAL PRIMARY KEY" : "INTEGER PRIMARY KEY"
time = pg ? "TIMESTAMP" : "TEXT"
boolean = pg ? "BOOLEAN" : "INTEGER"
real = pg ? "DOUBLE PRECISION" : "REAL"
TapeUser.adapter.open do |db|
  db.execute("DROP TABLE IF EXISTS tape_posts").or_panic
  db.execute("DROP TABLE IF EXISTS tape_users").or_panic
  db.execute("DROP TABLE IF EXISTS tape_teams").or_panic
  db.execute("CREATE TABLE tape_teams (id #{key}, title TEXT NOT NULL)").or_panic
  db.execute("CREATE TABLE tape_users (id #{key}, name TEXT, email TEXT, score BIGINT, rating #{real}, " \
             "active #{boolean}, token TEXT, role TEXT, created_at #{time}, updated_at #{time}, team_id BIGINT)").or_panic
  db.execute("CREATE TABLE tape_posts (id #{key}, title TEXT NOT NULL, tape_user_id BIGINT)").or_panic
end.or_panic

# A view: the record's text goes straight into the page on the tape.
def user_page(user : TapeUser) : Tape::String
  page = Tape::String::Writer.new(64)
  page << "<h1>"
  name = user.name
  page << name unless name.nil?
  page << "</h1><p>" << user.score.to_s << "</p>"
  page.finish
end

html = ""
json = ""
kept = nil.as(TapeUser::Data?)
names = [] of String
titles = [] of String
token = UUID.v4

# One request: create, find, render, update, query and destroy on its tape.
tape do
  core = TapeTeam.create_strict(title: "Core").or_panic
  ann = TapeUser.create_strict(name: "Ann", email: "ann@example.com", score: 3_i64, rating: 4.5, active: true,
    token: token, role: "admin", team_id: core.id).or_panic
  bob = TapeUser.create_strict(name: "Bob", score: 9_i64, active: false).or_panic
  TapeUser.create_strict(name: "Cy", score: 9_i64).or_panic
  TapePost.create_strict(title: "First", tape_user_id: ann.id).or_panic
  TapePost.create_strict(title: "Second", tape_user_id: ann.id).or_panic
  TapePost.create_strict(title: "Bob's", tape_user_id: bob.id).or_panic
  assert Counters.saves == 3

  # Columns read back with their types; text is on the tape.
  user = TapeUser.find_strict(ann.id).or_panic
  name = user.name
  assert name.is_a?(Tape::String) && name == "Ann"
  assert user.score == 3_i64
  assert user.rating == 4.5
  assert user.active == true
  assert user.token == token
  created = user.created_at
  assert created.is_a?(Time) && (Time.utc - created).total_seconds.abs < 60
  assert !user.changed?
  assert user.to_param == ann.id.to_s
  html = user_page(user).to_heap
  json = user.to_json.to_heap

  # Associations, read lazily.
  owner = user.team.or_panic
  assert owner.is_a?(TapeTeam) && owner.title == "Core"
  assert core.users.count.or_panic == 1_i64
  assert user.posts.count.or_panic == 2_i64

  # Dirty tracking: a setter marks its column, save writes only those.
  user.score = 7_i64
  assert user.score_changed?
  assert user.changed_attributes == ["score"]
  assert user.save.or_panic
  assert !user.changed?

  # A copy is the same record: an update through it is seen by both.
  same = user
  assert same.update(name: "Bea", score: 9_i64).or_panic
  assert user.name == "Bea"
  reread = TapeUser.find_strict(user.id).or_panic
  assert reread.name == "Bea" && reread.score == 9_i64
  kept = user.to_heap

  # The heap copy comes back onto the tape as the same row.
  data = user.to_heap
  back = TapeUser.from_heap(data)
  assert back.persisted? && back.name == "Bea" && back.id == user.id

  # Validations refuse a save, with Grant's messages, and leave the row alone.
  blank = TapeUser.new(score: 1_i64)
  assert !blank.save.or_panic
  assert blank.errors.full_messages == ["Name can't be blank"]
  assert blank.new_record?
  long = TapeUser.create(name: "a name that is too long", email: "nope", role: "guest").or_panic
  assert !long.persisted?
  assert long.errors["name"] == ["is too long (maximum is 12 characters)"]
  assert long.errors["email"] == ["is invalid"]
  assert long.errors["role"] == ["is not included in the list"]
  root = TapeUser.new(name: "root")
  assert !root.valid?
  assert root.errors["name"] == ["is reserved"]
  assert TapeUser.create_strict(name: "").is_a?(::Grant::Error::ErrorBase)
  assert TapePost.new(title: "orphan").save.or_panic == false
  assert TapeUser.find_strict(999_i64).is_a?(RecordNotFound)

  # where: equality, nil, IN, ranges, raw SQL, OR groups, order and limit.
  TapeUser.where(score: 9_i64).order(:name).each do |record|
    text = record.name
    names << (text.nil? ? "NULL" : text.to_heap)
  end.or_panic
  assert TapeUser.where(name: ["Bob", "Cy"]).count.or_panic == 2_i64
  assert TapeUser.where(name: [] of String).count.or_panic == 0_i64
  assert TapeUser.where(score: 5_i64..9_i64).count.or_panic == 3_i64
  assert TapeUser.where(score: 5_i64...9_i64).count.or_panic == 0_i64
  assert TapeUser.where(team_id: nil).count.or_panic == 2_i64
  assert TapeUser.where("score > ?", 8_i64).count.or_panic == 3_i64
  assert TapeUser.where(name: "Bob").or_where(name: "Cy").count.or_panic == 2_i64
  assert TapeUser.order(:name, :desc).limit(1).first_strict.or_panic.name == "Cy"
  assert TapeUser.where(score: 1_i64).first.or_panic.nil?
  assert TapeUser.find_by_strict(name: "Bob").or_panic.active == false
  assert TapeUser.exists?(name: "Bob").or_panic
  # A chained relation is a new one: the first is unchanged.
  nines = TapeUser.where(score: 9_i64)
  assert nines.where(name: "Bob").count.or_panic == 1_i64
  assert nines.count.or_panic == 3_i64
  plucked = TapeUser.order(:name).pluck(:name).or_panic
  assert plucked.size == 3 && plucked[0][0].as(Tape::String) == "Bea"

  # includes: one query per association, then no query per record. The
  # teams and posts rows are changed after the preload; the preloaded
  # records still answer what was read.
  loaded = TapeUser.includes(:team, :posts).order(:name).to_a.or_panic
  TapeTeam.all.update_all(title: "Renamed").or_panic
  TapePost.where(title: "First").update_all(title: "Changed").or_panic
  loaded.each do |record|
    team = record.team.or_panic
    titles << (record.name.as(Tape::String).to_heap + ":" + (team.is_a?(TapeTeam) ? team.title.to_heap : "-") + ":" +
               record.posts.count.or_panic.to_s)
  end
  first_posts = loaded[0].posts.to_a.or_panic
  assert first_posts.size == 2 && first_posts[0].title == "First"
  assert TapeUser.includes(:nope).to_a.is_a?(::Grant::Error::ErrorBase)

  # JSON of a relation, written on the tape.
  listing = Tape::String::Writer.new(64)
  TapeUser.where(name: "Cy").to_json(listing).or_panic
  assert listing.finish.to_heap.starts_with?("[{\"id\":")

  # A transaction rolls back on Rollback, and on an error from its block.
  before = TapeUser.count.or_panic
  TapeUser.transaction do
    TapeUser.create_strict(name: "Gone").or_panic
    Rollback.new
  end
  assert TapeUser.count.or_panic == before
  failed = TapeUser.transaction do
    TapeUser.create_strict(name: "Gone too").or_panic
    TapeUser.create_strict(name: "")
  end
  assert failed.is_a?(::Grant::Error::ErrorBase)
  assert TapeUser.count.or_panic == before

  # destroy runs callbacks and dependent: destroy, in one transaction;
  # delete_all runs neither; the team's dependent: nullify clears team_id.
  assert user.destroy.or_panic
  assert user.destroyed?
  assert Counters.destroys == 1
  assert TapePost.where(tape_user_id: ann.id).count.or_panic == 0_i64
  assert TapePost.count.or_panic == 1_i64
  assert TapeUser.where(name: "Bob").delete_all.or_panic == 1_i64
  assert Counters.destroys == 1
  cy = TapeUser.find_by_strict(name: "Cy").or_panic
  cy.team = core
  assert cy.save.or_panic
  assert core.destroy.or_panic
  assert cy.reload.or_panic.team_id.nil?
end

assert html == "<h1>Ann</h1><p>3</p>"
assert json.starts_with?("{\"id\":") && json.includes?("\"name\":\"Ann\",\"email\":\"ann@example.com\"")
assert json.includes?("\"active\":true") && json.includes?("\"token\":\"" + token.to_s + "\"")
assert names == ["Bea", "Bob", "Cy"]
assert titles == ["Bea:Core:2", "Bob:-:1", "Cy:-:0"]
heap = kept.as(TapeUser::Data)
assert heap.name == "Bea"
assert heap.score == 9_i64
assert heap.token == token
