# M2: method-named before_/after_ callbacks for validation, save, create,
# update and destroy; a callback that returns an error refuses the action with
# CallbackError and rolls its write back (inside db.write only its savepoint).
module test/callback_test

import db/db/spec::{describe, it}
import ricord
import ricord/model::{model}
import ricord/failures::{CallbackError, DatabaseError, RecordInvalid, Failure}
import test/spec_helper::*
import test/models::*

# Each callback appends its stage to `trail` (a record is a store index, so the
# order is kept in a column) and refuses when `stop_at` names its stage.
model Hook do
  table :hooks
  col :name, :string
  col :trail, :string, default: ""
  col :stop_at, :string, null: true
  col :token, :string, null: true
  before_validation :at_before_validation
  after_validation :at_after_validation
  before_save :at_before_save
  before_create :at_before_create, :make_token
  after_create :at_after_create
  before_update :at_before_update
  after_update :at_after_update
  after_save :at_after_save
  before_destroy :at_before_destroy
  after_destroy :at_after_destroy
  validates :name, presence: true

  def step(stage : String) : Nil | ::Ricord::Failures::Error
    self.trail = "#{trail}#{stage} "
    stop_at == stage ? ::Ricord::Failures::DatabaseError.new(TABLE, "test", "stop at #{stage}") : nil
  end

  def at_before_validation : Nil | ::Ricord::Failures::Error
    step("before_validation")
  end

  def at_after_validation : Nil | ::Ricord::Failures::Error
    step("after_validation")
  end

  def at_before_save : Nil | ::Ricord::Failures::Error
    step("before_save")
  end

  def at_before_create : Nil | ::Ricord::Failures::Error
    step("before_create")
  end

  # Fills a column before the INSERT, as Grant's before_create key generator.
  def make_token : Nil | ::Ricord::Failures::Error
    self.token = "tok-#{name}"
    nil
  end

  def at_after_create : Nil | ::Ricord::Failures::Error
    step("after_create")
  end

  def at_before_update : Nil | ::Ricord::Failures::Error
    step("before_update")
  end

  def at_after_update : Nil | ::Ricord::Failures::Error
    step("after_update")
  end

  def at_after_save : Nil | ::Ricord::Failures::Error
    step("after_save")
  end

  def at_before_destroy : Nil | ::Ricord::Failures::Error
    step("before_destroy")
  end

  def at_after_destroy : Nil | ::Ricord::Failures::Error
    step("after_destroy")
  end
end

def with_hooks(& : Ricord::Sessions::Session -> Nil) : Nil
  with_db do |db|
    Hook.create_table(db).or_panic
    yield db
  end
end

# A saved hook whose trail and stop mark start empty again.
def saved_hook(db : Ricord::Sessions::Db, name : String) : Hook
  hook = Hook.create(db, name: name).or_panic
  hook.trail = ""
  hook
end

describe "callback order" do
  it "runs the create callbacks in order" do
    with_hooks do |db|
      hook = Hook.create(db, name: "a").or_panic
      assert hook.trail == "before_validation after_validation before_save before_create after_create after_save "
      row = Hook[db].find(hook.id).or_panic
      assert row.trail == "before_validation after_validation before_save before_create ", "the INSERT carries what ran before it"
      assert row.token == "tok-a", "a before_create callback fills a column"
    end
  end

  it "runs the update callbacks in order" do
    with_hooks do |db|
      hook = saved_hook(db, "a")
      hook.save.or_panic
      assert hook.trail == "before_validation after_validation before_save before_update after_update after_save "
    end
  end

  it "runs the destroy callbacks in order" do
    with_hooks do |db|
      hook = saved_hook(db, "a")
      hook.destroy.or_panic
      assert hook.trail == "before_destroy after_destroy "
      assert hook.destroyed?
    end
  end

  it "runs the validation callbacks for valid?" do
    with_hooks do |db|
      hook = Hook.new(db, name: "a")
      assert hook.valid?
      assert hook.trail == "before_validation after_validation "
      assert Hook[db].count.or_panic == 0_i64
    end
  end

  it "stops before the save callbacks when validation fails" do
    with_hooks do |db|
      hook = Hook.new(db, name: "")
      assert hook.save.is_a?(RecordInvalid)
      assert hook.trail == "before_validation after_validation "
    end
  end
end

# Ported from grant_callbacks_abort: a refusal at each stage runs no later
# callback and leaves no row (or the old row) behind.
describe "callback refusal on create" do
  it "refuses at every stage, runs nothing later and writes nothing" do
    with_hooks do |db|
      stages = ["before_validation", "after_validation", "before_save", "before_create", "after_create", "after_save"]
      trails = [
        "before_validation ",
        "before_validation after_validation ",
        "before_validation after_validation before_save ",
        "before_validation after_validation before_save before_create ",
        "before_validation after_validation before_save before_create after_create ",
        "before_validation after_validation before_save before_create after_create after_save ",
      ]
      stages.each_with_index do |stage, i|
        hook = Hook.new(db, name: stage, stop_at: stage)
        result = hook.save
        assert result.is_a?(CallbackError)
        if result.is_a?(CallbackError)
          operation = stage.ends_with?("validation") ? "validate" : "save"
          method = "at_#{stage}"
          assert result.message == "hooks #{operation}: #{stage} #{method} refused"
        end
        assert hook.trail == trails[i]
        assert !hook.persisted?
        assert hook.new_record?
        assert hook.id == 0_i64, "a rolled-back create has no key"
        assert hook.changed?, "the unsaved values stay"
        assert Hook[db].find_by(name: stage).or_panic.nil?
      end
      assert Hook[db].count.or_panic == 0_i64
      assert db.statements.any?(&.starts_with?("ROLLBACK")), "a refusal after the write opened rolls back"
    end
  end
end

describe "callback refusal on update" do
  it "refuses at every stage and keeps the old row" do
    with_hooks do |db|
      stages = ["before_validation", "after_validation", "before_save", "before_update", "after_update", "after_save"]
      trails = [
        "before_validation ",
        "before_validation after_validation ",
        "before_validation after_validation before_save ",
        "before_validation after_validation before_save before_update ",
        "before_validation after_validation before_save before_update after_update ",
        "before_validation after_validation before_save before_update after_update after_save ",
      ]
      stages.each_with_index do |stage, i|
        hook = saved_hook(db, stage)
        hook.stop_at = stage
        result = hook.save
        assert result.is_a?(CallbackError)
        assert hook.trail == trails[i]
        assert hook.persisted?
        assert !hook.new_record?
        assert hook.changed?, "the unsaved change stays"
        assert Hook[db].find(hook.id).or_panic.stop_at.nil?, "the row keeps its old value"
      end
    end
  end
end

describe "callback refusal on destroy" do
  it "keeps the row when before_destroy refuses" do
    with_hooks do |db|
      hook = saved_hook(db, "a")
      hook.stop_at = "before_destroy"
      result = hook.destroy
      assert result.is_a?(CallbackError)
      if result.is_a?(CallbackError)
        assert result.message == "hooks destroy: before_destroy at_before_destroy refused"
      end
      assert hook.trail == "before_destroy "
      assert !hook.destroyed?
      assert hook.persisted?
      assert Hook[db].find(hook.id).is_a?(Hook)
    end
  end

  # Grant deleted the row when after_destroy aborted; Ricord rolls the DELETE back.
  it "rolls the DELETE back when after_destroy refuses" do
    with_hooks do |db|
      hook = saved_hook(db, "a")
      hook.stop_at = "after_destroy"
      assert hook.destroy.is_a?(CallbackError)
      assert hook.trail == "before_destroy after_destroy "
      assert !hook.destroyed?
      assert Hook[db].find(hook.id).is_a?(Hook)
    end
  end
end

describe "callback refusal inside db.write" do
  it "rolls back only the refused save's savepoint" do
    with_hooks do |db|
      db.write do |tx|
        kept = Hook.create(tx, name: "kept").or_panic
        refused = Hook.new(tx, name: "refused", stop_at: "before_save")
        assert refused.save.is_a?(CallbackError)
        late = Hook.new(tx, name: "late", stop_at: "after_save")
        assert late.save.is_a?(CallbackError)
        assert late.new_record?
        assert Hook[tx].count.or_panic == 1_i64, "the write still holds the first row"
        assert kept.persisted?
        nil
      end.or_panic
      assert Hook[db].order(:name).to_a.or_panic.map(&.name) == ["kept"]
      assert db.statements.any?(&.starts_with?("ROLLBACK TO ricord_"))
      assert db.statements.includes?("COMMIT")
    end
  end

  it "rolls the whole write back when the block returns the refusal" do
    with_hooks do |db|
      result = db.write do |tx|
        Hook.create(tx, name: "first").or_panic
        second = Hook.new(tx, name: "second", stop_at: "before_create").save
        second.is_a?(CallbackError) ? second : nil
      end
      assert result.is_a?(CallbackError)
      assert Hook[db].count.or_panic == 0_i64
    end
  end
end
