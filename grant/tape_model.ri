module grant/tape_model

import std/indexable
import std/int
import std/tuple
import std/named_tuple
import std/text
import std/regex
import std/time::{Time}
import std/uuid::{UUID}
import grant/adapter/driver::{Value, TapeValue}
import grant/adapter/base
import grant/connections::{Connections}
import grant/error::{ErrorBase}
import grant/errors::{Errors, RecordNotFound}
import grant/query/executor
import grant/transaction

# Models whose records live on the running fiber's tape: in a web app the
# request's, which the server opens per request. `User.find(1)` reads the row
# straight onto the tape, a view writes `user.name` (a `Tape::String`) into the
# response, `send` puts that on the socket, and the request's end frees it
# all at once. Nothing is collected and nothing is copied on the way.
#
# A model is declared as a Grant model is, inside `model ... do` instead of
# `class ... < Grant::Base` (doc/TAPE_MODEL.md):
#
#     ::Grant::TapeModel.model User do
#       connection sqlite
#       table users
#       column id : Int64, primary: true
#       column name : String
#       timestamps
#       belongs_to team : Team
#       has_many posts : Post, dependent: :destroy
#       validates_presence_of :name
#       before_save :strip_name
#
#       def strip_name : Nil
#         ...
#       end
#     end
#
# A record is a handle: its values, change marks, state and preloaded
# associations sit in `Tape::Array`s that copies share, so a change made
# through any copy is seen by all. The compiler refuses a record anywhere it
# could outlive the tape (a class variable, a heap container, a proc); a
# record crosses that line as `to_heap`, a `User::Data` on the heap, and
# comes back with `User.from_heap`.
pub macro model(name, &block)
  {% declarations = block.body.is_a?(Expressions) ? block.body.expressions : [block.body] %}
  {% nodes = [] of ASTNode %}
  {% for declaration in declarations %}
    {% node = declaration.is_a?(Assign) ? declaration.value : declaration %}
    {% if node.is_a?(Expressions) %}
      {% for inner in node.expressions %}
        {% nodes << (inner.is_a?(Assign) ? inner.value : inner) %}
      {% end %}
    {% else %}
      {% nodes << node %}
    {% end %}
  {% end %}
  {% calls = [] of ASTNode %}
  {% defs = [] of ASTNode %}
  {% for node in nodes %}
    {% if node.is_a?(Def) %}
      {% defs << node %}
    {% elsif node.is_a?(Call) && !node.name.starts_with?("__iyi") %}
      {% calls << node %}
    {% end %}
  {% end %}

  {% connection_name = "sqlite" %}
  {% table_name = name.stringify.underscore + "s" %}
  {% columns = [] of ASTNode %}
  {% for call in calls %}
    {% if call.name == "connection" %}
      {% connection_name = call.args[0].is_a?(StringLiteral) ? call.args[0] : call.args[0].stringify %}
    {% elsif call.name == "table" %}
      {% table_name = call.args[0].is_a?(StringLiteral) ? call.args[0] : call.args[0].stringify %}
    {% elsif call.name == "column" %}
      {% primary = call.named_args && call.named_args.any? { |arg| arg.name == "primary" } %}
      {% columns << {call.args[0].var.stringify, call.args[0].type.stringify, primary} %}
    {% elsif call.name == "timestamps" %}
      {% columns << {"created_at", "Time?", false} %}
      {% columns << {"updated_at", "Time?", false} %}
    {% end %}
  {% end %}

  # Associations: {kind, name, target, foreign key, dependent, optional}.
  {% associations = [] of ASTNode %}
  {% for call in calls %}
    {% if call.name == "belongs_to" || call.name == "has_many" || call.name == "has_one" %}
      {% first = call.args[0] %}
      {% assoc = first.is_a?(TypeDeclaration) ? first.var.stringify : first.is_a?(SymbolLiteral) ? first.id.stringify : first.stringify %}
      {% target = first.is_a?(TypeDeclaration) ? first.type : nil %}
      {% key = nil %}
      {% dependent = "" %}
      {% optional = false %}
      {% if call.named_args %}
        {% for arg in call.named_args %}
          {% if arg.name == "class_name" %}
            {% target = arg.value %}
          {% elsif arg.name == "foreign_key" %}
            {% key = arg.value.is_a?(TypeDeclaration) ? arg.value.var.stringify : arg.value.is_a?(SymbolLiteral) ? arg.value.id.stringify : arg.value.stringify %}
          {% elsif arg.name == "dependent" %}
            {% dependent = arg.value.id.stringify %}
          {% elsif arg.name == "optional" %}
            {% optional = arg.value %}
          {% end %}
        {% end %}
      {% end %}
      {% if call.name == "belongs_to" %}
        {% key = key || assoc + "_id" %}
        {% unless columns.any? { |column| column[0] == key } %}
          {% columns << {key, "Int64?", false} %}
        {% end %}
      {% else %}
        {% key = key || name.stringify.underscore + "_id" %}
      {% end %}
      {% associations << {call.name, assoc, target, key, dependent, optional} %}
    {% end %}
  {% end %}

  {% primary_column = columns.find { |column| column[2] } || columns.first %}
  {% primary_name = primary_column[0] %}
  {% column_names = columns.map { |column| column[0] } %}

  @[OnTape]
  pub struct {{ name }}
    COLUMNS = [{% for column in columns %}{{ column[0] }}, {% end %}] of String
    TABLE = {{ table_name }}
    PRIMARY = {{ primary_name }}
    PRIMARY_SYMBOL = {{ primary_name.id.symbolize }}
    CONNECTION = {{ connection_name }}
    # @state: persisted, destroyed, then one "loaded" mark per association.
    STATE_SIZE = {{ 2 + associations.size }}

    {% for association in associations %}
      @__{{ association[1].id }} : Tape::Array({{ association[2] }}) = Tape::Array({{ association[2] }}).new(0)
    {% end %}

    def initialize(@values : Tape::Array(::Grant::Adapter::Driver::TapeValue), @changed : Tape::Array(Bool),
                   @state : Tape::Array(Bool), @errors : ::Grant::Errors::Errors)
    end

    # A new, unsaved record with *attributes* set.
    def self.new(**attributes) : {{ name }}
      record = __blank(false)
      record.assign(**attributes)
      record
    end

    protected def self.__blank(persisted : Bool) : {{ name }}
      values = Tape::Array(::Grant::Adapter::Driver::TapeValue).new(COLUMNS.size, nil.as(::Grant::Adapter::Driver::TapeValue))
      state = Tape::Array(Bool).new(STATE_SIZE, false)
      state[0] = persisted
      new(values, Tape::Array(Bool).new(COLUMNS.size, false), state, ::Grant::Errors::Errors.new)
    end

    def self.adapter : ::Grant::Adapter::Base::Base
      ::Grant::Connections::Connections[CONNECTION]
    end

    def self.quote(name : String) : String
      adapter.quote(name)
    end

    def self.select_sql : String
      "SELECT " + COLUMNS.map { |column| quote(TABLE) + "." + quote(column) }.join(", ") + " FROM " + quote(TABLE)
    end

    # A value to bind: tape text goes to the heap, a UUID as its text.
    def self.bind(value : Tape::String) : ::Grant::Adapter::Driver::Value
      value.to_heap
    end

    def self.bind(value : UUID) : ::Grant::Adapter::Driver::Value
      value.to_s
    end

    def self.bind(value : Int32) : ::Grant::Adapter::Driver::Value
      value.to_i64
    end

    def self.bind(value : ::Grant::Adapter::Driver::Value) : ::Grant::Adapter::Driver::Value
      value
    end

    # One row of *result_set*, its columns in COLUMNS order, onto the tape.
    def self.load(result_set : ::Grant::Adapter::Driver::ResultSet) : {{ name }} | ::Grant::Error::ErrorBase
      record = __blank(true)
      COLUMNS.size.times { |index| record.__values[index] = result_set.read_tape! }
      record
    end

    protected def __values : Tape::Array(::Grant::Adapter::Driver::TapeValue)
      @values
    end

    # The rows of *sql* as records on the tape.
    def self.load_all(sql : String, args : Array(::Grant::Adapter::Driver::Value)) : Tape::Array({{ name }}) | ::Grant::Error::ErrorBase
      statement = adapter.ensure_clause_template(sql)
      ::Grant::Query::Executor.open_statement(adapter, statement, args) do |db|
        db.query(statement, args) do |result_set|
          records = Tape::Array({{ name }}).new
          result_set.each do
            records << load(result_set)!
            nil
          end!
          records
        end
      end
    end

    def self.execute(sql : String, args : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value) : ::Grant::Adapter::Driver::Mutation | ::Grant::Error::ErrorBase
      statement = adapter.ensure_clause_template(sql)
      ::Grant::Query::Executor.open_statement(adapter, statement, args) { |db| db.execute(statement, args) }
    end

    # Runs the block in a transaction on this model's connection: every
    # statement in it, any model's on that connection, uses the same one.
    # An error or `Grant::Transaction::Rollback` from the block rolls back.
    def self.transaction(&block : -> T) : T | Nil | ::Grant::Error::ErrorBase forall T
      ::Grant::Transaction.run(adapter, ::Grant::Transaction::Options.new) { yield }
    end

    # --------------------------------------------------------------- finders

    def self.all : Query
      Query.new
    end

    def self.find(id) : {{ name }} | Nil | ::Grant::Error::ErrorBase
      Query.new.where({{ primary_name.id }}: id).first
    end

    def self.find_strict(id) : {{ name }} | ::Grant::Errors::RecordNotFound | ::Grant::Error::ErrorBase
      found = find(id)!
      return ::Grant::Errors::RecordNotFound.new({{ name.stringify }}, id.to_s) if found.nil?
      found
    end

    def self.find_by(**criteria) : {{ name }} | Nil | ::Grant::Error::ErrorBase
      Query.new.where(**criteria).first
    end

    def self.find_by_strict(**criteria) : {{ name }} | ::Grant::Errors::RecordNotFound | ::Grant::Error::ErrorBase
      found = find_by(**criteria)!
      return ::Grant::Errors::RecordNotFound.new("Couldn't find " + {{ name.stringify }}) if found.nil?
      found
    end

    def self.where(**criteria) : Query
      Query.new.where(**criteria)
    end

    def self.where(sql : String, *args) : Query
      Query.new.where(sql, *args)
    end

    def self.order(column : Symbol, direction : Symbol = :asc) : Query
      Query.new.order(column, direction)
    end

    def self.limit(count : Int32) : Query
      Query.new.limit(count)
    end

    def self.includes(*associations : Symbol) : Query
      Query.new.includes(*associations)
    end

    def self.first : {{ name }} | Nil | ::Grant::Error::ErrorBase
      Query.new.order(PRIMARY_SYMBOL).first
    end

    def self.count : Int64 | ::Grant::Error::ErrorBase
      Query.new.count
    end

    def self.exists?(**criteria) : Bool | ::Grant::Error::ErrorBase
      Query.new.where(**criteria).exists?
    end

    def self.pluck(*fields : Symbol | String) : Tape::Array(Tape::Array(::Grant::Adapter::Driver::TapeValue)) | ::Grant::Error::ErrorBase
      Query.new.pluck(*fields)
    end

    # A record saved with *attributes*; check `persisted?` and `errors` when
    # a validation can refuse it.
    def self.create(**attributes) : {{ name }} | ::Grant::Error::ErrorBase
      record = new(**attributes)
      record.save!
      record
    end

    def self.create_strict(**attributes) : {{ name }} | ::Grant::Error::ErrorBase
      record = new(**attributes)
      record.save_strict!
      record
    end

    def self.delete_all : Int64 | ::Grant::Error::ErrorBase
      Query.new.delete_all
    end

    # --------------------------------------------------------------- columns

    {% index = 0 %}
    {% for column in columns %}
      {% field = column[0].id %}
      {% type = column[1] %}
      {% nilable = type.ends_with?("?") || type.includes?("Nil") || column[0] == primary_name %}
      {% kind = type.includes?("String") ? "text" : type.includes?("Int32") ? "int32" : type.includes?("Int64") ? "int64" : type.includes?("Float") ? "float" : type.includes?("Bool") ? "bool" : type.includes?("Time") ? "time" : type.includes?("UUID") ? "uuid" : "other" %}
      {% result = kind == "text" ? "Tape::String" : kind == "int32" ? "Int32" : kind == "int64" ? "Int64" : kind == "float" ? "Float64" : kind == "bool" ? "Bool" : kind == "time" ? "Time" : kind == "uuid" ? "UUID" : type %}

      def {{ field }} : {{ result.id }}{% if nilable %}?{% end %}
        value = @values[{{ index }}]
        {% if kind == "text" %}
          converted = value.is_a?(Tape::String) ? value : (value.is_a?(String) ? Tape::String.new(value) : nil)
        {% elsif kind == "int32" %}
          converted = value.is_a?(Int64) ? value.to_i32 : (value.is_a?(Int32) ? value : nil)
        {% elsif kind == "int64" %}
          converted = value.is_a?(Int64) ? value : (value.is_a?(Int32) ? value.to_i64 : nil)
        {% elsif kind == "float" %}
          converted = value.is_a?(Float64) ? value : (value.is_a?(Float32) ? value.to_f64 : nil)
        {% elsif kind == "bool" %}
          converted = value.is_a?(Bool) ? value : (value.is_a?(Int64) ? value != 0 : nil)
        {% elsif kind == "time" %}
          converted = if value.is_a?(Time)
                        value
                      elsif value.is_a?(Tape::String)
                        ::Grant::TapeModel.parse_time(value) || ::Grant::TapeModel.read_time({{ name }}.adapter, value.to_heap)
                      elsif value.is_a?(String)
                        ::Grant::TapeModel.read_time({{ name }}.adapter, value)
                      end
        {% elsif kind == "uuid" %}
          converted = if value.is_a?(Tape::String)
                        UUID.parse(value).to_heap
                      elsif value.is_a?(String)
                        UUID.parse(value)
                      end
        {% else %}
          converted = value.is_a?({{ type.id }}) ? value : nil
        {% end %}
        {% if nilable %}
          converted
        {% else %}
          converted.as({{ result.id }})
        {% end %}
      end

      def {{ field }}=(value) : Nil
        @values[{{ index }}] = {{ name }}.__store_{{ field }}(value)
        @changed[{{ index }}] = true
        nil
      end

      def self.__store_{{ field }}(value : String) : ::Grant::Adapter::Driver::TapeValue
        {% if kind == "uuid" %}value{% else %}Tape::String.new(value){% end %}
      end

      def self.__store_{{ field }}(value : Tape::String) : ::Grant::Adapter::Driver::TapeValue
        value
      end

      def self.__store_{{ field }}(value : UUID) : ::Grant::Adapter::Driver::TapeValue
        value.to_s
      end

      def self.__store_{{ field }}(value : Int32) : ::Grant::Adapter::Driver::TapeValue
        value.to_i64
      end

      def self.__store_{{ field }}(value : Float32) : ::Grant::Adapter::Driver::TapeValue
        value.to_f64
      end

      def self.__store_{{ field }}(value : ::Grant::Adapter::Driver::Value) : ::Grant::Adapter::Driver::TapeValue
        value
      end

      def {{ field }}_changed? : Bool
        @changed[{{ index }}]
      end
      {% index += 1 %}
    {% end %}

    def __primary_value : Int64?
      {{ primary_name.id }}
    end

    def to_param : String
      {{ primary_name.id }}.to_s
    end

    def assign(**attributes : **T) : Nil forall T
      \{% for key in T.keys %}
        self.\{{ key.id }} = attributes[:\{{ key.id }}]
      \{% end %}
      nil
    end

    # ----------------------------------------------------------------- state

    def persisted? : Bool
      @state[0] && !@state[1]
    end

    def new_record? : Bool
      !@state[0]
    end

    def destroyed? : Bool
      @state[1]
    end

    def changed? : Bool
      @changed.any? { |mark| mark }
    end

    def changed_attributes : Array(String)
      names = [] of String
      COLUMNS.size.times { |index| names << COLUMNS[index] if @changed[index] }
      names
    end

    def errors : ::Grant::Errors::Errors
      @errors
    end

    # Reads the row again; preloaded associations are dropped.
    def reload : {{ name }} | ::Grant::Error::ErrorBase
      fresh = {{ name }}.find_strict({{ primary_name.id }})!
      COLUMNS.size.times do |index|
        @values[index] = fresh.__values[index]
        @changed[index] = false
      end
      (STATE_SIZE - 2).times { |index| @state[index + 2] = false }
      self
    end

    # ----------------------------------------------------------- validations

    def valid? : Bool
      @errors = ::Grant::Errors::Errors.new
      __run_before_validation
      {% for association in associations.select { |association| association[0] == "belongs_to" && !association[5] } %}
        @errors.add({{ association[1] }}, :required, message: "must exist") if {{ association[3].id }}.nil?
      {% end %}
      {% for call in calls.select { |call| call.name == "validates_presence_of" } %}
        {% for arg in call.args %}
          %value = {{ arg.id }}
          if %value.nil? || (%value.is_a?(Tape::String) && %value.empty?)
            @errors.add({{ arg.id.stringify }}, :blank)
          end
        {% end %}
      {% end %}
      {% for call in calls.select { |call| call.name == "validates_length_of" } %}
        {% field = call.args[0].id %}
        %text = {{ field }}
        unless %text.nil?
          {% for arg in call.named_args %}
            {% if arg.name == "minimum" %}
              @errors.add({{ field.stringify }}, :too_short, count: {{ arg.value }}) if %text.bytesize < {{ arg.value }}
            {% elsif arg.name == "maximum" %}
              @errors.add({{ field.stringify }}, :too_long, count: {{ arg.value }}) if %text.bytesize > {{ arg.value }}
            {% elsif arg.name == "is" %}
              @errors.add({{ field.stringify }}, :wrong_length, count: {{ arg.value }}) if %text.bytesize != {{ arg.value }}
            {% end %}
          {% end %}
        end
      {% end %}
      {% for call in calls.select { |call| call.name == "validates_format_of" } %}
        {% field = call.args[0].id %}
        {% pattern = call.named_args.find { |arg| arg.name == "with" }.value %}
        %formatted = {{ field }}
        # The pattern reads heap text: the value is copied for it.
        unless %formatted.nil? || {{ pattern }} === %formatted.to_heap
          @errors.add({{ field.stringify }}, :invalid)
        end
      {% end %}
      {% for call in calls.select { |call| call.name == "validates_inclusion_of" } %}
        {% field = call.args[0].id %}
        {% allowed = call.named_args.find { |arg| arg.name == "in" }.value %}
        %included = {{ field }}
        unless %included.nil? || {{ allowed }}.includes?(%included.is_a?(Tape::String) ? %included.to_heap : %included)
          @errors.add({{ field.stringify }}, :inclusion)
        end
      {% end %}
      {% for call in calls.select { |call| call.name == "validate" } %}
        {{ call.args[0].id }}
      {% end %}
      __run_after_validation
      @errors.empty?
    end

    # ------------------------------------------------------------- callbacks

    {% for hook in %w(before_validation after_validation before_save after_save before_create after_create before_update after_update before_destroy after_destroy) %}
      private def __run_{{ hook.id }} : Nil | ::Grant::Error::ErrorBase
        {% for call in calls.select { |call| call.name == hook } %}
          {% for arg in call.args %}
            %result = {{ arg.id }}
            return %result if %result.is_a?(::Grant::Error::ErrorBase)
          {% end %}
        {% end %}
        nil
      end
    {% end %}

    # ----------------------------------------------------------- persistence

    # Saves the record: false when a validation refuses it (see `errors`), an
    # error when the database or a callback does.
    def save : Bool | ::Grant::Error::ErrorBase
      return ::Grant::Error::ErrorBase.new("cannot save a destroyed record") if destroyed?
      return false unless valid?
      __run_before_save!
      if persisted?
        __run_before_update!
        {% if column_names.includes?("updated_at") %}
          self.updated_at = Time.utc if changed?
        {% end %}
        __update_row!
        __run_after_update!
      else
        __run_before_create!
        {% if column_names.includes?("created_at") %}
          self.created_at = Time.utc if created_at.nil?
        {% end %}
        {% if column_names.includes?("updated_at") %}
          self.updated_at = Time.utc if updated_at.nil?
        {% end %}
        __insert_row!
        __run_after_create!
      end
      __run_after_save!
      COLUMNS.size.times { |index| @changed[index] = false }
      true
    end

    # `save`, with a refused validation as an error naming the messages.
    def save_strict : Nil | ::Grant::Error::ErrorBase
      saved = save!
      return ::Grant::Error::ErrorBase.new("Validation failed: " + @errors.full_messages.join(", ")) unless saved
      nil
    end

    private def __insert_row : Nil | ::Grant::Error::ErrorBase
      names = [] of String
      args = [] of ::Grant::Adapter::Driver::Value
      COLUMNS.size.times do |index|
        next unless @changed[index]
        names << {{ name }}.quote(COLUMNS[index])
        args << __bind_at(index)
      end
      sql = if names.empty?
              "INSERT INTO " + {{ name }}.quote(TABLE) + " DEFAULT VALUES"
            else
              "INSERT INTO " + {{ name }}.quote(TABLE) + " (" + names.join(", ") + ") VALUES (" + names.map { "?" }.join(", ") + ")"
            end
      adapter = {{ name }}.adapter
      statement = adapter.ensure_clause_template(sql)
      mutation = ::Grant::Query::Executor.open_statement(adapter, statement, args) { |db| db.insert(statement, args, PRIMARY) }!
      self.{{ primary_name.id }} = mutation.last_insert_id if {{ primary_name.id }}.nil?
      @state[0] = true
      nil
    end

    private def __update_row : Nil | ::Grant::Error::ErrorBase
      sets = [] of String
      args = [] of ::Grant::Adapter::Driver::Value
      COLUMNS.size.times do |index|
        next unless @changed[index]
        sets << {{ name }}.quote(COLUMNS[index]) + " = ?"
        args << __bind_at(index)
      end
      return nil if sets.empty?
      args << {{ name }}.bind({{ primary_name.id }})
      {{ name }}.execute("UPDATE " + {{ name }}.quote(TABLE) + " SET " + sets.join(", ") + " WHERE " + {{ name }}.quote(PRIMARY) + " = ?", args)!
      nil
    end

    private def __bind_at(index : Int32) : ::Grant::Adapter::Driver::Value
      value = @values[index]
      value.is_a?(Tape::String) ? value.to_heap : value
    end

    # Sets *attributes* and saves.
    def update(**attributes) : Bool | ::Grant::Error::ErrorBase
      assign(**attributes)
      save
    end

    def update_strict(**attributes) : Nil | ::Grant::Error::ErrorBase
      assign(**attributes)
      save_strict
    end

    # Runs the destroy callbacks and each `dependent:` association, then
    # deletes the row, all in one transaction.
    def destroy : Bool | ::Grant::Error::ErrorBase
      return false unless persisted?
      outcome = {{ name }}.transaction do
        __destroy_in_transaction
      end
      return outcome if outcome.is_a?(::Grant::Error::ErrorBase)
      true
    end

    private def __destroy_in_transaction : Nil | ::Grant::Error::ErrorBase
      __run_before_destroy!
      {% for association in associations.select { |association| association[0] != "belongs_to" && association[4] != "" } %}
        {% if association[4] == "destroy" %}
          {{ association[2] }}.where({{ association[3].id }}: {{ primary_name.id }}).destroy_all!
        {% elsif association[4] == "delete_all" %}
          {{ association[2] }}.where({{ association[3].id }}: {{ primary_name.id }}).delete_all!
        {% elsif association[4] == "nullify" %}
          {{ association[2] }}.where({{ association[3].id }}: {{ primary_name.id }}).update_all({{ association[3].id }}: nil)!
        {% end %}
      {% end %}
      delete!
      __run_after_destroy!
      nil
    end

    def destroy_strict : Nil | ::Grant::Error::ErrorBase
      destroyed = destroy!
      return ::Grant::Error::ErrorBase.new("Failed to destroy the record") unless destroyed
      nil
    end

    # Deletes the row without callbacks.
    def delete : Nil | ::Grant::Error::ErrorBase
      args = [{{ name }}.bind({{ primary_name.id }})] of ::Grant::Adapter::Driver::Value
      {{ name }}.execute("DELETE FROM " + {{ name }}.quote(TABLE) + " WHERE " + {{ name }}.quote(PRIMARY) + " = ?", args)!
      @state[1] = true
      nil
    end

    # ---------------------------------------------------- the heap boundary

    # The record's values on the heap, to keep past the tape: in a cache, a
    # job's arguments, a message to another fiber.
    struct Data
      {% for column in columns %}
        {% type = column[1] %}
        {% heap = type.includes?("String") ? "String" : type.includes?("Int32") ? "Int32" : type.includes?("Int64") ? "Int64" : type.includes?("Float") ? "Float64" : type.includes?("Bool") ? "Bool" : type.includes?("Time") ? "Time" : type.includes?("UUID") ? "UUID" : type.gsub(/\?$/, "") %}
        getter {{ column[0].id }} : {{ heap.id }}?
      {% end %}

      def initialize({% for column in columns %}@{{ column[0].id }}, {% end %})
      end
    end

    def to_heap : Data
      Data.new(
        {% for column in columns %}
          {% if column[1].includes?("String") %}
            (%text{column[0]} = {{ column[0].id }}).nil? ? nil : %text{column[0]}.to_heap,
          {% else %}
            {{ column[0].id }},
          {% end %}
        {% end %}
      )
    end

    # A record on the tape from heap *data*, persisted when it has a key.
    def self.from_heap(data : Data) : {{ name }}
      record = __blank(!data.{{ primary_name.id }}.nil?)
      {% index = 0 %}
      {% for column in columns %}
        record.__values[{{ index }}] = __store_{{ column[0].id }}(data.{{ column[0].id }})
        {% index += 1 %}
      {% end %}
      record
    end

    # ------------------------------------------------------------------ JSON

    # The record as a JSON object written onto *json*, straight from its
    # tape values.
    def to_json(json : Tape::String::Writer) : Nil
      json << "{"
      {% index = 0 %}
      {% for column in columns %}
        json << {% if index > 0 %}",\"{% else %}"\"{% end %}{{ column[0].id }}\":"
        ::Grant::TapeModel.write_json(json, {{ column[0].id }})
        {% index += 1 %}
      {% end %}
      json << "}"
      nil
    end

    def to_json : Tape::String
      json = Tape::String::Writer.new(64)
      to_json(json)
      json.finish
    end

    # ---------------------------------------------------------- associations

    {% assoc_index = 0 %}
    {% for association in associations %}
      {% kind = association[0] %}
      {% assoc = association[1].id %}
      {% target = association[2] %}
      {% key = association[3].id %}
      {% if kind == "belongs_to" %}
        def {{ assoc }} : {{ target }} | Nil | ::Grant::Error::ErrorBase
          return @__{{ assoc }}.first? if @state[{{ 2 + assoc_index }}]
          id = {{ key }}
          id.nil? ? nil : {{ target }}.find(id)
        end

        def {{ assoc }}=(record : {{ target }}) : Nil
          self.{{ key }} = record.__primary_value
          __preloaded_{{ assoc }}(record)
        end

        def __preloaded_{{ assoc }}(record : {{ target }} | Nil) : Nil
          @__{{ assoc }}.clear
          @__{{ assoc }} << record unless record.nil?
          @state[{{ 2 + assoc_index }}] = true
          nil
        end

        # Loads every owner of *records* in one query.
        def self.__preload_{{ assoc }}(records : Tape::Array({{ name }})) : Nil | ::Grant::Error::ErrorBase
          ids = [] of ::Grant::Adapter::Driver::Value
          records.each do |record|
            id = record.{{ key }}
            ids << id unless id.nil? || ids.includes?(id)
          end
          owners = ids.empty? ? Tape::Array({{ target }}).new(0) : {{ target }}.all.where_in({{ target }}::PRIMARY, ids).to_a!
          records.each do |record|
            id = record.{{ key }}
            record.__preloaded_{{ assoc }}(id.nil? ? nil : owners.find { |owner| owner.__primary_value == id })
          end
          nil
        end
      {% else %}
        # Loads the {{ assoc }} of every record in *records* in one query.
        def self.__preload_{{ assoc }}(records : Tape::Array({{ name }})) : Nil | ::Grant::Error::ErrorBase
          ids = [] of ::Grant::Adapter::Driver::Value
          records.each do |record|
            id = record.__primary_value
            ids << id unless id.nil?
          end
          children = ids.empty? ? Tape::Array({{ target }}).new(0) : {{ target }}.all.where_in({{ key.stringify }}, ids).to_a!
          records.each do |record|
            id = record.__primary_value
            list = Tape::Array({{ target }}).new
            children.each { |child| list << child if child.{{ key }} == id }
            record.__preloaded_{{ assoc }}(list)
          end
          nil
        end

        def __preloaded_{{ assoc }}(list : Tape::Array({{ target }})) : Nil
          @__{{ assoc }}.clear
          list.each { |record| @__{{ assoc }} << record }
          @state[{{ 2 + assoc_index }}] = true
          nil
        end
        {% if kind == "has_many" %}
          def {{ assoc }} : {{ target }}::Query
            return {{ target }}::Query.preloaded(@__{{ assoc }}) if @state[{{ 2 + assoc_index }}]
            {{ target }}.where({{ key }}: {{ primary_name.id }})
          end
        {% else %}
          def {{ assoc }} : {{ target }} | Nil | ::Grant::Error::ErrorBase
            return @__{{ assoc }}.first? if @state[{{ 2 + assoc_index }}]
            {{ target }}.where({{ key }}: {{ primary_name.id }}).first
          end
        {% end %}
      {% end %}
      {% assoc_index += 1 %}
    {% end %}

    def self.__preload(records : Tape::Array({{ name }}), names : Array(String)) : Nil | ::Grant::Error::ErrorBase
      names.each do |association|
        case association
        {% for association in associations %}
          when {{ association[1] }}
            __preload_{{ association[1].id }}(records)!
        {% end %}
        else
          return ::Grant::Error::ErrorBase.new({{ name.stringify }} + " has no association " + association)
        end
      end
      nil
    end

    {% for definition in defs %}
      {{ definition }}
    {% end %}

    # A relation: conditions, order and limit on the heap; when it came from
    # a preloaded association, the records it already holds, on the tape.
    # Each chained call answers a new relation.
    @[OnTape]
    struct Query
      # Each group's conditions are joined with AND, the groups with OR.
      def initialize(@groups : Array(Array(String)) = [[] of String], @args : Array(::Grant::Adapter::Driver::Value) = [] of ::Grant::Adapter::Driver::Value,
                     @order : String = "", @limit : Int32? = nil, @offset : Int32? = nil,
                     @includes : Array(String) = [] of String,
                     @preloaded : Tape::Array({{ name }}) = Tape::Array({{ name }}).new(0), @from_preloaded : Bool = false)
      end

      def self.preloaded(records : Tape::Array({{ name }})) : Query
        new(preloaded: records, from_preloaded: true)
      end

      private def chain : Query
        Query.new(@groups.map(&.dup), @args.dup, @order, @limit, @offset, @includes.dup)
      end

      def where(**criteria) : Query
        query = chain
        query.__where(**criteria)
        query
      end

      protected def __where(**criteria) : Nil
        criteria.each do |key, value|
          column = {{ name }}.quote({{ name }}::TABLE) + "." + {{ name }}.quote(key.to_s)
          if value.nil?
            @groups.last << column + " IS NULL"
          elsif value.is_a?(Array)
            if value.empty?
              @groups.last << "1 = 0"
            else
              @groups.last << column + " IN (" + value.map { "?" }.join(", ") + ")"
              value.each { |item| @args << {{ name }}.bind(item) }
            end
          elsif value.is_a?(Range)
            @groups.last << column + " >= ?"
            @args << {{ name }}.bind(value.begin)
            @groups.last << column + (value.exclusive? ? " < ?" : " <= ?")
            @args << {{ name }}.bind(value.end)
          else
            @groups.last << column + " = ?"
            @args << {{ name }}.bind(value)
          end
        end
        nil
      end

      # `column IN (values)` on a column named at run time, for preloads.
      def where_in(column : String, values : Array(::Grant::Adapter::Driver::Value)) : Query
        query = chain
        query.__where_in(column, values)
        query
      end

      protected def __where_in(key : String, values : Array(::Grant::Adapter::Driver::Value)) : Nil
        column = {{ name }}.quote({{ name }}::TABLE) + "." + {{ name }}.quote(key)
        @groups.last << column + " IN (" + values.map { "?" }.join(", ") + ")"
        values.each { |value| @args << value }
        nil
      end

      def where(sql : String, *args) : Query
        query = chain
        query.__where_sql(sql, *args)
        query
      end

      protected def __where_sql(sql : String, *args) : Nil
        @groups.last << "(" + sql + ")"
        args.each { |arg| @args << {{ name }}.bind(arg) }
        nil
      end

      # Starts an OR group: `where(a: 1).or_where(b: 2)` is `a = 1 OR b = 2`.
      def or_where(**criteria) : Query
        query = chain
        query.__or_group
        query.__where(**criteria)
        query
      end

      protected def __or_group : Nil
        @groups << [] of String
        nil
      end

      def order(column : Symbol, direction : Symbol = :asc) : Query
        Query.new(@groups.map(&.dup), @args.dup, " ORDER BY " + {{ name }}.quote({{ name }}::TABLE) + "." + {{ name }}.quote(column.to_s) + (direction == :desc ? " DESC" : " ASC"), @limit, @offset, @includes.dup)
      end

      def limit(count : Int32) : Query
        Query.new(@groups.map(&.dup), @args.dup, @order, count, @offset, @includes.dup)
      end

      def offset(count : Int32) : Query
        Query.new(@groups.map(&.dup), @args.dup, @order, @limit, count, @includes.dup)
      end

      # Loads these associations for every record in one query each, so a
      # loop over the records reads them without a query per record.
      def includes(*associations : Symbol) : Query
        names = @includes.dup
        associations.each { |association| names << association.to_s }
        Query.new(@groups.map(&.dup), @args.dup, @order, @limit, @offset, names)
      end

      def where_sql : String
        groups = @groups.reject(&.empty?)
        return "" if groups.empty?
        " WHERE " + groups.map { |group| "(" + group.join(" AND ") + ")" }.join(" OR ")
      end

      def to_sql : String
        sql = {{ name }}.select_sql + where_sql + @order
        limit = @limit
        sql += " LIMIT " + limit.to_s unless limit.nil?
        offset = @offset
        sql += " OFFSET " + offset.to_s unless offset.nil?
        sql
      end

      def to_a : Tape::Array({{ name }}) | ::Grant::Error::ErrorBase
        return @preloaded if @from_preloaded
        records = {{ name }}.load_all(to_sql, @args)!
        {{ name }}.__preload(records, @includes)! unless @includes.empty?
        records
      end

      def each(&block : {{ name }} -> Nil) : Nil | ::Grant::Error::ErrorBase
        to_a!.each { |record| yield record }
        nil
      end

      def first : {{ name }} | Nil | ::Grant::Error::ErrorBase
        return @preloaded.first? if @from_preloaded
        Query.new(@groups.map(&.dup), @args.dup, @order, 1, @offset, @includes.dup).to_a!.first?
      end

      def first_strict : {{ name }} | ::Grant::Errors::RecordNotFound | ::Grant::Error::ErrorBase
        found = first!
        return ::Grant::Errors::RecordNotFound.new("Couldn't find " + {{ name.stringify }}) if found.nil?
        found
      end

      def count : Int64 | ::Grant::Error::ErrorBase
        return @preloaded.size.to_i64 if @from_preloaded
        sql = "SELECT COUNT(*) FROM " + {{ name }}.quote({{ name }}::TABLE) + where_sql
        adapter = {{ name }}.adapter
        statement = adapter.ensure_clause_template(sql)
        args = @args
        ::Grant::Query::Executor.open_statement(adapter, statement, args) do |db|
          db.query(statement, args) do |result_set|
            count = 0_i64
            result_set.each do
              read = result_set.read!
              count = read.is_a?(Int64) ? read : (read.is_a?(Int32) ? read.to_i64 : 0_i64)
              nil
            end!
            count
          end
        end
      end

      def exists? : Bool | ::Grant::Error::ErrorBase
        count! > 0
      end

      def empty? : Bool | ::Grant::Error::ErrorBase
        count! == 0
      end

      # The columns of each row on the tape, as `Grant::Query::Builder#pluck`.
      def pluck(*fields : Symbol | String) : Tape::Array(Tape::Array(::Grant::Adapter::Driver::TapeValue)) | ::Grant::Error::ErrorBase
        columns = fields.to_a.map { |field| {{ name }}.quote({{ name }}::TABLE) + "." + {{ name }}.quote(field.to_s) }
        sql = "SELECT " + columns.join(", ") + " FROM " + {{ name }}.quote({{ name }}::TABLE) + where_sql + @order
        limit = @limit
        sql += " LIMIT " + limit.to_s unless limit.nil?
        statement = {{ name }}.adapter.ensure_clause_template(sql)
        ::Grant::Query::Executor::PluckTape({{ name }}).new(statement, @args, fields.size).run
      end

      def update_all(**assignments) : Int64 | ::Grant::Error::ErrorBase
        sets = [] of String
        args = [] of ::Grant::Adapter::Driver::Value
        assignments.each do |key, value|
          sets << {{ name }}.quote(key.to_s) + " = ?"
          args << {{ name }}.bind(value)
        end
        @args.each { |arg| args << arg }
        {{ name }}.execute("UPDATE " + {{ name }}.quote({{ name }}::TABLE) + " SET " + sets.join(", ") + where_sql, args)!.changes
      end

      def delete_all : Int64 | ::Grant::Error::ErrorBase
        {{ name }}.execute("DELETE FROM " + {{ name }}.quote({{ name }}::TABLE) + where_sql, @args)!.changes
      end

      def destroy_all : Int64 | ::Grant::Error::ErrorBase
        destroyed = 0_i64
        to_a!.each do |record|
          outcome = record.destroy
          return outcome if outcome.is_a?(::Grant::Error::ErrorBase)
          destroyed += 1 if outcome
        end
        destroyed
      end

      # The records as a JSON array written onto *json*.
      def to_json(json : Tape::String::Writer) : Nil | ::Grant::Error::ErrorBase
        json << "["
        first = true
        to_a!.each do |record|
          json << "," unless first
          first = false
          record.to_json(json)
        end
        json << "]"
        nil
      end
    end
  end
end

# A timestamp off the tape without a heap String: SQLite's canonical
# `YYYY-MM-DD HH:MM:SS[.fraction][+0000|Z]`, UTC. Nil for any other form.
pub def parse_time(text : Tape::String) : Time?
  size = text.bytesize
  return nil if size < 19
  return nil unless text[4] == 45_u8 && text[7] == 45_u8 && (text[10] == 32_u8 || text[10] == 84_u8) &&
                    text[13] == 58_u8 && text[16] == 58_u8
  year = digits(text, 0, 4)
  month = digits(text, 5, 2)
  day = digits(text, 8, 2)
  hour = digits(text, 11, 2)
  minute = digits(text, 14, 2)
  second = digits(text, 17, 2)
  return nil if year.nil? || month.nil? || day.nil? || hour.nil? || minute.nil? || second.nil?
  position = 19
  nanosecond = 0
  if position < size && text[position] == 46_u8
    position += 1
    scale = 100000000
    while position < size && text[position] >= 48_u8 && text[position] <= 57_u8
      nanosecond += (text[position] - 48_u8).to_i32 * scale
      scale = scale // 10
      position += 1
    end
  end
  rest = size - position
  return nil unless rest == 0 || (rest == 1 && text[position] == 90_u8) ||
                    (rest == 5 && text[position] == 43_u8 && digits(text, position + 1, 4) == 0) ||
                    (rest == 6 && text[position] == 43_u8 && digits(text, position + 1, 2) == 0 && digits(text, position + 4, 2) == 0)
  Time.utc(year, month, day, hour, minute, second, nanosecond: nanosecond)
end

private def digits(text : Tape::String, start : Int32, count : Int32) : Int32?
  value = 0
  count.times do |offset|
    byte = text[start + offset]
    return nil unless byte >= 48_u8 && byte <= 57_u8
    value = value * 10 + (byte - 48_u8).to_i32
  end
  value
end

# A timestamp in any form the adapter reads, nil when it reads none.
pub def read_time(adapter : ::Grant::Adapter::Base::Base, text : String) : Time?
  parsed = adapter.read_time(text)
  parsed.is_a?(Time) ? parsed : nil
end

private def hex_digit(nibble : UInt8) : UInt8
  nibble < 10_u8 ? 48_u8 + nibble : 87_u8 + nibble
end

# JSON values written onto a tape writer: text escaped byte by byte.
pub def write_json(json : Tape::String::Writer, value : Tape::String) : Nil
  json.push(34_u8)
  value.each_byte do |byte|
    case byte
    when 34_u8 then json << "\\\""
    when 92_u8 then json << "\\\\"
    when 10_u8 then json << "\\n"
    when 13_u8 then json << "\\r"
    when 9_u8 then json << "\\t"
    else
      if byte < 32_u8
        json << "\\u00"
        json.push(hex_digit(byte >> 4))
        json.push(hex_digit(byte & 15_u8))
      else
        json.push(byte)
      end
    end
  end
  json.push(34_u8)
  nil
end

pub def write_json(json : Tape::String::Writer, value : Nil) : Nil
  json << "null"
  nil
end

pub def write_json(json : Tape::String::Writer, value : Bool | Int32 | Int64) : Nil
  json << value.to_s
  nil
end

pub def write_json(json : Tape::String::Writer, value : Float64) : Nil
  json.append_float(value)
  nil
end

pub def write_json(json : Tape::String::Writer, value : Time) : Nil
  json.push(34_u8)
  json << value.to_rfc3339(6)
  json.push(34_u8)
  nil
end

pub def write_json(json : Tape::String::Writer, value : UUID) : Nil
  json.push(34_u8)
  json << value.to_s
  json.push(34_u8)
  nil
end
