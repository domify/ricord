module grant/query/where_composition

import std/tuple
import grant/adapter/driver::{Value}
import grant/error::{ErrorBase, ArgumentError}
import grant/query/predicate_renderer::{PredicateRenderer}
import grant/query/bind_value::{to_value}
import grant/sanitization

# Value-shaped conditions and grouped negation, as in upstream
# src/grant/query/where_composition.cr.
pub trait WhereComposition(Model)
  def or_where(matches : Hash(K, V)) : self forall K, V
    copy = chain_copy
    matches.each { |field, value| copy.add_condition(:or, field.to_s, value) }
    copy
  end

  def excluding_in_place(*records : Model) : self
    excluding_in_place(records.to_a)
  end

  def excluding_in_place(records : Array(Model)) : self
    return self if records.empty?
    ids = records.map(&.__primary_value).reject(&.nil?)
    and_in_in_place(Model.primary_name, ids, negated: true) unless ids.empty?
    self
  end

  def excluding(*records : Model) : self
    chain_copy.excluding_in_place(records.to_a)
  end

  def excluding(records : Array(Model)) : self
    chain_copy.excluding_in_place(records)
  end

  def without_in_place(*records : Model) : self
    excluding_in_place(records.to_a)
  end

  def without_in_place(records : Array(Model)) : self
    excluding_in_place(records)
  end

  def without(*records : Model) : self
    chain_copy.excluding_in_place(records.to_a)
  end

  def without(records : Array(Model)) : self
    chain_copy.excluding_in_place(records)
  end

  def invert_where : self
    chain_copy.invert_where_in_place
  end

  def invert_where_in_place : self
    return self if where_fields.empty?
    values = [] of Value
    renderer = PredicateRenderer.new(
      Model.to_s, Model.table_name, Model.fields,
      ->(name : String) { Model.quote(name) },
      ->(value : Value) { values << value; "?" },
      ->(name : String) { nil }, join_clauses)
    renderer.rendering_where_group = true
    sql = renderer.render_where_fields(where_fields)
    return self.defer(sql) if sql.is_a?(ErrorBase)
    clear_where_fields
    own_where_fields << {join: :and, stmt: "NOT (#{sql})", values: values}
    self
  end

  protected def add_nested_where_condition(join : Symbol, name : String, matches : T) : self forall T
    {% if Model.class.has_method?(:__query_nested_table) %}
      table = Model.__query_nested_table(name)
      fields = Model.__query_nested_fields(name)
      return self.defer(ArgumentError.new("Unknown table #{name.inspect}")) if table.nil? || fields.nil?
      matches.each do |column, value|
        field = "#{table}.#{column}"
        unless fields.includes?(column.to_s)
          return self.defer(ArgumentError.new("Unknown query field #{field.inspect} for #{Model}"))
        end
        add_condition(join, "#{table}.#{column}", value)
      end
      self
    {% else %}
      self.defer(ArgumentError.new("Unknown table #{name.inspect}"))
    {% end %}
  end

  protected def add_polymorphic_condition(join : Symbol, field : String, type_column : String, value : T) : self forall T
    entries = association_key_entries(value)
    if entries.empty?
      own_where_fields << {join: join, stmt: "1=0", value: nil.as(Value)}
      return self
    end
    key_sql = "#{Model.quote(Model.table_name)}.#{Model.quote(field)}"
    type_sql = "#{Model.quote(Model.table_name)}.#{Model.quote(type_column)}"
    parts = [] of String
    values = [] of Value
    by_type = {} of String => Array(Value)
    null_key = false
    entries.each do |entry|
      key, type_name = entry
      if type_name
        by_type[type_name] = [] of Value unless by_type.has_key?(type_name)
        by_type[type_name] << key
      elsif key.nil?
        null_key = true
      else
        return self.defer(ArgumentError.new("#{Model} association is polymorphic; pass records so the type column can be matched"))
      end
    end
    by_type.each do |name, keys|
      predicate = keys.size == 1 ? "#{key_sql} = ?" : "#{key_sql} IN (#{Array.new(keys.size, "?").join(", ")})"
      parts << "(#{predicate} AND #{type_sql} = ?)"
      values.concat(keys)
      values << name
    end
    parts << "#{key_sql} IS NULL" if null_key
    statement = "(#{parts.join(" OR ")})"
    own_where_fields << {join: join, stmt: statement, values: values}
    register_raw_where_column(statement, field)
    self
  end

  private def association_key_entries(value : T) : Array(Tuple(Value, String?)) forall T
    entries = [] of Tuple(Value, String?)
    if value.is_a?(Array)
      value.each { |item| entries.concat(association_key_entries(item)) }
    elsif value.responds_to?(:__primary_value)
      entries << {value.__primary_value, value.class.to_s.as(String?)}
    else
      entries << {to_value(value), nil.as(String?)}
    end
    entries
  end

  private def association_type_column(name : String) : String?
    {% if Model.class.has_method?(:__query_association_type_column) %}
      Model.__query_association_type_column(name)
    {% else %}
      nil
    {% end %}
  end

  protected def register_raw_where_column(statement : String, field : String, equality : Bool = false) : Nil
    raw_where_columns[statement] = {field.split('.').last, equality}
    nil
  end

  private def association_foreign_key(name : String) : String?
    {% if Model.class.has_method?(:__query_association_foreign_key) %}
      Model.__query_association_foreign_key(name)
    {% else %}
      nil
    {% end %}
  end

  def unscope(*, where columns : T) : self forall T
    copy = chain_copy
    names = columns.is_a?(Array) ? columns.map { |column| column.to_s } : [columns.to_s]
    names = names.map { |name| association_foreign_key(name) || name }
    copy.record_unscoped_columns(names)
    copy.unscope_where_columns(names)
    copy
  end

  def unscope(*components : Symbol, where columns : T) : self forall T
    copy = unscope(*components)
    names = columns.is_a?(Array) ? columns.map { |column| column.to_s } : [columns.to_s]
    names = names.map { |name| association_foreign_key(name) || name }
    copy.record_unscoped_columns(names)
    copy.unscope_where_columns(names)
    copy
  end

  def rewhere(matches : T) : self forall T
    copy = chain_copy
    names = [] of String
    matches.each { |field, _| names << (association_foreign_key(field.to_s) || field.to_s) }
    copy.unscope_where_columns(names)
    matches.each { |field, value| copy.add_condition(:and, field.to_s, value) }
    copy
  end

  def reorder(first : Symbol, second : Symbol, *rest) : self
    copy = chain_copy
    return chain_copy.reorder_in_place(first, second) if rest.empty? && (second == :asc || second == :desc)
    copy.reordering = true
    copy.clear_order_fields
    copy.order_in_place(first)
    copy.order_in_place(second)
    rest.each { |field| copy.order_in_place(field) }
    copy
  end

  def where(statement : String, **binds) : self
    copy = chain_copy
    rewritten = ::Grant::Sanitization.rewrite_named_binds(statement, binds)
    if rewritten.is_a?(ErrorBase)
      copy.deferred_error = rewritten
      return copy
    end
    sql, values = rewritten
    copy.and_in_place(sql, values)
  end

  def or_where(other : self) : self
    chain_copy.or_in_place(other)
  end

  def or_in_place(other : self) : self
    error = structurally_compatible_error(other, "or")
    return self.defer(error) unless error.nil?
    if where_fields.empty? || other.where_fields.empty?
      clear_where_fields
      return self
    end
    values = [] of Value
    renderer = PredicateRenderer.new(
      Model.to_s, Model.table_name, Model.fields,
      ->(name : String) { Model.quote(name) },
      ->(value : Value) { values << value; "?" },
      ->(name : String) { nil }, join_clauses)
    renderer.rendering_where_group = true
    left = renderer.render_where_fields(where_fields)
    return self.defer(left) if left.is_a?(ErrorBase)
    right = renderer.render_where_fields(other.where_fields)
    return self.defer(right) if right.is_a?(ErrorBase)
    clear_where_fields
    own_where_fields << {join: :and, stmt: "((#{left}) OR (#{right}))", values: values}
    self
  end

  def and_where(other : self) : self
    chain_copy.and_in_place(other)
  end

  def and_in_place(other : self) : self
    error = structurally_compatible_error(other, "and")
    return self.defer(error) unless error.nil?
    return self if other.where_fields.empty?
    if other.where_fields.all? { |field| field[:join] == :and } && where_fields.all? { |field| field[:join] == :and }
      own_where_fields.concat(other.where_fields)
      other.raw_where_columns.each { |sql, metadata| raw_where_columns[sql] = metadata }
      return self
    end
    values = [] of Value
    renderer = PredicateRenderer.new(
      Model.to_s, Model.table_name, Model.fields,
      ->(name : String) { Model.quote(name) },
      ->(value : Value) { values << value; "?" },
      ->(name : String) { nil }, join_clauses)
    renderer.rendering_where_group = true
    left = renderer.render_where_fields(where_fields)
    return self.defer(left) if left.is_a?(ErrorBase)
    right = renderer.render_where_fields(other.where_fields)
    return self.defer(right) if right.is_a?(ErrorBase)
    clear_where_fields
    own_where_fields << {join: :and, stmt: "((#{left}) AND (#{right}))", values: values}
    self
  end

  protected def structurally_incompatible_values(other : self) : Array(Symbol)
    differing = [] of Symbol
    # Native NamedTuple equality is false even for identical tuples.
    differing << :order if order_fields.map(&.to_s) != other.order_fields.map(&.to_s)
    differing << :group if group_fields.map(&.to_s) != other.group_fields.map(&.to_s)
    differing << :joins if join_clauses.map(&.to_s) != other.join_clauses.map(&.to_s)
    differing << :limit if limit != other.limit
    differing << :offset if offset != other.offset
    differing << :lock if lock_mode != other.lock_mode || lock_clause != other.lock_clause
    differing << :select if select_columns != other.select_columns
    differing << :distinct if distinct? != other.distinct?
    differing << :includes if includes_associations != other.includes_associations
    differing
  end

  private def structurally_compatible_error(other : self, method_name : String) : ArgumentError?
    differing = structurally_incompatible_values(other)
    return nil if differing.empty?
    ArgumentError.new("Relation passed to ##{method_name} must be structurally compatible. Incompatible values: [#{differing.map { |value| ":#{value}" }.join(", ")}]")
  end

  def where_not(matches : T) : self forall T
    chain_copy.where_not_in_place(matches)
  end

  def where_not_in_place(matches : T) : self forall T
    scope = chain_copy
    scope.clear_where_fields
    scope.clear_default_scope_where_fields
    matches.each { |field, value| scope.add_condition(:and, field.to_s, value) }
    failure = scope.deferred_error
    return self.defer(failure) unless failure.nil?
    return self if scope.where_fields.empty?
    values = [] of Value
    renderer = PredicateRenderer.new(
      Model.to_s, Model.table_name, Model.fields,
      ->(name : String) { Model.quote(name) },
      ->(value : Value) { values << value; "?" },
      ->(name : String) { nil }, scope.join_clauses)
    renderer.rendering_where_group = true
    rendered = renderer.render_where_fields(scope.where_fields)
    if rendered.is_a?(ErrorBase)
      self.defer(rendered)
    else
      own_where_fields << {join: :and, stmt: "NOT (#{rendered})", values: values}
    end
    self
  end

  protected def add_range_condition(join : Symbol, field : String, value : T) : self forall T
    safe_field = structured_field_sql(field)
    return self if safe_field.nil?
    parts = [] of String
    values = [] of Value
    first = value.begin
    last = value.end
    unless first.nil?
      parts << "#{safe_field} >= ?"
      values << to_value(first)
    end
    unless last.nil?
      parts << "#{safe_field} #{value.exclusive? ? "<" : "<="} ?"
      values << to_value(last)
    end
    return self if parts.empty?
    statement = "(#{parts.join(" AND ")})"
    own_where_fields << {join: join, stmt: statement, values: values}
    register_raw_where_column(statement, field)
    self
  end

  protected def add_value_array_condition(join : Symbol, field : String, items : Array(T)) : self forall T
    scope = chain_copy
    scope.clear_where_fields
    scope.clear_default_scope_where_fields
    scalars = [] of Value
    items.each do |item|
      if item.is_a?(Range)
        scope.add_range_condition(:or, field, item)
      else
        scalars << (item.responds_to?(:__primary_value) ? item.__primary_value : to_value(item))
      end
    end
    # Preserve the ordinary IN/list path, including its nil-aware predicate.
    return add_array_condition(join, field, :in, scalars) if scope.where_fields.empty?
    scope.or_in_in_place(field, scalars) unless scalars.empty?
    values = [] of Value
    renderer = PredicateRenderer.new(
      Model.to_s, Model.table_name, Model.fields,
      ->(name : String) { Model.quote(name) },
      ->(value : Value) { values << value; "?" },
      ->(name : String) { nil }, scope.join_clauses)
    renderer.rendering_where_group = true
    rendered = renderer.render_where_fields(scope.where_fields)
    if rendered.is_a?(ErrorBase)
      self.defer(rendered)
    else
      statement = "(#{rendered})"
      own_where_fields << {join: join, stmt: statement, values: values}
      register_raw_where_column(statement, field)
    end
    self
  end
end

pub macro model_methods(model)
  {% for name in ["excluding", "without"] %}
    def self.{{ name.id }}(*records : {{ model }}) : ::Grant::Query::Builder::Builder({{ model }})
      current_scope.{{ name.id }}(*records)
    end

    def self.{{ name.id }}(records : Array({{ model }})) : ::Grant::Query::Builder::Builder({{ model }})
      current_scope.{{ name.id }}(records)
    end
  {% end %}

  def self.unscope(*, where columns : T) : ::Grant::Query::Builder::Builder({{ model }}) forall T
    current_scope.unscope(where: columns)
  end

  def self.unscope(*components : Symbol) : ::Grant::Query::Builder::Builder({{ model }})
    current_scope.unscope(*components)
  end

  def self.unscope(*components : Symbol, where columns : T) : ::Grant::Query::Builder::Builder({{ model }}) forall T
    current_scope.unscope(*components, where: columns)
  end

  def self.__query_nested_table(name : String) : String?
    if name == table_name
      return table_name
    end
    \{% for method in @type.methods %}
      \{% if ann = method.annotation(::Grant::Associations::Relationship) %}
        if name == \{{ method.name.stringify }} || name == \{{ ann[:target] }}.table_name
          return \{{ ann[:target] }}.table_name
        end
      \{% end %}
    \{% end %}
    nil
  end

  def self.__query_nested_fields(name : String) : Array(String)?
    if name == table_name
      return fields
    end
    \{% for method in @type.methods %}
      \{% if ann = method.annotation(::Grant::Associations::Relationship) %}
        if name == \{{ method.name.stringify }} || name == \{{ ann[:target] }}.table_name
          return \{{ ann[:target] }}.fields
        end
      \{% end %}
    \{% end %}
    nil
  end

  def self.__query_association_type_column(name : String) : String?
    \{% for method in @type.methods %}
      \{% if ann = method.annotation(::Grant::Associations::Relationship) %}
        \{% if ann[:polymorphic] && ann[:type] == :belongs_to %}
          return \{{ ann[:type_column] }} if name == \{{ method.name.stringify }}
        \{% end %}
      \{% end %}
    \{% end %}
    nil
  end

  def self.__query_association_foreign_key(name : String) : String?
    \{% for method in @type.methods %}
      \{% if ann = method.annotation(::Grant::Associations::Relationship) %}
        \{% if ann[:type] == :belongs_to %}
          return \{{ ann[:foreign_key].id.stringify }} if name == \{{ method.name.stringify }}
        \{% end %}
      \{% end %}
    \{% end %}
    nil
  end

  def self.where(statement : String, **binds) : ::Grant::Query::Builder::Builder({{ model }})
    current_scope.where(statement, **binds)
  end

  def self.select(*columns : Symbol | String) : ::Grant::Query::Builder::Builder({{ model }})
    current_scope.select(*columns)
  end
end
