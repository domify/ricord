# `model Court do ... end`: a record type over a session's store, its query type,
# and its table's DDL (doc/DESIGN.md, M1 item 8). Column 0 is always `id`.
#
#     model Court do
#       table :courts
#       col :name, :string
#       col :rank, :integer, null: true
#     end
module ricord/model

import std/int
import std/tuple
import std/named_tuple
import std/time::{Time}
import db/db/core::{ResultSet}
import db/db/errors::{DBError}
import db/db/value::{DBValue}
import ricord/values::{Value, Skip, SKIP, TextSpan, ByteSpan}
import std/slice::{Bytes}
import ricord/storage::{Store, FLAG_PERSISTED, FLAG_DESTROYED}
import ricord/dialects::{Dialect, ColumnOptions}
import ricord/failures::{RecordNotFound, DatabaseError, Failure}
import ricord/sessions::{Session, Tx, Db}
pub import ricord/associations

# Appends the value of a store slot to *args* as a bind argument. A BLOB slot
# binds as Bytes copied out of the store.
pub def push_db(args : Array(DBValue), value : Value, store : Store, dialect : Dialect) : Nil
  case value
  when TextSpan then args << store.span_text(value)
  when Time     then args << store.view_text(dialect.write_time(value))
  when ByteSpan then args << store.blob_hex(value)
  when Bool     then args << value
  when Int64    then args << value
  when Float64  then args << value
  else               args << nil
  end
  nil
end

# Marks a column name in a typed condition's text: replaced by the table
# qualifier (`` `courts`. ``) when the query joins, by nothing otherwise.
pub QUALIFY = '\u0001'

# Appends *text* with every `QUALIFY` mark replaced by *prefix*.
pub def qualified(text : String, prefix : String, sql : String::Builder) : Nil
  text.each_char do |ch|
    if ch == QUALIFY
      sql << prefix
    else
      sql << ch
    end
  end
  nil
end

# The WHERE text and binds of a node chain ending at *last*, appended.
pub def where_sql(store : Store, last : Int32, sql : String::Builder, binds : Array(DBValue), dialect : Dialect, prefix : String = "") : Nil
  return nil if last < 0
  chain = [] of Int32
  at = last
  while at >= 0
    chain << at
    at = store.wheres[at].prev
  end
  ordered = chain.reverse
  sql << " WHERE "
  ordered.each_with_index { |node_index, i| sql << '(' if i > 0 && store.wheres[node_index].op == 1_u8 }
  ordered.each_with_index do |node_index, i|
    node = store.wheres[node_index]
    if i == 0
      sql << '('
    elsif node.op == 1_u8
      sql << ") OR ("
    else
      sql << " AND ("
    end
    qualified(store.span_text(node.sql), prefix, sql)
    sql << ')'
    node.bind_count.times { |b| push_db(binds, store.binds[node.bind_start + b], store, dialect) }
  end
  nil
end

# The WHERE text of a node chain plus the inherited scope starting at *scope*
# (-1 for none): `WHERE (<chain>) AND (`c` = ?) ...`. *prefix* qualifies the
# columns (a query with joins); *extra* is one more condition (a keyset) with
# its binds.
pub def scoped_where_sql(store : Store, last : Int32, scope : Int32, columns : Array(String), sql : String::Builder, binds : Array(DBValue), dialect : Dialect, prefix : String = "", extra : String = "", extra_binds : Array(DBValue) | Nil = nil) : Nil
  has_scope = scope >= 0 && store.scope_cols[scope] >= 0
  if !has_scope && extra.empty?
    where_sql(store, last, sql, binds, dialect, prefix)
    return nil
  end
  if last >= 0
    inner = String::Builder.new
    where_sql(store, last, inner, binds, dialect, prefix)
    text = inner.to_s
    sql << " WHERE (" << text[7, text.bytesize - 7] << ")"
  else
    sql << " WHERE "
  end
  first = last < 0
  if has_scope
    at = scope
    while store.scope_cols[at] >= 0
      sql << " AND " unless first
      first = false
      value = store.scope_vals[at]
      if value.nil?
        sql << '(' << prefix << '`' << columns[store.scope_cols[at]] << "` IS NULL)"
      else
        sql << '(' << prefix << '`' << columns[store.scope_cols[at]] << "` = ?)"
        push_db(binds, value, store, dialect)
      end
      at += 1
    end
  end
  unless extra.empty?
    sql << " AND " unless first
    sql << '(' << extra << ')'
    extra_binds.each { |b| binds << b } if extra_binds
  end
  nil
end

# The INNER JOIN texts of a join chain ending at *last* (nodes as in `wheres`,
# their binds the joined tables' scope values), appended in order.
pub def join_sql(store : Store, last : Int32, sql : String::Builder, binds : Array(DBValue), dialect : Dialect) : Nil
  return nil if last < 0
  chain = [] of Int32
  at = last
  while at >= 0
    chain << at
    at = store.wheres[at].prev
  end
  chain.reverse.each do |node_index|
    node = store.wheres[node_index]
    sql << store.span_text(node.sql)
    node.bind_count.times { |b| push_db(binds, store.binds[node.bind_start + b], store, dialect) }
  end
  nil
end

# The keyset condition after the last row of a batch: for order columns
# c0, c1, ... (*desc* per column) and the last row's *keys*,
# `(c0 > ?) OR (c0 = ? AND c1 > ?) OR ...` (`<` for a descending column).
pub def keyset_sql(prefix : String, columns : Array(String), cols : Array(Int32), desc : Array(Bool), keys : Array(Value), kstore : Store, sql : String::Builder, binds : Array(DBValue), dialect : Dialect) : Nil
  cols.size.times do |i|
    sql << " OR " if i > 0
    sql << '('
    i.times do |j|
      sql << prefix << '`' << columns[cols[j]] << "` = ? AND "
      push_db(binds, keys[j], kstore, dialect)
    end
    sql << prefix << '`' << columns[cols[i]] << (desc[i] ? "` < ?" : "` > ?") << ')'
    push_db(binds, keys[i], kstore, dialect)
  end
  nil
end

# Copies the slot values of record *index* at *cols* into *keys*, text into
# *kstore* (the batch store holding them goes away with its batch).
pub def copy_keys(batch : Store, index : Int32, cols : Array(Int32), keys : Array(Value), kstore : Store) : Nil
  keys.clear
  cols.each do |col|
    v = batch.slot(index, col)
    case v
    when TextSpan then keys << kstore.add_text(batch.span_text(v))
    when Int64    then keys << v + 0_i64
    when Float64  then keys << v + 0.0
    when Bool     then keys << (v == true)
    when Time     then keys << v.to_utc
    else               keys << nil
    end
  end
  nil
end

# Copies the scope pairs starting at *scope* in *from* into *to*: the new
# scope's start there, -1 for none.
pub def copy_scope(from : Store, to : Store, scope : Int32) : Int32
  return -1 if scope < 0
  start = to.scope_cols.size
  at = scope
  while from.scope_cols[at] >= 0
    v = from.scope_vals[at]
    to.add_scope_pair(from.scope_cols[at], v.is_a?(TextSpan) ? to.add_text(from.span_text(v)) : v)
    at += 1
  end
  to.end_scope
  start
end

# Appends *text* as a JSON string.
pub def json_string(text : String, into : String::Builder) : Nil
  into << '"'
  text.each_char do |ch|
    case ch
    when '"'  then into << "\\\""
    when '\\' then into << "\\\\"
    when '\n' then into << "\\n"
    when '\r' then into << "\\r"
    when '\t' then into << "\\t"
    else
      if ch.ord < 0x20
        into << "\\u00" << "0123456789abcdef"[ch.ord >> 4, 1] << "0123456789abcdef"[ch.ord & 0xF, 1]
      else
        into << ch
      end
    end
  end
  into << '"'
  nil
end

# A plucked value: the column's getter type (text as a view of the session's
# store; JSON and BLOB columns as their text).
pub alias Plucked = String | Int64 | Float64 | Bool | Time | Nil

# Slot *slot* of record *index* as a plucked value (text as a store view).
pub def plucked(store : Store, index : Int32, slot : Int32) : Plucked
  v = store.slot(index, slot)
  case v
  when TextSpan then store.span_text(v)
  when ByteSpan then nil
  else               v
  end
end

# Starts a scope for a has_many query: (fk, owner id), then the owner's own
# pairs mapped into the target by *map* (source column index => target column
# index or -1), leaving out the fk. The new scope's start.
pub def child_scope(store : Store, owner : Int32, fk : Int32, map : Array(Int32)) : Int32
  start = store.scope_cols.size
  store.add_scope_pair(fk, store.slot(owner, 0))
  at = store.scopes[owner]
  if at >= 0
    while store.scope_cols[at] >= 0
      target = map[store.scope_cols[at]]
      store.add_scope_pair(target, store.scope_vals[at]) if target >= 0 && target != fk
      at += 1
    end
  end
  store.end_scope
  start
end

# Sets each scope column of record *index* to its pair's value.
pub def apply_scope(store : Store, index : Int32, scope : Int32) : Nil
  return nil if scope < 0
  at = scope
  while store.scope_cols[at] >= 0
    store.set_slot(index, store.scope_cols[at], store.scope_vals[at])
    at += 1
  end
  nil
end

# The first scope column of record *index* whose value differs from its
# pair's, or -1.
pub def scope_violation(store : Store, index : Int32) : Int32
  at = store.scopes[index]
  return -1 if at < 0
  while store.scope_cols[at] >= 0
    col = store.scope_cols[at]
    current = store.slot(index, col)
    wanted = store.scope_vals[at]
    same = current.is_a?(TextSpan) && wanted.is_a?(TextSpan) ? store.span_text(current) == store.span_text(wanted) : current == wanted
    return col if store.changed?(index, col) && !same
    at += 1
  end
  -1
end

# The next row, or the database's refusal as a `DatabaseError` (a constraint
# failing on a `RETURNING` insert shows up here).
pub def advance(rs : ResultSet, table : String) : Bool | DatabaseError
  moved = rs.move_next
  moved.is_a?(::Db::Errors::DBError) ? DatabaseError.from(moved, table, "query") : moved
end

# The ORDER BY text of an order chain ending at *last*.
# With *flip* every direction is reversed (for `last`).
pub def order_sql(store : Store, last : Int32, columns : Array(String), sql : String::Builder, flip : Bool = false, prefix : String = "") : Nil
  return nil if last < 0
  chain = [] of Int32
  at = last
  while at >= 0
    chain << at
    at = store.orders[at].prev
  end
  sql << " ORDER BY "
  chain.reverse.each_with_index do |node_index, i|
    node = store.orders[node_index]
    sql << ", " if i > 0
    sql << prefix << '`' << columns[node.column] << '`'
    sql << " DESC" if node.desc != flip
  end
  nil
end

# A store value for a `where` argument: text goes into the store.
pub def bind_value(store : Store, value : T) : Value forall T
  case value
  when String then store.add_text(value)
  when Int32  then value.to_i64
  else             value
  end
end

# Appends a node for the conditions in *conds* (a NamedTuple of column => value,
# `SKIP` for not given) and returns it, or *last* when none was given.
pub def where_conds(store : Store, op : UInt8, last : Int32, conds : T) : Int32 forall T
  text = String::Builder.new
  start = store.binds.size
  count = 0
  conds.each do |key, value|
    next if value.is_a?(Skip)
    next if value.is_a?(Range) && value.begin.nil? && value.end.nil?
    text << " AND " unless text.bytesize == 0
    column = "#{QUALIFY}`#{key}`"
    if value.nil?
      text << column << " IS NULL"
    elsif value.is_a?(Array)
      if value.empty?
        text << "1=0"
      else
        text << column << " IN ("
        value.each_with_index do |item, k|
          text << (k > 0 ? ", ?" : "?")
          store.add_bind(bind_value(store, item))
          count += 1
        end
        text << ')'
      end
    elsif value.is_a?(Range)
      low = value.begin
      high = value.end
      if low.nil?
        text << column << (value.exclusive? ? " < ?" : " <= ?")
        store.add_bind(bind_value(store, high))
        count += 1
      elsif high.nil?
        text << column << " >= ?"
        store.add_bind(bind_value(store, low))
        count += 1
      else
        text << column << " >= ? AND " << column << (value.exclusive? ? " < ?" : " <= ?")
        store.add_bind(bind_value(store, low))
        store.add_bind(bind_value(store, high))
        count += 2
      end
    else
      text << column << " = ?"
      store.add_bind(bind_value(store, value))
      count += 1
    end
  end
  return last if text.bytesize == 0
  store.add_where(last, op, text.to_s, start, count)
end

# Appends a raw condition with its binds and returns its node.
pub def where_raw(store : Store, last : Int32, sql : String, binds : T) : Int32 forall T
  start = store.binds.size
  binds.each { |b| store.add_bind(bind_value(store, b)) }
  store.add_where(last, 0_u8, sql, start, binds.size)
end

# Appends ascending order nodes for *cols* (Symbols) and returns the last.
pub def order_cols(store : Store, last : Int32, columns : Array(String), cols : T) : Int32 forall T
  cols.each { |c| last = store.add_order(last, column_of(columns, c.to_s), false) }
  last
end

# Appends order nodes for a NamedTuple of column => :asc / :desc.
pub def order_dirs(store : Store, last : Int32, columns : Array(String), cols : T) : Int32 forall T
  cols.each { |c, dir| last = store.add_order(last, column_of(columns, c.to_s), dir == :desc) }
  last
end

# Whether a text slot already holds *value* (nil for a NULL slot).
pub def same_text?(store : Store, current : Value, value : String | Nil) : Bool
  return current.nil? if value.nil?
  current.is_a?(TextSpan) && store.span_text(current) == value
end

private def column_of(columns : Array(String), name : String) : Int32
  columns.each_with_index { |c, i| return i if c == name }
  0
end

pub macro model(name, &block)
  {% declarations = block.body.is_a?(Expressions) ? block.body.expressions : [block.body] %}
  {% exprs = [] of ASTNode %}
  {% for declaration in declarations %}
    {% node = declaration.is_a?(Assign) ? declaration.value : declaration %}
    {% if node.is_a?(Expressions) %}
      {% for inner in node.expressions %}
        {% exprs << (inner.is_a?(Assign) ? inner.value : inner) %}
      {% end %}
    {% else %}
      {% exprs << node %}
    {% end %}
  {% end %}
  {% table = name.stringify.underscore + "s" %}
  {% cols = [] of ASTNode %}
  {% defs = [] of ASTNode %}
  {% indexes = [] of ASTNode %}
  {% checks = [] of ASTNode %}
  {% validations = [] of ASTNode %}
  {% custom_validations = [] of ASTNode %}
  {% json_fields = [] of ASTNode %}
  {% expand_timestamps = false %}
  {% stamps = false %}
  {% commits = [] of ASTNode %}
  {% rollbacks = [] of ASTNode %}
  {% assocs = [] of ASTNode %}
  {% expand_refs = false %}
  {% callbacks = {"before_validation" => [] of ASTNode, "after_validation" => [] of ASTNode, "before_save" => [] of ASTNode, "after_save" => [] of ASTNode, "before_create" => [] of ASTNode, "after_create" => [] of ASTNode, "before_update" => [] of ASTNode, "after_update" => [] of ASTNode, "before_destroy" => [] of ASTNode, "after_destroy" => [] of ASTNode} %}
  {% for e in exprs %}
    {% if e.is_a?(Call) && e.name == "table" %}
      {% arg = e.args[0] %}
      {% table = arg.is_a?(StringLiteral) ? arg : (arg.is_a?(SymbolLiteral) ? arg.id.stringify : (arg.is_a?(Call) && arg.name == "view" ? arg.args[0] : arg.stringify)) %}
    {% elsif e.is_a?(Call) && e.name == "col" %}
      {% bt = e.named_args && e.named_args.find { |na| na.name.stringify == "belongs_to" } %}
      {% if bt %}
        {% if e.args.size == 1 %}{% expand_refs = true %}{% end %}
        {% bcn = e.named_args.find { |na| na.name.stringify == "class_name" } %}
        {% assocs << ["belongs_to", bt.value.id, (bcn ? bcn.value.id : bt.value.id.stringify.camelcase.id), e.args[0].id, cols.size + 1, ""] %}
      {% end %}
      {% cols << e %}
    {% elsif e.is_a?(Call) && (e.name == "has_many" || e.name == "has_one") %}
      {% an = e.args[0].id.stringify %}
      {% acn = e.named_args && e.named_args.find { |na| na.name.stringify == "class_name" } %}
      {% afk = e.named_args && e.named_args.find { |na| na.name.stringify == "foreign_key" } %}
      {% if e.named_args %}
        {% for na in e.named_args %}
          {% unless ["class_name", "foreign_key", "dependent"].includes?(na.name.stringify) %}
            {% raise "model #{name}: #{e.name} #{an} has unknown option #{na.name}" %}
          {% end %}
        {% end %}
      {% end %}
      {% adep = e.named_args && e.named_args.find { |na| na.name.stringify == "dependent" } %}
      {% if adep && !["destroy", "delete_all", "nullify", "restrict"].includes?(adep.value.id.stringify) %}
        {% raise "model #{name}: #{e.name} #{an} dependent: takes :destroy, :delete_all, :nullify or :restrict, not #{adep.value}" %}
      {% end %}
      {% single = e.name == "has_many" ? (an.ends_with?("ies") ? an[0..-4] + "y" : (an.ends_with?("s") ? an[0..-2] : an)) : an %}
      {% assocs << [e.name.stringify, an.id, (acn ? acn.value.id : single.camelcase.id), (afk ? afk.value.id : (name.stringify.underscore + "_id").id), -1, (adep ? adep.value.id.stringify : "")] %}
    {% elsif e.is_a?(Call) && e.name == "cols" %}
      {% unless e.args.size == 1 && e.args[0].is_a?(SymbolLiteral) && e.args[0].id == "timestamps" %}
        {% raise "model #{name}: cols takes :timestamps" %}
      {% end %}
      {% expand_timestamps = true %}
    {% elsif e.is_a?(Call) && e.name == "__timestamps" %}
      {% stamps = true %}
    {% elsif e.is_a?(Call) && e.name == "json_field" %}
      {% json_fields << e %}
    {% elsif e.is_a?(Call) && e.name == "index" %}
      {% indexes << e %}
    {% elsif e.is_a?(Call) && e.name == "check_constraint" %}
      {% checks << e %}
    {% elsif e.is_a?(Call) && e.name == "validates" %}
      {% validations << e %}
    {% elsif e.is_a?(Call) && e.name == "validate" %}
      {% custom_validations << e.args[0] %}
    {% elsif e.is_a?(Call) && ["after_commit", "after_create_commit", "after_update_commit", "after_save_commit", "after_destroy_commit"].includes?(e.name.stringify) %}
      {% cn = e.name.stringify %}
      {% on = cn == "after_create_commit" ? ["create"] : (cn == "after_update_commit" ? ["update"] : (cn == "after_save_commit" ? ["create", "update"] : (cn == "after_destroy_commit" ? ["destroy"] : ["create", "update", "destroy"]))) %}
      {% if e.named_args %}
        {% for na in e.named_args %}
          {% unless cn == "after_commit" && na.name.stringify == "on" %}
            {% raise "model #{name}: #{cn} has unknown option #{na.name}" %}
          {% end %}
          {% on = na.value.is_a?(ArrayLiteral) ? na.value.map { |v| v.id.stringify } : [na.value.id.stringify] %}
          {% for o in on %}
            {% unless ["create", "update", "destroy"].includes?(o) %}
              {% raise "model #{name}: after_commit on: takes :create, :update or :destroy, not #{o}" %}
            {% end %}
          {% end %}
        {% end %}
      {% end %}
      {% for a in e.args %}{% commits << [a, on.includes?("create"), on.includes?("update"), on.includes?("destroy")] %}{% end %}
    {% elsif e.is_a?(Call) && e.name == "after_rollback" %}
      {% if e.named_args %}
        {% raise "model #{name}: after_rollback takes no options" %}
      {% end %}
      {% for a in e.args %}{% rollbacks << a %}{% end %}
    {% elsif e.is_a?(Call) && callbacks[e.name.stringify] %}
      {% for a in e.args %}{% callbacks[e.name.stringify] << a %}{% end %}
    {% elsif e.is_a?(Def) %}
      {% defs << e %}
    {% elsif e.stringify.starts_with?("__") || e.stringify.starts_with?("::__") || e.is_a?(Nop) || e.is_a?(BoolLiteral) %}
    {% else %}
      {% raise "model #{name}: unknown declaration #{e}" %}
    {% end %}
  {% end %}
  {% types = {"string" => "String", "text" => "String", "integer" => "Int64", "bigint" => "Int64", "int64" => "Int64", "references" => "Int64", "float" => "Float64", "boolean" => "Bool", "datetime" => "::Std::Time::Time", "time" => "::Std::Time::Time", "json" => "::Ricord::Json::Json", "binary" => "::Ricord::Blob::Blob"} %}
  {% for c in cols %}
    {% unless (c.args.size == 1 && expand_refs) || types[c.args[1].id.stringify] %}
      {% raise "model #{name}: column #{c.args[0]} has unknown type #{c.args[1]}" %}
    {% end %}
    {% if c.named_args %}
      {% for na in c.named_args %}
        {% unless ["null", "default", "limit", "to", "on_delete", "belongs_to", "class_name", "index", "to_table"].includes?(na.name.stringify) %}
          {% raise "model #{name}: column #{c.args[0]} has unknown option #{na.name}" %}
        {% end %}
      {% end %}
    {% end %}
  {% end %}
  {% ci_created = nil %}
  {% ci_updated = nil %}
  {% if stamps %}
    {% for c, i in cols %}
      {% if c.args[0].id == "created_at" %}{% ci_created = i + 1 %}{% end %}
      {% if c.args[0].id == "updated_at" %}{% ci_updated = i + 1 %}{% end %}
    {% end %}
  {% end %}

  {% if expand_refs %}
  # `col :x_id, belongs_to: :x`: the model again with the column typed as a
  # reference to x's table and its index (unless `index: false`).
  model {{name}} do
    {% for e in exprs %}
      {% bt = e.is_a?(Call) && e.name == "col" && e.args.size == 1 && e.named_args && e.named_args.find { |na| na.name.stringify == "belongs_to" } %}
      {% if bt %}
        {% bcn = e.named_args.find { |na| na.name.stringify == "class_name" } %}
        {% tt = e.named_args.find { |na| na.name.stringify == "to_table" || na.name.stringify == "to" } %}
        {% ix = e.named_args.find { |na| na.name.stringify == "index" } %}
        col {{e.args[0]}}, :references, to: {{tt ? tt.value : ((bcn ? bcn.value.id.stringify.underscore : bt.value.id.stringify) + "s").id.symbolize}}, {{e.named_args.reject { |na| ["index", "to_table", "to"].includes?(na.name.stringify) }.map { |na| "#{na.name}: #{na.value}" }.join(", ").id}}, index: false
        {% unless ix && !ix.value %}
          index {{e.args[0]}}
        {% end %}
      {% else %}
        {{e}}
      {% end %}
    {% end %}
  end
  {% elsif expand_timestamps %}
  # `cols :timestamps`: the model again with its two columns and the marker
  # that turns the stamping on.
  model {{name}} do
    {% for e in exprs %}
      {% unless e.is_a?(Call) && e.name == "cols" %}
        {{e}}
      {% end %}
    {% end %}
    col :created_at, :datetime
    col :updated_at, :datetime
    __timestamps
  end
  {% else %}
  @[OnTape]
  pub struct {{name.id}}
    getter session : ::Ricord::Sessions::Session
    getter store : ::Ricord::Storage::Store
    getter index : Int32

    TABLE = {{table}}
    PRIMARY = "id"
    COLUMNS = ["id", {% for c in cols %}{{c.args[0].id.stringify}}, {% end %}]
    MODEL_ID = 0
    # belongs_to columns, then has_many/has_one, in declaration order.
    ASSOCIATION_COUNT = {{assocs.size}}
    # Which columns are BLOBs: they bind as hex text through `unhex(?)`.
    BLOB_COLUMNS = [false, {% for c in cols %}{{types[c.args[1].id.stringify] == "::Ricord::Blob::Blob"}}, {% end %}]
    # Which columns allow NULL: `each` refuses to order by one.
    NULLABLE = [false, {% for c in cols %}{{c.named_args && c.named_args.any? { |na| na.name.stringify == "null" && na.value } ? true : false}}, {% end %}]

    def initialize(@session : ::Ricord::Sessions::Session, @store : ::Ricord::Storage::Store, @index : Int32)
    end

    def self.[](db : ::Ricord::Sessions::Db) : Query
      Query.new(db.session, -1, -1, nil, nil)
    end

    # Creates the table and its indexes if missing.
    def self.create_table(db : ::Ricord::Sessions::Db) : Nil | ::Ricord::Failures::DatabaseError
      session = db.session
      d = session.dialect
      sql = String::Builder.new
      sql << "CREATE TABLE IF NOT EXISTS `" << TABLE << "` (`id` "
      d.column_sql(:integer, ::Ricord::Dialects::ColumnOptions.new(primary: true), sql)
      {% for c in cols %}
        {% opts = {} of String => ASTNode %}
        {% if c.named_args %}{% for na in c.named_args %}{% opts[na.name.stringify] = na.value %}{% end %}{% end %}
        sql << ", `" << {{c.args[0].id.stringify}} << "` "
        d.column_sql({{c.args[1]}}, ::Ricord::Dialects::ColumnOptions.new(
          null: {{opts["null"] ? opts["null"] : false}},
          {% if opts["limit"] %}limit: {{opts["limit"]}},{% end %}
          {% if opts["to"] %}references: {{opts["to"].id.stringify}},{% end %}
          {% if opts["on_delete"] %}on_delete: {{opts["on_delete"]}},{% end %}
          {% if opts["default"] != nil %}default_sql: {{opts["default"].is_a?(StringLiteral) || (opts["default"].is_a?(Call) && opts["default"].name == "view") ? ("'" + (opts["default"].is_a?(Call) ? opts["default"].args[0] : opts["default"]).gsub(/'/, "''") + "'") : (opts["default"].is_a?(BoolLiteral) ? (opts["default"] ? "1" : "0") : opts["default"].stringify)}},{% end %}
        ), sql)
      {% end %}
      {% for ck in checks %}
        {% ckname = ck.named_args && ck.named_args.find { |na| na.name.stringify == "name" } %}
        {% if ckname %}sql << ", CONSTRAINT `" << {{ckname.value}} << '`'{% end %}
        sql << {% if ckname %}" CHECK ("{% else %}", CHECK ("{% end %} << {{ck.args[0]}} << ')'
      {% end %}
      sql << ')'
      session.run(sql.to_s)!
      {% for ix in indexes %}
        {% icols = ix.args[0].is_a?(ArrayLiteral) ? ix.args[0] : [ix.args[0]] %}
        {% unique = ix.named_args && ix.named_args.any? { |na| na.name.stringify == "unique" && na.value } %}
        {% iname = ix.named_args && ix.named_args.find { |na| na.name.stringify == "name" } %}
        {% ixn = iname ? iname.value : "index_" + table + "_on_" + icols.map(&.id).join("_") %}
        session.run("CREATE #{ {{unique ? true : false}} ? "UNIQUE " : "" }INDEX IF NOT EXISTS `" + {{ixn}} + "` ON `{{table.id}}` (`{{icols.map(&.id).join("`, `").id}}`)")!
      {% end %}
      # A typed `belongs_to` column's index (the untyped form declares it).
      {% for c in cols %}
        {% if c.named_args && c.named_args.any? { |na| na.name.stringify == "belongs_to" } && !c.named_args.any? { |na| na.name.stringify == "index" && !na.value } %}
          session.run("CREATE INDEX IF NOT EXISTS `index_{{table.id}}_on_{{c.args[0].id}}` ON `{{table.id}}` (`{{c.args[0].id}}`)")!
        {% end %}
      {% end %}
      nil
    end

    # Reads a row selected as COLUMNS into record *index*.
    def self.read_row(store : ::Ricord::Storage::Store, index : Int32, rs : ::Db::Core::ResultSet, d : ::Ricord::Dialects::Dialect) : Nil | ::Ricord::Failures::DatabaseError
      id = rs.read(Int64).or_panic
      store.load_slot(index, 0, id)
      {% for c, i in cols %}
        {% t = types[c.args[1].id.stringify] %}
        {% if t == "String" || t == "::Ricord::Json::Json" %}
          v{{i}} = rs.read(String | Nil).or_panic
          store.load_slot(index, {{i + 1}}, v{{i}}.nil? ? nil : store.add_text(v{{i}}))
        {% elsif t == "::Ricord::Blob::Blob" %}
          v{{i}} = rs.read(String | Nil).or_panic
          store.load_slot(index, {{i + 1}}, v{{i}}.nil? ? nil : store.add_byte_string(v{{i}}))
        {% elsif t == "::Std::Time::Time" %}
          v{{i}} = rs.read(String | Nil).or_panic
          if v{{i}}.nil?
            store.load_slot(index, {{i + 1}}, nil)
          else
            t{{i}} = d.read_time(v{{i}}, TABLE)
            return t{{i}} if t{{i}}.is_a?(::Ricord::Failures::DatabaseError)
            store.load_slot(index, {{i + 1}}, t{{i}})
          end
        {% elsif t == "Bool" %}
          v{{i}} = rs.read(Int64 | Nil).or_panic
          store.load_slot(index, {{i + 1}}, v{{i}}.nil? ? nil : v{{i}} != 0_i64)
        {% else %}
          store.load_slot(index, {{i + 1}}, rs.read({{t.id}} | Nil).or_panic)
        {% end %}
      {% end %}
      store.mark_loaded(index)
      nil
    end

    def id : Int64
      v = store.slot(index, 0)
      v.is_a?(Int64) ? v : 0_i64
    end

    {% for c, i in cols %}
      {% t = types[c.args[1].id.stringify] %}
      {% nullable = c.named_args && c.named_args.any? { |na| na.name.stringify == "null" && na.value } %}
      {% cn = c.args[0].id %}
      {% if t == "String" %}
        def {{cn}} : String{% if nullable %} | Nil{% end %}
          v = store.slot(index, {{i + 1}})
          v.is_a?(::Ricord::Values::TextSpan) ? store.span_text(v) : {% if nullable %}nil{% else %}""{% end %}
        end

        # Setting the value a persisted record already holds is not a change.
        def {{cn}}=(value : String{% if nullable %} | Nil{% end %}) : Nil
          return nil if persisted? && ::Ricord::Model.same_text?(store, store.slot(index, {{i + 1}}), value)
          {% if nullable %}
            if value.nil?
              store.set_slot(index, {{i + 1}}, nil)
              return nil
            end
          {% end %}
          store.set_text(index, {{i + 1}}, value)
          nil
        end
      {% elsif t == "::Ricord::Json::Json" %}
        def {{cn}} : ::Ricord::Json::Json
          v = store.slot(index, {{i + 1}})
          ::Ricord::Json::Json.new(store, v.is_a?(::Ricord::Values::TextSpan) ? v : ::Ricord::Values::TextSpan.new(0, 0))
        end

        # Sets the JSON text; the caller writes valid JSON.
        def {{cn}}=(value : String{% if nullable %} | Nil{% end %}) : Nil
          return nil if persisted? && ::Ricord::Model.same_text?(store, store.slot(index, {{i + 1}}), value)
          {% if nullable %}
            if value.nil?
              store.set_slot(index, {{i + 1}}, nil)
              return nil
            end
          {% end %}
          store.set_text(index, {{i + 1}}, value)
          nil
        end
      {% elsif t == "::Ricord::Blob::Blob" %}
        def {{cn}} : ::Ricord::Blob::Blob
          v = store.slot(index, {{i + 1}})
          ::Ricord::Blob::Blob.new(store, v.is_a?(::Ricord::Values::ByteSpan) ? v : ::Ricord::Values::ByteSpan.new(0, 0))
        end

        def {{cn}}=(value : ::Std::Slice::Bytes{% if nullable %} | Nil{% end %}) : Nil
          {% if nullable %}
            if value.nil?
              store.set_slot(index, {{i + 1}}, nil)
              return nil
            end
          {% end %}
          store.set_slot(index, {{i + 1}}, store.add_bytes(value))
          nil
        end
      {% else %}
        def {{cn}} : {{t.id}}{% if nullable %} | Nil{% end %}
          v = store.slot(index, {{i + 1}})
          v.is_a?({{t.id}}) ? v : {% if nullable %}nil{% elsif t == "Int64" %}0_i64{% elsif t == "Float64" %}0.0{% elsif t == "Bool" %}false{% else %}::Std::Time::Time.utc(1970, 1, 1){% end %}
        end

        def {{cn}}=(value : {{t.id}}{% if t == "Int64" %} | Int32{% end %}{% if nullable %} | Nil{% end %}) : Nil
          {% if t == "Int64" %}
            given = value.is_a?(Int32) ? value.to_i64 : value
          {% else %}
            given = value
          {% end %}
          return nil if persisted? && store.slot(index, {{i + 1}}) == given
          store.set_slot(index, {{i + 1}}, given)
          {% for a, ai in assocs %}
            {% if a[0] == "belongs_to" && a[4] == i + 1 %}
              ::Ricord::Associations.unload(store, index, {{ai}})
            {% end %}
          {% end %}
          nil
        end
      {% end %}
    {% end %}

    def persisted? : Bool
      store.flag?(index, ::Ricord::Storage::FLAG_PERSISTED) && !store.flag?(index, ::Ricord::Storage::FLAG_DESTROYED)
    end

    def new_record? : Bool
      !store.flag?(index, ::Ricord::Storage::FLAG_PERSISTED)
    end

    def destroyed? : Bool
      store.flag?(index, ::Ricord::Storage::FLAG_DESTROYED)
    end

    def changed? : Bool
      COLUMNS.size.times { |col| return true if store.changed?(index, col) }
      false
    end

    # The names of the columns assigned since the last load or save.
    def changed_attributes : Array(String)
      names = [] of String
      (1...COLUMNS.size).each { |col| names << COLUMNS[col] if store.changed?(index, col) }
      names
    end

    {% for c, i in cols %}
      def {{c.args[0].id}}_changed? : Bool
        store.changed?(index, {{i + 1}})
      end
    {% end %}

    {% for f in json_fields %}
      {% unless f.args.size == 3 %}{% raise "model #{name}: json_field takes :column, :key, :type" %}{% end %}
      {% jci = nil %}
      {% for c, i in cols %}{% if c.args[0].id == f.args[0].id %}{% jci = i + 1 %}{% unless types[c.args[1].id.stringify] == "::Ricord::Json::Json" %}{% raise "model #{name}: json_field #{f.args[1]} names #{f.args[0]}, which is not a :json column" %}{% end %}{% end %}{% end %}
      {% unless jci %}{% raise "model #{name}: json_field names unknown column #{f.args[0]}" %}{% end %}
      {% jkind = f.args[2].id.stringify %}
      {% jt = {"string" => "String", "integer" => "Int64", "boolean" => "Bool", "float" => "Float64"}[jkind] %}
      {% unless jt %}{% raise "model #{name}: json_field #{f.args[1]} has unknown type #{f.args[2]}; use :string, :integer, :boolean or :float" %}{% end %}
      {% jd = f.named_args && f.named_args.find { |na| na.name.stringify == "default" } %}
      {% jdefault = jd ? jd.value : nil %}
      {% jnil = jdefault.is_a?(NilLiteral) || jdefault == nil %}
      {% jkey = f.args[1].id %}
      # json_field: key {{jkey.stringify}} of {{f.args[0].id.stringify}}; the default for a
      # missing key, the default and a warning for a value of another type.
      def {{jkey}} : {{jt.id}}{% if jnil %} | Nil{% end %}
        slot = store.slot(index, {{jci}})
        span = slot.is_a?(::Ricord::Values::TextSpan) ? slot : ::Ricord::Values::TextSpan.new(0, 0)
        value = ::Ricord::Json.read_{{jkind.id}}_field(store, span, {{jkey.stringify}})
        if value.is_a?(::Ricord::Json::WrongType)
          ::Ricord::Sessions::LOG.warn { "#{TABLE}.{{f.args[0].id}}: key {{jkey}} is not of type {{jkind.id}}; using the default" }
          return {% if jnil %}nil{% elsif jt == "Int64" %}({{jdefault}}).to_i64{% elsif jt == "Float64" %}({{jdefault}}).to_f64{% else %}{{jdefault}}{% end %}
        end
        return value unless value.nil?
        {% if jnil %}nil{% elsif jt == "Int64" %}({{jdefault}}).to_i64{% elsif jt == "Float64" %}({{jdefault}}).to_f64{% else %}{{jdefault}}{% end %}
      end

      # Rewrites the column's JSON text with the key set and marks the column changed.
      def {{jkey}}=(value : {{jt.id}}{% if jt == "Int64" %} | Int32{% end %}{% if jt == "Float64" %} | Int32 | Int64{% end %}{% if jnil %} | Nil{% end %}) : Nil
        {% if jt == "Int64" %}
          given = value.is_a?(Int32) ? value.to_i64 : value
        {% elsif jt == "Float64" %}
          given = value.is_a?(Int32) || value.is_a?(Int64) ? value.to_f64 : value
        {% else %}
          given = value
        {% end %}
        ::Ricord::Json.set_field(store, index, {{jci}}, {{jkey.stringify}}, given)
      end
    {% end %}

    # Assigns the given columns, then saves: the record, or the save's error.
    def update(*, {% for c in cols %}{% t = types[c.args[1].id.stringify] %}{% nullable = c.named_args && c.named_args.any? { |na| na.name.stringify == "null" && na.value } %}{{c.args[0].id}} : {% if t == "::Ricord::Json::Json" %}String{% elsif t == "::Ricord::Blob::Blob" %}::Std::Slice::Bytes{% else %}{{t.id}}{% end %}{% if t == "Int64" %} | Int32{% end %}{% if nullable %} | Nil{% end %} | ::Ricord::Values::Skip = ::Ricord::Values::SKIP, {% end %}) : self | ::Ricord::Failures::Error
      {% for c in cols %}
        self.{{c.args[0].id}} = {{c.args[0].id}} unless {{c.args[0].id}}.is_a?(::Ricord::Values::Skip)
      {% end %}
      save
    end

    def to_param : String
      id.to_s
    end

    # This record's validation entries.
    def errors : ::Ricord::Errors::Errors
      ::Ricord::Errors::Errors.new(store, index, COLUMNS)
    end

    # Runs the validation callbacks and validators; a refusing callback is a
    # `CallbackError` (entries added so far stay).
    def run_validations : Nil | ::Ricord::Failures::CallbackError
      ::Ricord::Validations.clear(store, index)
      {% for m in callbacks["before_validation"] %}
        refused = {{m.id}}
        return ::Ricord::Failures::CallbackError.new(TABLE, "validate", "before_validation {{m.id}}") if refused.is_a?(::Ricord::Failures::Failure)
      {% end %}
      {% for v in validations %}
        {% for attr in v.args %}
          {% ci = nil %}
          {% for c, i in cols %}{% if c.args[0].id == attr.id %}{% ci = i + 1 %}{% end %}{% end %}
          {% unless ci %}{% raise "model #{name}: validates names unknown column #{attr}" %}{% end %}
          {% for na in v.named_args %}
            {% kind = na.name.stringify %}
            {% if kind == "presence" %}
              {% if na.value %}::Ricord::Validations.presence(store, index, {{ci}}){% end %}
            {% elsif kind == "length" %}
              {% lo = {} of String => ASTNode %}
              {% for k, val in na.value %}{% lo[k.id.stringify] = val %}{% end %}
              {% for k, val in lo %}{% unless ["minimum", "maximum", "is"].includes?(k) %}{% raise "model #{name}: unknown length option #{k}" %}{% end %}{% end %}
              ::Ricord::Validations.length(store, index, {{ci}}, {{lo["minimum"] || nil}}, {{lo["maximum"] || nil}}, {{lo["is"] || nil}})
            {% elsif kind == "format" %}
              {% fo = {} of String => ASTNode %}
              {% for k, val in na.value %}{% fo[k.id.stringify] = val %}{% end %}
              {% pattern = fo["with"] %}
              {% unless pattern.is_a?(RegexLiteral) %}{% raise "model #{name}: format with: takes a regex literal" %}{% end %}
              {% unless pattern.options.empty? %}{% raise "model #{name}: format with: takes no regex options; write them inline, as (?i)" %}{% end %}
              # The regex goes in as its source: a regex literal in the generated code
              # crashes the ris compiler.
              ::Ricord::Validations.format(store, index, {{ci}}, {{pattern.source}})
            {% elsif kind == "inclusion" %}
              {% io = {} of String => ASTNode %}
              {% for k, val in na.value %}{% io[k.id.stringify] = val %}{% end %}
              included{{ci}} = false
              current{{ci}} = {{attr.id}}
              {{io["in"]}}.each { |allowed| included{{ci}} = true if allowed == current{{ci}} }
              ::Ricord::Validations.inclusion(store, index, {{ci}}, included{{ci}})
            {% else %}
              {% raise "model #{name}: unknown validation #{na.name}" %}
            {% end %}
          {% end %}
        {% end %}
      {% end %}
      {% for m in custom_validations %}
        {{m.id}}
      {% end %}
      {% for m in callbacks["after_validation"] %}
        refused = {{m.id}}
        return ::Ricord::Failures::CallbackError.new(TABLE, "validate", "after_validation {{m.id}}") if refused.is_a?(::Ricord::Failures::Failure)
      {% end %}
      nil
    end

    # Validates; false when a validator added an entry or a callback refused.
    def valid? : Bool
      run_validations.nil? && errors.empty?
    end

    # Validates, then INSERT or UPDATE of the changed columns with the save
    # callbacks, in its own write unless inside one (then a savepoint).
    def save : self | ::Ricord::Failures::Error
      return ::Ricord::Failures::DatabaseError.new(TABLE, "save", "record #{id} is destroyed") if destroyed?
      # Nothing changed: no statement, no write, no callbacks (as Grant).
      return self if persisted? && !changed?
      scoped = ::Ricord::Model.scope_violation(store, index)
      return ::Ricord::Failures::ScopeError.new(TABLE, COLUMNS[scoped]) if scoped >= 0
      refused = run_validations
      return refused if refused.is_a?(::Ricord::Failures::Failure)
      count = errors.size
      return ::Ricord::Failures::RecordInvalid.new(TABLE, ::Ricord::Validations.first_full_message(store, index, COLUMNS), count) if count > 0
      was_new = new_record?
      record = self
      store.attempt_next = true
      result = session.write { |tx| record.save_in(tx) }
      store.attempt_next = false
      if result.is_a?(::Ricord::Failures::AfterCommitError)
        # The row is committed; only its after-commit work failed.
        store.clear_changed(index, COLUMNS.size)
        return result
      end
      if result.is_a?(::Ricord::Failures::Failure)
        if was_new
          store.set_flag(index, ::Ricord::Storage::FLAG_PERSISTED, false)
          store.load_slot(index, 0, nil)
        end
        return result
      end
      store.clear_changed(index, COLUMNS.size)
      self
    end

    def save_in(tx : ::Ricord::Sessions::Tx) : Nil | ::Ricord::Failures::DatabaseError | ::Ricord::Failures::CallbackError
      queued = tx.session.state.pending.size
      {% for m, i in rollbacks %}
        {{name.id}}.__queue(tx, new_record? ? -1_i64 : id, ::Ricord::CommitQueue::KIND_ROLLBACK, {{i}})
      {% end %}
      {% for m in callbacks["before_save"] %}
        refused = {{m.id}}
        return ::Ricord::Failures::CallbackError.new(TABLE, "save", "before_save {{m.id}}") if refused.is_a?(::Ricord::Failures::Failure)
      {% end %}
      creating = new_record?
      if creating
        {% for m in callbacks["before_create"] %}
          refused = {{m.id}}
          return ::Ricord::Failures::CallbackError.new(TABLE, "save", "before_create {{m.id}}") if refused.is_a?(::Ricord::Failures::Failure)
        {% end %}
      else
        {% for m in callbacks["before_update"] %}
          refused = {{m.id}}
          return ::Ricord::Failures::CallbackError.new(TABLE, "save", "before_update {{m.id}}") if refused.is_a?(::Ricord::Failures::Failure)
        {% end %}
      end
      {% if stamps %}
        stamped = stamp(creating)
        return stamped if stamped.is_a?(::Ricord::Failures::Failure)
      {% end %}
      written = write_row
      return written if written.is_a?(::Ricord::Failures::Failure)
      tx.session.state.rekey(queued, ::Ricord::Sessions.model_key(TABLE), id) if creating
      if creating
        {% for m in callbacks["after_create"] %}
          refused = {{m.id}}
          return ::Ricord::Failures::CallbackError.new(TABLE, "save", "after_create {{m.id}}") if refused.is_a?(::Ricord::Failures::Failure)
        {% end %}
      else
        {% for m in callbacks["after_update"] %}
          refused = {{m.id}}
          return ::Ricord::Failures::CallbackError.new(TABLE, "save", "after_update {{m.id}}") if refused.is_a?(::Ricord::Failures::Failure)
        {% end %}
      end
      {% for m in callbacks["after_save"] %}
        refused = {{m.id}}
        return ::Ricord::Failures::CallbackError.new(TABLE, "save", "after_save {{m.id}}") if refused.is_a?(::Ricord::Failures::Failure)
      {% end %}
      {% for e, i in commits %}
        {% if e[1] && e[2] %}
          {{name.id}}.__queue(tx, id, creating ? ::Ricord::CommitQueue::KIND_CREATE : ::Ricord::CommitQueue::KIND_UPDATE, {{i}})
        {% elsif e[1] %}
          {{name.id}}.__queue(tx, id, ::Ricord::CommitQueue::KIND_CREATE, {{i}}) if creating
        {% elsif e[2] %}
          {{name.id}}.__queue(tx, id, ::Ricord::CommitQueue::KIND_UPDATE, {{i}}) unless creating
        {% end %}
      {% end %}
      nil
    end

    # Queues one after-commit or after-rollback item for this model.
    def self.__queue(tx : ::Ricord::Sessions::Tx, key : Int64, kind : UInt8, method : Int32) : Nil
      state = tx.session.state
      state.pending << ::Ricord::Sessions::CommitItem.new(key, kind, method, tx.depth, state.chain, ::Ricord::Sessions.model_key(TABLE), ->{{name.id}}.__after_commit(::Ricord::Sessions::Db, Int64, UInt8, Int32))
      nil
    end

    # Runs one queued item (doc/DESIGN.md, M2 item 2, "User signatures"):
    # create and update call the instance method on the record loaded by key,
    # destroy the class method with the item's write and the key, rollback the
    # class method with the session and the key (nil for a create).
    def self.__after_commit(db : ::Ricord::Sessions::Db, key : Int64, kind : UInt8, method : Int32) : Nil | ::Ricord::Failures::Error
      if kind == ::Ricord::CommitQueue::KIND_ROLLBACK
        {% for m, i in rollbacks %}
          {{name.id}}.{{m.id}}(db.session, key == -1 ? nil : key) if method == {{i}}
        {% end %}
        return nil
      end
      if kind == ::Ricord::CommitQueue::KIND_DESTROY
        if db.is_a?(::Ricord::Sessions::Tx)
          {% for e, i in commits %}
            {% if e[3] %}
              return {{name.id}}.{{e[0].id}}(db, key) if method == {{i}}
            {% end %}
          {% end %}
        end
        return nil
      end
      {% if commits.any? { |e| e[1] || e[2] } %}
        record = {{name.id}}[db].find(key)
        return record if record.is_a?(::Ricord::Failures::Failure)
        {% for e, i in commits %}
          {% if e[1] || e[2] %}
            return record.{{e[0].id}} if method == {{i}}
          {% end %}
        {% end %}
      {% end %}
      nil
    end

    {% if stamps %}
      # `cols :timestamps`: a create sets created_at and updated_at, an update
      # that changes another column sets updated_at; a column the caller
      # assigned is kept. The time is UTC as the dialect stores it
      # (microseconds), so memory and the row agree.
      def stamp(creating : Bool) : Nil | ::Ricord::Failures::DatabaseError
        d = session.dialect
        now = d.read_time(d.write_time(::Std::Time::Time.utc), TABLE, "save")
        return now if now.is_a?(::Ricord::Failures::DatabaseError)
        if creating
          store.set_slot(index, {{ci_created}}, now) unless store.changed?(index, {{ci_created}})
          store.set_slot(index, {{ci_updated}}, now) unless store.changed?(index, {{ci_updated}})
        elsif !store.changed?(index, {{ci_updated}})
          other = false
          (1...COLUMNS.size).each { |col| other = true if col != {{ci_updated}} && store.changed?(index, col) }
          store.set_slot(index, {{ci_updated}}, now) if other
        end
        nil
      end
    {% end %}

    # The INSERT or UPDATE itself; changed marks stay until the save succeeds.
    def write_row : Nil | ::Ricord::Failures::DatabaseError
      d = session.dialect
      sql = String::Builder.new
      args = [] of ::Db::Value::DBValue
      if new_record?
        names = ""
        marks = ""
        (1...COLUMNS.size).each do |col|
          next unless store.changed?(index, col)
          unless names.empty?
            names << ", "
            marks << ", "
          end
          names << '`' << COLUMNS[col] << '`'
          marks << (BLOB_COLUMNS[col] ? "unhex(?)" : "?")
          ::Ricord::Model.push_db(args, store.slot(index, col), store, d)
        end
        sql << "INSERT INTO `" << TABLE << '`'
        if names.empty?
          sql << " DEFAULT VALUES"
        else
          sql << " (" << names << ") VALUES (" << marks << ')'
        end
        d.insert_returning(PRIMARY, sql)
        new_id = session.query(sql.to_s, args) { |rs| m = ::Ricord::Model.advance(rs, TABLE); m.is_a?(::Ricord::Failures::DatabaseError) ? m : (m ? rs.read(Int64).or_panic : 0_i64) }
        return new_id if new_id.is_a?(::Ricord::Failures::DatabaseError)
        store.touch(index)
        store.load_slot(index, 0, new_id)
        store.set_flag(index, ::Ricord::Storage::FLAG_PERSISTED, true)
      else
        sets = ""
        (1...COLUMNS.size).each do |col|
          next unless store.changed?(index, col)
          sets << ", " unless sets.empty?
          sets << '`' << COLUMNS[col] << (BLOB_COLUMNS[col] ? "` = unhex(?)" : "` = ?")
          ::Ricord::Model.push_db(args, store.slot(index, col), store, d)
        end
        unless sets.empty?
          args << id
          sql << "UPDATE `" << TABLE << "` SET " << sets << " WHERE `id` = ?"
          session.run(sql.to_s, args)!
        end
      end
      nil
    end

    # DELETE with the destroy callbacks, in its own write unless inside one.
    def destroy : self | ::Ricord::Failures::Error
      return ::Ricord::Failures::DatabaseError.new(TABLE, "destroy", "record #{id} is destroyed") if destroyed?
      record = self
      store.attempt_next = true
      result = session.write { |tx| record.destroy_in(tx) }
      store.attempt_next = false
      if result.is_a?(::Ricord::Failures::AfterCommitError)
        store.set_flag(index, ::Ricord::Storage::FLAG_DESTROYED, true)
        return result
      end
      return result if result.is_a?(::Ricord::Failures::Failure)
      store.set_flag(index, ::Ricord::Storage::FLAG_DESTROYED, true)
      self
    end

    def destroy_in(tx : ::Ricord::Sessions::Tx) : Nil | ::Ricord::Failures::DatabaseError | ::Ricord::Failures::CallbackError
      {% for m, i in rollbacks %}
        {{name.id}}.__queue(tx, id, ::Ricord::CommitQueue::KIND_ROLLBACK, {{i}})
      {% end %}
      {% for m in callbacks["before_destroy"] %}
        refused = {{m.id}}
        return ::Ricord::Failures::CallbackError.new(TABLE, "destroy", "before_destroy {{m.id}}") if refused.is_a?(::Ricord::Failures::Failure)
      {% end %}
      # dependent: restrict first (nothing changed yet), then the other modes in
      # declaration order, all before this row's DELETE.
      {% for a in assocs %}
        {% if a[5] == "restrict" %}
          held = {{a[2]}}[tx].where({{a[3]}}: id).exists?
          return held if held.is_a?(::Ricord::Failures::DatabaseError)
          return ::Ricord::Failures::CallbackError.new(TABLE, "destroy", "dependent: :restrict {{a[1]}}") if held
        {% end %}
      {% end %}
      {% for a in assocs %}
        {% if a[5] == "delete_all" %}
          tx.exec("DELETE FROM `#{{{a[2]}}::TABLE}` WHERE `{{a[3]}}` = ?", [id.as(::Db::Value::DBValue)])!
        {% elsif a[5] == "nullify" %}
          tx.exec("UPDATE `#{{{a[2]}}::TABLE}` SET `{{a[3]}}` = NULL WHERE `{{a[3]}}` = ?", [id.as(::Db::Value::DBValue)])!
        {% elsif a[5] == "destroy" %}
          children_{{a[1]}} = {{a[2]}}[tx].where({{a[3]}}: id).order(:id).to_a
          return children_{{a[1]}} if children_{{a[1]}}.is_a?(::Ricord::Failures::DatabaseError)
          children_{{a[1]}}.each do |child|
            gone = child.destroy_in(tx)
            return gone if gone.is_a?(::Ricord::Failures::Failure)
            child.store.set_flag(child.index, ::Ricord::Storage::FLAG_DESTROYED, true)
          end
        {% end %}
      {% end %}
      tx.exec("DELETE FROM `#{TABLE}` WHERE `id` = ?", [id.as(::Db::Value::DBValue)])!
      {% for m in callbacks["after_destroy"] %}
        refused = {{m.id}}
        return ::Ricord::Failures::CallbackError.new(TABLE, "destroy", "after_destroy {{m.id}}") if refused.is_a?(::Ricord::Failures::Failure)
      {% end %}
      {% for e, i in commits %}
        {% if e[3] %}
          {{name.id}}.__queue(tx, id, ::Ricord::CommitQueue::KIND_DESTROY, {{i}})
        {% end %}
      {% end %}
      nil
    end

    def reload : self | ::Ricord::Failures::Error
      store.touch(index)
      record = self
      found = session.query("SELECT #{COLUMNS.map { |c| "`#{c}`" }.join(", ")} FROM `#{TABLE}` WHERE `id` = ?", [id.as(::Db::Value::DBValue)]) do |rs|
        m = ::Ricord::Model.advance(rs, TABLE)
        if m.is_a?(::Ricord::Failures::DatabaseError)
          m
        elsif m
          {{name.id}}.read_row(record.store, record.index, rs, record.session.dialect)
        else
          ::Ricord::Failures::RecordNotFound.new(TABLE, record.id)
        end
      end
      return found if found.is_a?(::Ricord::Failures::Failure)
      store.clear_changed(index, COLUMNS.size)
      self
    end

    def self.new(db : ::Ricord::Sessions::Db, *, {% for c in cols %}{% t = types[c.args[1].id.stringify] %}{{c.args[0].id}} : {% if t == "::Ricord::Json::Json" %}String{% elsif t == "::Ricord::Blob::Blob" %}::Std::Slice::Bytes{% else %}{{t.id}}{% end %}{% if t == "Int64" %} | Int32{% end %} | Nil | ::Ricord::Values::Skip = ::Ricord::Values::SKIP, {% end %}) : {{name.id}}
      session = db.session
      index = session.store.add_record(MODEL_ID, COLUMNS.size, ASSOCIATION_COUNT)
      record = {{name.id}}.new(session, session.store, index)
      {% for c, i in cols %}
        {% cn = c.args[0].id %}
        {% t = types[c.args[1].id.stringify] %}
        unless {{cn}}.is_a?(::Ricord::Values::Skip)
          if {{cn}}.nil?
            session.store.set_slot(index, {{i + 1}}, nil)
          else
            {% if t == "String" || t == "::Ricord::Json::Json" %}
              session.store.set_text(index, {{i + 1}}, {{cn}})
            {% elsif t == "::Ricord::Blob::Blob" %}
              session.store.set_slot(index, {{i + 1}}, session.store.add_bytes({{cn}}))
            {% elsif t == "Int64" %}
              session.store.set_slot(index, {{i + 1}}, {{cn}}.to_i64)
            {% else %}
              session.store.set_slot(index, {{i + 1}}, {{cn}})
            {% end %}
          end
        end
      {% end %}
      record
    end

    def self.create(db : ::Ricord::Sessions::Db, **attrs) : {{name.id}} | ::Ricord::Failures::Error
      new(db, **attrs).save
    end

    # `Query` and `OffsetQuery` from one body: `offset(n)` returns an
    # `OffsetQuery`, which reads (`to_a`, `first`, `count`, `pluck`, ...) but
    # has no `each`, `offset`, `build`, `create`, `update_all`, `delete_all` or
    # `destroy_all` (doc/DESIGN.md, M1 item 8 and M4 item 1).
    {% for qt in ["Query", "OffsetQuery"] %}
    {% full = qt == "Query" %}
    @[OnTape]
    pub struct {{qt.id}}
      getter session : ::Ricord::Sessions::Session
      getter last_where : Int32
      getter last_order : Int32
      getter limit_value : Int64 | Nil
      getter offset_value : Int64 | Nil

      # `includes` has a bit per association index to preload after the read.
      # A query made by a has_many reader names its owner record, the owner's
      # association index and this model's foreign-key column; `bare` is true
      # until a call narrows it, and only a bare one reads and fills the
      # owner's loaded range.
      getter includes : Int64
      getter owner : Int32
      getter owner_assoc : Int32
      getter owner_fk : Int32
      getter bare : Bool
      # The inherited scope: start in the store's scope pairs, -1 for none
      # (`Model[db]`).
      getter scope : Int32
      # The last node of the join chain (`joins`), -1 for none; `distinct`
      # selects distinct rows.
      getter last_join : Int32
      getter distinct_rows : Bool

      def initialize(@session : ::Ricord::Sessions::Session, @last_where : Int32, @last_order : Int32, @limit_value : Int64 | Nil, @offset_value : Int64 | Nil, @includes : Int64 = 0_i64, @owner : Int32 = -1, @owner_assoc : Int32 = -1, @owner_fk : Int32 = -1, @bare : Bool = false, @scope : Int32 = -1, @last_join : Int32 = -1, @distinct_rows : Bool = false)
      end

      private def chain(last_where : Int32, last_order : Int32, limit_value : Int64 | Nil, offset_value : Int64 | Nil) : {{qt.id}}
        {{qt.id}}.new(session, last_where, last_order, limit_value, offset_value, @includes, @owner, @owner_assoc, @owner_fk, false, @scope, @last_join, @distinct_rows)
      end

      # Preloads the named associations of the records this query reads.
      def includes(*names : Symbol) : {{qt.id}}
        bits = @includes
        names.each do |n|
          a = {{name.id}}.association_index(n)
          bits |= 1_i64 << a if a >= 0
        end
        {{qt.id}}.new(session, @last_where, @last_order, @limit_value, @offset_value, bits, @owner, @owner_assoc, @owner_fk, @bare, @scope, @last_join, @distinct_rows)
      end

      # A typed condition per column given; `Array` is IN, `Range` is between.
      def where(*, id : Int64 | Int32 | Array(Int64) | Nil | ::Ricord::Values::Skip = ::Ricord::Values::SKIP, {% for c in cols %}{% t = types[c.args[1].id.stringify] %}{% unless t.starts_with?("::Ricord::") %}{{c.args[0].id}} : {{t.id}}{% if t == "Int64" %} | Int32{% end %} | Array({{t.id}}){% if t == "Int64" || t == "Float64" %} | Range({{t.id}}, {{t.id}}) | Range(Nil, {{t.id}}) | Range({{t.id}}, Nil) | Range(Nil, Nil){% end %} | Nil | ::Ricord::Values::Skip = ::Ricord::Values::SKIP, {% end %}{% end %}) : {{qt.id}}
        where_any(0_u8, id: id, {% for c in cols %}{% unless types[c.args[1].id.stringify].starts_with?("::Ricord::") %}{{c.args[0].id}}: {{c.args[0].id}}, {% end %}{% end %})
      end

      def or_where(*, id : Int64 | Int32 | Array(Int64) | Nil | ::Ricord::Values::Skip = ::Ricord::Values::SKIP, {% for c in cols %}{% t = types[c.args[1].id.stringify] %}{% unless t.starts_with?("::Ricord::") %}{{c.args[0].id}} : {{t.id}}{% if t == "Int64" %} | Int32{% end %} | Array({{t.id}}){% if t == "Int64" || t == "Float64" %} | Range({{t.id}}, {{t.id}}) | Range(Nil, {{t.id}}) | Range({{t.id}}, Nil) | Range(Nil, Nil){% end %} | Nil | ::Ricord::Values::Skip = ::Ricord::Values::SKIP, {% end %}{% end %}) : {{qt.id}}
        where_any(1_u8, id: id, {% for c in cols %}{% unless types[c.args[1].id.stringify].starts_with?("::Ricord::") %}{{c.args[0].id}}: {{c.args[0].id}}, {% end %}{% end %})
      end

      private def where_any(op : UInt8, **conds) : {{qt.id}}
        node = ::Ricord::Model.where_conds(session.store, op, @last_where, conds)
        chain(node, @last_order, @limit_value, @offset_value)
      end

      # A raw condition with `?` binds.
      def where(sql : String, *binds) : {{qt.id}}
        node = ::Ricord::Model.where_raw(session.store, @last_where, sql, binds)
        chain(node, @last_order, @limit_value, @offset_value)
      end

      def order(*cols : Symbol) : {{qt.id}}
        chain(@last_where, ::Ricord::Model.order_cols(session.store, @last_order, COLUMNS, cols), @limit_value, @offset_value)
      end

      def order(**cols) : {{qt.id}}
        chain(@last_where, ::Ricord::Model.order_dirs(session.store, @last_order, COLUMNS, cols), @limit_value, @offset_value)
      end

      def limit(n : Int64 | Int32) : {{qt.id}}
        chain(@last_where, @last_order, n.to_i64, @offset_value)
      end

      {% if full %}
        def offset(n : Int64 | Int32) : OffsetQuery
          OffsetQuery.new(session, @last_where, @last_order, @limit_value, n.to_i64, @includes, @owner, @owner_assoc, @owner_fk, false, @scope, @last_join, @distinct_rows)
        end
      {% end %}

      # Distinct rows: `SELECT DISTINCT`.
      def distinct : {{qt.id}}
        {{qt.id}}.new(session, @last_where, @last_order, @limit_value, @offset_value, @includes, @owner, @owner_assoc, @owner_fk, false, @scope, @last_join, true)
      end

      # An INNER JOIN per association, hop by hop: `joins(:courts, :cases)`
      # from Account joins courts on accounts, then cases on courts. Each
      # joined table gets the query's scope pairs whose column it has
      # (the association's column maps composed hop by hop).
      def joins(*names : Symbol) : {{qt.id}}
        store = session.store
        list = [] of Symbol
        names.each { |n| list << n }
        map = [] of Int32
        if @scope >= 0
          at = @scope
          while store.scope_cols[at] >= 0
            map << store.scope_cols[at]
            at += 1
          end
        end
        text = String::Builder.new
        start = store.binds.size
        {{name.id}}.__join(list, 0, store, map, @scope, text)
        node = store.add_where(@last_join, 0_u8, text.to_s, start, store.binds.size - start)
        {{qt.id}}.new(session, @last_where, @last_order, @limit_value, @offset_value, @includes, @owner, @owner_assoc, @owner_fk, false, @scope, node, @distinct_rows)
      end

      # The column qualifier: `` `table`. `` when the query joins.
      def prefix : String
        @last_join >= 0 ? "`#{TABLE}`." : ""
      end

      # COLUMNS as a select list.
      def select_list : String
        p = prefix
        COLUMNS.map { |c| "#{p}`#{c}`" }.join(", ")
      end

      def build_sql(selection : String, sql : String::Builder, args : Array(::Db::Value::DBValue), flip : Bool = false) : Nil
        sql << "SELECT " << (@distinct_rows ? "DISTINCT " : "") << selection << " FROM `" << TABLE << '`'
        ::Ricord::Model.join_sql(session.store, @last_join, sql, args, session.dialect)
        ::Ricord::Model.scoped_where_sql(session.store, @last_where, @scope, COLUMNS, sql, args, session.dialect, prefix)
        ::Ricord::Model.order_sql(session.store, @last_order, COLUMNS, sql, flip, prefix)
        session.dialect.limit_offset(@limit_value, @offset_value, sql)
        nil
      end

      # The rows as records, read as one load group. A bare has_many query whose
      # owner's range is loaded reads the range instead and runs no query.
      def to_a : Array({{name.id}}) | ::Ricord::Failures::DatabaseError
        s = session
        if @bare && @owner >= 0 && ::Ricord::Associations.loaded?(s.store, @owner, @owner_assoc)
          cached = [] of {{name.id}}
          start = ::Ricord::Associations.range_start(s.store, @owner, @owner_assoc)
          ::Ricord::Associations.range_count(s.store, @owner, @owner_assoc).times { |k| cached << {{name.id}}.new(s, s.store, s.store.links[start + k]) }
          return cached
        end
        first = s.store.size
        count = read_rows
        return count if count.is_a?(::Ricord::Failures::DatabaseError)
        # The preloads run before the result array exists: a loader reads
        # through another model's query, which may come back here.
        if count > 0 && @includes != 0_i64
          loaded = {{name.id}}.__preload_all(s, first, count, @includes)
          return loaded if loaded.is_a?(::Ricord::Failures::DatabaseError)
        end
        records = [] of {{name.id}}
        count.times { |k| records << {{name.id}}.new(s, s.store, first + k) }
        records
      end

      # Reads the rows into consecutive store records as one load group (a
      # bare has_many query also fills its owner's range): the row count.
      # No preloads.
      def read_rows : Int32 | ::Ricord::Failures::DatabaseError
        s = session
        sql = String::Builder.new
        args = [] of ::Db::Value::DBValue
        build_sql(select_list, sql, args)
        first = s.store.size
        count = {{name.id}}.read_into(s, sql.to_s, args, @scope)
        return count if count.is_a?(::Ricord::Failures::DatabaseError)
        if @bare && @owner >= 0
          start = s.store.links.size
          count.times { |k| s.store.links << first + k }
          ::Ricord::Associations.set_range(s.store, @owner, @owner_assoc, start, count)
        end
        count
      end

      def all : Array({{name.id}}) | ::Ricord::Failures::DatabaseError
        to_a
      end

      # The store index of the first row (the last with *flip*), -1 for none.
      def first_index(flip : Bool = false) : Int32 | ::Ricord::Failures::DatabaseError
        query = @last_order < 0 ? order(:id) : self
        query = query.limit(1)
        sql = String::Builder.new
        args = [] of ::Db::Value::DBValue
        query.build_sql(select_list, sql, args, flip)
        s = session
        s.query(sql.to_s, args) do |rs|
          m = ::Ricord::Model.advance(rs, TABLE)
          if m.is_a?(::Ricord::Failures::DatabaseError)
            m
          elsif m
            index = s.store.add_record(MODEL_ID, COLUMNS.size, ASSOCIATION_COUNT)
            read = {{name.id}}.read_row(s.store, index, rs, s.dialect)
            s.store.scopes[index] = @scope
            read.is_a?(::Ricord::Failures::DatabaseError) ? read : index
          else
            -1
          end
        end
      end

      def first : {{name.id}} | Nil | ::Ricord::Failures::DatabaseError
        index = first_index
        return index if index.is_a?(::Ricord::Failures::DatabaseError)
        index < 0 ? nil : {{name.id}}.new(session, session.store, index)
      end

      # The last row in the query's order (by id when unordered). With a limit
      # or offset it reads the rows and takes the last one.
      def last : {{name.id}} | Nil | ::Ricord::Failures::DatabaseError
        if @limit_value.nil? && @offset_value.nil?
          index = first_index(true)
          return index if index.is_a?(::Ricord::Failures::DatabaseError)
          return index < 0 ? nil : {{name.id}}.new(session, session.store, index)
        end
        rows = (@last_order < 0 ? order(:id) : self).to_a
        return rows if rows.is_a?(::Ricord::Failures::DatabaseError)
        rows.empty? ? nil : {{name.id}}.new(session, session.store, rows[rows.size - 1].index)
      end

      def find_by(**conds) : {{name.id}} | Nil | ::Ricord::Failures::DatabaseError
        where(**conds).first
      end

      def find(id : Int64 | Int32) : {{name.id}} | ::Ricord::Failures::RecordNotFound | ::Ricord::Failures::DatabaseError
        index = where(id: id.to_i64).first_index
        return index if index.is_a?(::Ricord::Failures::DatabaseError)
        return ::Ricord::Failures::RecordNotFound.new(TABLE, id.to_i64) if index < 0
        {{name.id}}.new(session, session.store, index)
      end

      def count : Int64 | ::Ricord::Failures::DatabaseError
        sql = String::Builder.new
        args = [] of ::Db::Value::DBValue
        if @limit_value.nil? && @offset_value.nil? && !@distinct_rows
          build_sql("count(*)", sql, args)
        else
          # A limit, offset or DISTINCT bounds the rows counted, so count a subquery.
          inner = String::Builder.new
          build_sql(@distinct_rows ? select_list : "1", inner, args)
          sql << "SELECT count(*) FROM (" << inner.to_s << ')'
        end
        session.scalar(sql.to_s, Int64, args)
      end

      # Whether a row matches: `SELECT 1 ... LIMIT 1` (an offset applies), so it
      # also works where `count` would return no row.
      def exists? : Bool | ::Ricord::Failures::DatabaseError
        sql = String::Builder.new
        args = [] of ::Db::Value::DBValue
        limit(1).build_sql("1", sql, args)
        session.query(sql.to_s, args) do |rs|
          m = ::Ricord::Model.advance(rs, TABLE)
          m.is_a?(::Ricord::Failures::DatabaseError) ? m : m
        end
      end

      def any? : Bool | ::Ricord::Failures::DatabaseError
        exists?
      end

      def empty? : Bool | ::Ricord::Failures::DatabaseError
        found = exists?
        found.is_a?(::Ricord::Failures::DatabaseError) ? found : !found
      end

      # The number of rows, as `count`.
      def size : Int64 | ::Ricord::Failures::DatabaseError
        count
      end

      # The values of the named columns: one column gives an Array of values,
      # several an Array of tuples. Values are `Ricord::Model::Plucked`; text
      # is a view of the session's store. `into:` takes a typed array.
      def pluck(*cols : *T) forall T
        # (A local made inside a macro branch is not seen outside it.)
        \{% if T.size == 1 %}
          rows = [] of ::Ricord::Model::Plucked
          got = pluck(*cols, into: rows)
          return got if got.is_a?(::Ricord::Failures::DatabaseError)
          rows
        \{% else %}
          rows = [] of Tuple(\{% for i in 0...T.size %}::Ricord::Model::Plucked, \{% end %})
          got = pluck(*cols, into: rows)
          return got if got.is_a?(::Ricord::Failures::DatabaseError)
          rows
        \{% end %}
      end

      # Appends a value (one column) or a tuple (several) per row to *into*,
      # each value cast to *into*'s element type (a wrong type panics): the
      # number of rows appended.
      def pluck(*cols : *T, into : Array(R)) : Int64 | ::Ricord::Failures::DatabaseError forall T, R
        s = session
        idx = [] of Int32
        cols.each do |c|
          i = {{name.id}}.column_index(c)
          return ::Ricord::Failures::DatabaseError.new(TABLE, "pluck", "unknown column #{c}") if i < 0
          idx << i
        end
        p = prefix
        sql = String::Builder.new
        args = [] of ::Db::Value::DBValue
        build_sql(idx.map { |i| "#{p}`#{COLUMNS[i]}`" }.join(", "), sql, args)
        s.query(sql.to_s, args) do |rs|
          n = 0_i64
          problem = nil
          while true
            m = ::Ricord::Model.advance(rs, TABLE)
            if m.is_a?(::Ricord::Failures::DatabaseError)
              problem = m
              break
            end
            break unless m
            \{% if T.size == 1 %}
              into << {{name.id}}.__pluck_value(s, rs, idx[0]).as(R)
            \{% else %}
              \{% for i in 0...T.size %}
                v\{{i}} = {{name.id}}.__pluck_value(s, rs, idx[\{{i}}])
              \{% end %}
              into << { \{% for i in 0...T.size %}v\{{i}}.as(\{{R.type_vars[i]}}), \{% end %} }
            \{% end %}
            n += 1
          end
          problem.nil? ? n : problem
        end
      end

      # The first row as `pluck` would give it, or nil.
      def pick(*cols : *T) forall T
        limit(1).__pick(*cols)
      end

      # `pick` on a query already limited to one row. The row is read into a
      # record of the store first and the values returned as its views: a
      # def can return neither an element of an array it made nor text made
      # in a block.
      def __pick(*cols : *T) forall T
        s = session
        idx = [] of Int32
        cols.each { |c| idx << {{name.id}}.column_index(c) }
        p = prefix
        sql = String::Builder.new
        args = [] of ::Db::Value::DBValue
        build_sql(idx.map { |i| i < 0 ? "NULL" : "#{p}`#{COLUMNS[i]}`" }.join(", "), sql, args)
        holder = s.store.add_record(MODEL_ID, idx.size, 0)
        found = s.query(sql.to_s, args) do |rs|
          m = ::Ricord::Model.advance(rs, TABLE)
          if m.is_a?(::Ricord::Failures::DatabaseError)
            m
          elsif m
            idx.size.times { |k| {{name.id}}.__pluck_slot(s, rs, idx[k], holder, k) }
            true
          else
            false
          end
        end
        return found if found.is_a?(::Ricord::Failures::DatabaseError)
        return nil unless found
        \{% if T.size == 1 %}
          ::Ricord::Model.plucked(s.store, holder, 0)
        \{% else %}
          { \{% for i in 0...T.size %}::Ricord::Model.plucked(s.store, holder, \{{i}}), \{% end %} }
        \{% end %}
      end

      # The rows as a JSON array of objects, column name => value, appended
      # to *into*. A JSON column is embedded as JSON, a BLOB as hex text.
      def to_json(into : String::Builder) : Nil | ::Ricord::Failures::DatabaseError
        s = session
        sql = String::Builder.new
        args = [] of ::Db::Value::DBValue
        build_sql(select_list, sql, args)
        done = s.query(sql.to_s, args) do |rs|
          into << '['
          first = true
          problem = nil
          while true
            m = ::Ricord::Model.advance(rs, TABLE)
            if m.is_a?(::Ricord::Failures::DatabaseError)
              problem = m
              break
            end
            break unless m
            into << ',' unless first
            first = false
            {{name.id}}.__json_row(rs, into)
          end
          into << ']'
          problem
        end
        done.is_a?(::Ricord::Failures::DatabaseError) ? done : nil
      end

      {% if full %}
        # Every row, *batch_size* at a time: keyset batches on the order
        # columns plus id, each batch read into its own store (records,
        # load group and preloads), freed when the next batch starts. `limit`
        # caps the total. A yielded record cannot be kept past the block.
        # An order column that allows NULL is refused (use `pluck` or `to_a`).
        def each(batch_size : Int32 = 1000, & : {{name.id}} -> Nil) : Nil | ::Ricord::Failures::DatabaseError
          walked = __walk(batch_size) do |record|
            yield record
            nil
          end
          walked.is_a?(::Ricord::Failures::DatabaseError) ? walked : nil
        end

        # `each` whose block may stop the walk by returning a failure, which
        # is returned.
        def __walk(batch_size : Int32, & : {{name.id}} -> Nil | ::Ricord::Failures::Error) : Nil | ::Ricord::Failures::Error
          s = session
          ocols = [] of Int32
          odesc = [] of Bool
          at = @last_order
          while at >= 0
            ocols.unshift(s.store.orders[at].column)
            odesc.unshift(s.store.orders[at].desc)
            at = s.store.orders[at].prev
          end
          ocols.each do |c|
            return ::Ricord::Failures::DatabaseError.new(TABLE, "each", "order column #{COLUMNS[c]} allows NULL; use pluck or to_a") if NULLABLE[c]
          end
          unless ocols.includes?(0)
            ocols << 0
            odesc << false
          end
          p = prefix
          kstore = ::Ricord::Storage::Store.new
          keys = [] of ::Ricord::Values::Value
          have_keys = false
          total = 0_i64
          size = batch_size < 1 ? 1 : batch_size
          while true
            want = size.to_i64
            cap = @limit_value
            if cap
              left = cap - total
              break if left <= 0
              want = left if left < want
            end
            extra = String::Builder.new
            extra_binds = [] of ::Db::Value::DBValue
            ::Ricord::Model.keyset_sql(p, COLUMNS, ocols, odesc, keys, kstore, extra, extra_binds, s.dialect) if have_keys
            sql = String::Builder.new
            args = [] of ::Db::Value::DBValue
            sql << "SELECT " << (@distinct_rows ? "DISTINCT " : "") << select_list << " FROM `" << TABLE << '`'
            ::Ricord::Model.join_sql(s.store, @last_join, sql, args, s.dialect)
            ::Ricord::Model.scoped_where_sql(s.store, @last_where, @scope, COLUMNS, sql, args, s.dialect, p, extra.to_s, extra_binds)
            sql << " ORDER BY "
            ocols.size.times do |i|
              sql << ", " if i > 0
              sql << p << '`' << COLUMNS[ocols[i]] << '`'
              sql << " DESC" if odesc[i]
            end
            s.dialect.limit_offset(want, nil, sql)
            batch = ::Ricord::Storage::Store.new
            child = ::Ricord::Sessions::Session.new(s.conn, batch, s.dialect, s.state, s.log)
            bscope = ::Ricord::Model.copy_scope(s.store, batch, @scope)
            count = {{name.id}}.read_into(child, sql.to_s, args, bscope)
            return count if count.is_a?(::Ricord::Failures::DatabaseError)
            if count > 0 && @includes != 0_i64
              loaded = {{name.id}}.__preload_all(child, 0, count, @includes)
              return loaded if loaded.is_a?(::Ricord::Failures::DatabaseError)
            end
            stop = nil
            count.times do |k|
              if stop.nil?
                r = yield {{name.id}}.new(child, batch, k)
                stop = r if r.is_a?(::Ricord::Failures::Failure)
              end
            end
            return stop unless stop.nil?
            total += count
            break if count < want
            ::Ricord::Model.copy_keys(batch, count - 1, ocols, keys, kstore)
            have_keys = true
          end
          nil
        end

        # A new unsaved record. Through a has_many query the foreign key is set
        # to the owner's id, and the owner's loaded range is dropped so the next
        # read sees the record. Named `build`, not `new`: ris treats an instance
        # method `new` as in-place construction, which may not grow the store.
        # Through a scoped query the scope columns are set and the record keeps
        # the scope.
        def build(**attrs) : {{name.id}}
          index = {{name.id}}.new(session, **attrs).index
          if @owner >= 0
            session.store.set_slot(index, @owner_fk, session.store.slot(@owner, 0))
            ::Ricord::Associations.unload(session.store, @owner, @owner_assoc)
          end
          ::Ricord::Model.apply_scope(session.store, index, @scope)
          session.store.scopes[index] = @scope
          {{name.id}}.new(session, session.store, index)
        end

        def create(**attrs) : {{name.id}} | ::Ricord::Failures::Error
          build(**attrs).save
        end

        # `WHERE` for a bulk write: the conditions and scope, or, with joins or
        # a limit, `` `id` IN (SELECT ...) ``.
        private def bulk_where(sql : String::Builder, args : Array(::Db::Value::DBValue)) : Nil
          if @last_join >= 0 || !@limit_value.nil?
            inner = String::Builder.new
            build_sql("`#{TABLE}`.`id`", inner, args)
            sql << " WHERE `id` IN (" << inner.to_s << ')'
          else
            ::Ricord::Model.scoped_where_sql(session.store, @last_where, @scope, COLUMNS, sql, args, session.dialect)
          end
          nil
        end

        # Runs a bulk statement in its own write unless inside one; a has_many
        # owner's loaded range is dropped.
        private def bulk_run(text : String, args : Array(::Db::Value::DBValue), operation : String) : Int64 | ::Ricord::Failures::DatabaseError
          s = session
          ::Ricord::Associations.unload(s.store, @owner, @owner_assoc) if @owner >= 0
          return s.run(text, args) if s.state.depth > 0
          written = s.write { |tx| tx.exec(text, args) }
          # Its own write queues no after-commit item, so only the statement fails.
          return written if written.is_a?(Int64) || written.is_a?(::Ricord::Failures::DatabaseError)
          ::Ricord::Failures::DatabaseError.new(TABLE, operation, written.message)
        end

        # One `UPDATE` of the given columns over the matching rows (the scope
        # included), no callbacks: the rows changed. Its own write unless inside one.
        def update_all(**cols) : Int64 | ::Ricord::Failures::DatabaseError
          s = session
          sets = ""
          args = [] of ::Db::Value::DBValue
          cols.each do |key, value|
            col = {{name.id}}.column_index(key)
            sets << ", " unless sets.empty?
            sets << '`' << COLUMNS[col] << (BLOB_COLUMNS[col] ? "` = unhex(?)" : "` = ?")
            ::Ricord::Model.push_db(args, ::Ricord::Model.bind_value(s.store, value), s.store, s.dialect)
          end
          return 0_i64 if sets.empty?
          sql = String::Builder.new
          sql << "UPDATE `" << TABLE << "` SET " << sets
          bulk_where(sql, args)
          bulk_run(sql.to_s, args, "update_all")
        end

        # One `DELETE` of the matching rows (the scope included), no callbacks:
        # the rows deleted. Its own write unless inside one.
        def delete_all : Int64 | ::Ricord::Failures::DatabaseError
          sql = String::Builder.new
          args = [] of ::Db::Value::DBValue
          sql << "DELETE FROM `" << TABLE << '`'
          bulk_where(sql, args)
          bulk_run(sql.to_s, args, "delete_all")
        end

        # Loads the matching rows in batches and destroys each with its
        # callbacks and `dependent:` work, all in one write: the rows
        # destroyed, or the first failure (the write then rolls back).
        def destroy_all(batch_size : Int32 = 1000) : Int64 | ::Ricord::Failures::Error
          q = self
          s = session
          ::Ricord::Associations.unload(s.store, @owner, @owner_assoc) if @owner >= 0
          s.write do |tx|
            n = 0_i64
            walked = q.__walk(batch_size) do |record|
              gone = record.destroy_in(::Ricord::Sessions::Tx.new(record.session, tx.depth))
              n += 1 if gone.nil?
              gone
            end
            walked.nil? ? n : walked
          end
        end
      {% end %}
    end
    {% end %}

    # Reads the rows of *sql* into consecutive records of *session*'s store as
    # one load group with *scope*: the row count.
    def self.read_into(session : ::Ricord::Sessions::Session, sql : String, args : Array(::Db::Value::DBValue), scope : Int32) : Int32 | ::Ricord::Failures::DatabaseError
      s = session
      first = s.store.size
      failed = s.query(sql, args) do |rs|
        problem = nil
        while true
          m = ::Ricord::Model.advance(rs, TABLE)
          if m.is_a?(::Ricord::Failures::DatabaseError)
            problem = m
            break
          end
          break unless m
          index = s.store.add_record(MODEL_ID, COLUMNS.size, ASSOCIATION_COUNT)
          read = {{name.id}}.read_row(s.store, index, rs, s.dialect)
          problem = read if read.is_a?(::Ricord::Failures::DatabaseError)
          s.store.scopes[index] = scope
        end
        problem
      end
      return failed if failed.is_a?(::Ricord::Failures::DatabaseError)
      count = s.store.size - first
      ::Ricord::Associations.mark_group(s.store, first, count)
      count
    end

    # Runs the preloads named by the *includes* bits for a group.
    def self.__preload_all(session : ::Ricord::Sessions::Session, first : Int32, count : Int32, includes : Int64) : Nil | ::Ricord::Failures::DatabaseError
      ASSOCIATION_COUNT.times do |a|
        if (includes & (1_i64 << a)) != 0_i64
          loaded = __preload(session, first, count, a)
          return loaded if loaded.is_a?(::Ricord::Failures::DatabaseError)
        end
      end
      nil
    end

    # Reads column *col* of the current row as a plucked value.
    def self.__pluck_value(session : ::Ricord::Sessions::Session, rs : ::Db::Core::ResultSet, col : Int32) : ::Ricord::Model::Plucked
      if col == 0
        return rs.read(Int64 | Nil).or_panic
      end
      {% for c, i in cols %}
        {% t = types[c.args[1].id.stringify] %}
        if col == {{i + 1}}
          {% if t == "String" || t == "::Ricord::Json::Json" || t == "::Ricord::Blob::Blob" %}
            v = rs.read(String | Nil).or_panic
            return v.nil? ? nil : session.store.view_text(v)
          {% elsif t == "::Std::Time::Time" %}
            v = rs.read(String | Nil).or_panic
            return nil if v.nil?
            tv = session.dialect.read_time(v, TABLE)
            return tv.is_a?(::Ricord::Failures::DatabaseError) ? nil : tv
          {% elsif t == "Bool" %}
            v = rs.read(Int64 | Nil).or_panic
            return v.nil? ? nil : v != 0_i64
          {% else %}
            return rs.read({{t.id}} | Nil).or_panic
          {% end %}
        end
      {% end %}
      nil
    end

    # Reads column *col* of the current row into slot *slot* of record
    # *index* (text into the store).
    def self.__pluck_slot(session : ::Ricord::Sessions::Session, rs : ::Db::Core::ResultSet, col : Int32, index : Int32, slot : Int32) : Nil
      v = __pluck_value(session, rs, col)
      session.store.load_slot(index, slot, v.is_a?(String) ? session.store.add_text(v) : v)
      nil
    end

    # Appends the current row (selected as COLUMNS) as a JSON object.
    def self.__json_row(rs : ::Db::Core::ResultSet, into : String::Builder) : Nil
      into << "{\"id\":" << rs.read(Int64).or_panic
      {% for c, i in cols %}
        {% t = types[c.args[1].id.stringify] %}
        into << ",\"{{c.args[0].id}}\":"
        {% if t == "String" || t == "::Std::Time::Time" %}
          v{{i}} = rs.read(String | Nil).or_panic
          if v{{i}}.nil?
            into << "null"
          else
            ::Ricord::Model.json_string(v{{i}}, into)
          end
        {% elsif t == "::Ricord::Json::Json" %}
          v{{i}} = rs.read(String | Nil).or_panic
          into << (v{{i}}.nil? || v{{i}}.empty? ? "null" : v{{i}})
        {% elsif t == "::Ricord::Blob::Blob" %}
          v{{i}} = rs.read(String | Nil).or_panic
          if v{{i}}.nil?
            into << "null"
          else
            into << '"'
            v{{i}}.each_byte { |b| into << "0123456789abcdef"[(b >> 4).to_i32, 1] << "0123456789abcdef"[(b & 0x0F_u8).to_i32, 1] }
            into << '"'
          end
        {% elsif t == "Bool" %}
          v{{i}} = rs.read(Int64 | Nil).or_panic
          into << (v{{i}}.nil? ? "null" : (v{{i}} != 0_i64 ? "true" : "false"))
        {% else %}
          v{{i}} = rs.read({{t.id}} | Nil).or_panic
          into << (v{{i}}.nil? ? "null" : v{{i}}.to_s)
        {% end %}
      {% end %}
      into << '}'
      nil
    end

    # `joins`: appends the INNER JOIN for association *names[k]* of this
    # model, with the scope pairs the joined table has (*map*: pair position
    # => this model's column index or -1), then the next hop's.
    def self.__join(names : Array(Symbol), k : Int32, store : ::Ricord::Storage::Store, map : Array(Int32), scope : Int32, text : String::Builder) : Nil
      return nil if k >= names.size
      {% for a, ai in assocs %}
        if names[k] == {{a[1].symbolize}}
          t = {{a[2]}}::TABLE
          {% if a[0] == "belongs_to" %}
            text << " INNER JOIN `" << t << "` ON `" << t << "`.`id` = `" << TABLE << "`.`{{a[3]}}`"
          {% else %}
            text << " INNER JOIN `" << t << "` ON `" << t << "`.`{{a[3]}}` = `" << TABLE << "`.`id`"
          {% end %}
          # Composed in place: *map* is the caller's, reused by every hop.
          map.size.times { |i| map[i] = map[i] < 0 ? -1 : SCOPE_MAP_{{a[1].id.upcase}}[map[i]] }
          map.size.times do |i|
            tc = map[i]
            next if tc < 0
            value = store.scope_vals[scope + i]
            if value.nil?
              text << " AND `" << t << "`.`" << {{a[2]}}::COLUMNS[tc] << "` IS NULL"
            else
              text << " AND `" << t << "`.`" << {{a[2]}}::COLUMNS[tc] << "` = ?"
              store.add_bind(value)
            end
          end
          return {{a[2]}}.__join(names, k + 1, store, map, scope, text)
        end
      {% end %}
      text << " INNER JOIN `unknown association " << names[k].to_s << "` ON 0"
      nil
    end

    def self.column_index(column : Symbol) : Int32
      case column
      when :id then 0
      {% for c, i in cols %}
      when {{c.args[0]}} then {{i + 1}}
      {% end %}
      else
        -1
      end
    end

    # The index of a column by name, -1 for none: maps a scope pair's column
    # from another model into this one.
    def self.column_named(column : String) : Int32
      case column
      when "id" then 0
      {% for c, i in cols %}
      when {{c.args[0].id.stringify}} then {{i + 1}}
      {% end %}
      else
        -1
      end
    end

    # The index of a named association, -1 for none.
    def self.association_index(assoc : Symbol) : Int32
      {% for a, ai in assocs %}
        return {{ai}} if assoc == {{a[1].symbolize}}
      {% end %}
      -1
    end

    # Loads association *assoc* for the group records first ... first + count - 1.
    def self.__preload(session : ::Ricord::Sessions::Session, first : Int32, count : Int32, assoc : Int32) : Nil | ::Ricord::Failures::DatabaseError
      {% for a, ai in assocs %}
        return __load_{{a[1]}}(session, first, count) if assoc == {{ai}}
      {% end %}
      nil
    end

    {% for a, ai in assocs %}
      {% kind = a[0] %}
      {% an = a[1] %}
      {% target = a[2] %}
      {% fk = a[3] %}
      # Scope column matching for {{an}}: each column of this model to the
      # same-named column of {{target}}, or -1 (has_many scope, `joins`).
      SCOPE_MAP_{{an.id.upcase}} = [{% for c in ["id"] + cols.map { |c| c.args[0].id.stringify } %}{{target}}.column_named({{c}}), {% end %}]
      {% if kind == "belongs_to" %}
        {% fci = a[4] %}
        {% fcol = cols[fci - 1] %}
        {% fnull = fcol.named_args && fcol.named_args.any? { |na| na.name.stringify == "null" && na.value } %}
        # belongs_to {{an}}: the {{target}} named by {{fk}}, loaded for the whole
        # load group on first access.
        def {{an}} : {{target}} | Nil | ::Ricord::Failures::DatabaseError
          unless ::Ricord::Associations.loaded?(store, index, {{ai}})
            first = ::Ricord::Associations.group_first(store, index)
            loaded = {{name.id}}.__load_{{an}}(session, first, ::Ricord::Associations.group_size(store, first))
            return loaded if loaded.is_a?(::Ricord::Failures::DatabaseError)
          end
          t = ::Ricord::Associations.one(store, index, {{ai}})
          t < 0 ? nil : {{target}}.new(session, store, t)
        end

        # Sets {{fk}} to the other record's id; the association then reads it.
        def {{an}}=(other : {{target}}{% if fnull %} | Nil{% end %}) : Nil
          {% if fnull %}
            if other.nil?
              self.{{fk}} = nil
              ::Ricord::Associations.set_one(store, index, {{ai}}, -1)
              return nil
            end
          {% end %}
          self.{{fk}} = other.id
          if other.store == store
            ::Ricord::Associations.set_one(store, index, {{ai}}, other.index)
          end
          nil
        end

        def self.__load_{{an}}(session : ::Ricord::Sessions::Session, first : Int32, count : Int32) : Nil | ::Ricord::Failures::DatabaseError
          store = session.store
          keys = [] of Int64
          ::Ricord::Associations.group_keys(store, first, count, {{ai}}, {{fci}}, keys)
          targets = [] of Int32
          i = 0
          while i < keys.size
            chunk = [] of Int64
            while i < keys.size && chunk.size < ::Ricord::Associations::CHUNK
              chunk << keys[i]
              i += 1
            end
            at = store.size
            rows = {{target}}[session].where(id: chunk).read_rows
            return rows if rows.is_a?(::Ricord::Failures::DatabaseError)
            rows.times { |k| targets << at + k }
          end
          ::Ricord::Associations.link_group(store, first, count, {{ai}}, {{fci}}, targets, 0)
          nil
        end
      {% elsif kind == "has_one" %}
        # has_one {{an}}: the {{target}} whose {{fk}} is this id, loaded for the
        # whole load group on first access.
        def {{an}} : {{target}} | Nil | ::Ricord::Failures::DatabaseError
          unless ::Ricord::Associations.loaded?(store, index, {{ai}})
            first = ::Ricord::Associations.group_first(store, index)
            loaded = {{name.id}}.__load_{{an}}(session, first, ::Ricord::Associations.group_size(store, first))
            return loaded if loaded.is_a?(::Ricord::Failures::DatabaseError)
          end
          t = ::Ricord::Associations.one(store, index, {{ai}})
          t < 0 ? nil : {{target}}.new(session, store, t)
        end

        def self.__load_{{an}}(session : ::Ricord::Sessions::Session, first : Int32, count : Int32) : Nil | ::Ricord::Failures::DatabaseError
          store = session.store
          keys = [] of Int64
          ::Ricord::Associations.group_keys(store, first, count, {{ai}}, 0, keys)
          targets = [] of Int32
          i = 0
          while i < keys.size
            chunk = [] of Int64
            while i < keys.size && chunk.size < ::Ricord::Associations::CHUNK
              chunk << keys[i]
              i += 1
            end
            at = store.size
            rows = {{target}}[session].where({{fk}}: chunk).order(:id).read_rows
            return rows if rows.is_a?(::Ricord::Failures::DatabaseError)
            rows.times { |k| targets << at + k }
          end
          ::Ricord::Associations.link_group(store, first, count, {{ai}}, 0, targets, {{target}}.column_index({{fk.symbolize}}))
          nil
        end
      {% else %}
        # has_many {{an}}: the {{target}} rows whose {{fk}} is this id, as a query.
        def {{an}} : {{target}}::Query
          fk = {{target}}.column_index({{fk.symbolize}})
          scope = ::Ricord::Model.child_scope(store, index, fk, SCOPE_MAP_{{an.id.upcase}})
          {{target}}::Query.new(session, -1, -1, nil, nil, 0_i64, index, {{ai}}, fk, true, scope)
        end

        # `includes(:{{an}})`: every owner's children in one query per 1,000
        # owners, ordered by {{fk}}, id so each owner's children are contiguous.
        def self.__load_{{an}}(session : ::Ricord::Sessions::Session, first : Int32, count : Int32) : Nil | ::Ricord::Failures::DatabaseError
          store = session.store
          keys = [] of Int64
          ::Ricord::Associations.group_keys(store, first, count, {{ai}}, 0, keys)
          children = [] of Int32
          i = 0
          while i < keys.size
            chunk = [] of Int64
            while i < keys.size && chunk.size < ::Ricord::Associations::CHUNK
              chunk << keys[i]
              i += 1
            end
            at = store.size
            rows = {{target}}[session].where({{fk}}: chunk).order({{fk.symbolize}}, :id).read_rows
            return rows if rows.is_a?(::Ricord::Failures::DatabaseError)
            rows.times { |k| children << at + k }
          end
          ::Ricord::Associations.link_children(store, first, count, {{ai}}, children, {{target}}.column_index({{fk.symbolize}}))
          nil
        end
      {% end %}
    {% end %}

    {% for d in defs %}
      {{d}}
    {% end %}
  end
  {% end %}
end
