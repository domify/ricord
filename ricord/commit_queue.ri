# The kinds and the chain limit of the after-commit queue (doc/DESIGN.md, M1
# item 6 and M2 item 2). `CommitItem` and the run loop live in
# ricord/sessions.ri: the item's dispatch proc takes a `Db`, and imports may
# not form a cycle.
module ricord/commit_queue

pub KIND_CREATE   = 0_u8
pub KIND_UPDATE   = 1_u8
pub KIND_DESTROY  = 2_u8
pub KIND_ROLLBACK = 3_u8

# Chain depths 0-7 run; an item queued at chain depth 8 is refused.
pub CHAIN_LIMIT = 8
